	column 'Net Trx'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: dde4286f-c8f3-4096-b80b-483a7e4a58c1
		summarizeBy: sum
		isNameInferred
		isDataTypeInferred
		sourceColumn: [Net Trx]

		annotation SummarizationSetBy = Automatic

	partition 'Net Transactions-a4947697-306b-42c7-b876-6976b0f9fe34' = calculated
		mode: import
		source =
				VAR ReturnsFlag =
				    IF ( [Returned Units] > 0, -1, BLANK () )
				VAR SalesFlag =
				    IF ( [Invoiced Units] > 0, 1, BLANK () )
				VAR NetTrx = ReturnsFlag + SalesFlag
				RETURN
				    SUMMARIZECOLUMNS (
				        'Orders'[Sales Order Number],
				        FILTER ( Orders, Orders[isCarrierBag] = FALSE ),
				        "Returns Flg", IF ( [Returned Units] > 0, -1, BLANK () ),
				        "Sales Flg", IF ( [Invoiced Units] > 0, 1, BLANK () ),
				        "Net Trx",
				            IF ( [Returned Units] > 0, -1, BLANK () )
				                + IF ( [Invoiced Units] > 0, 1, BLANK () )
				                + IF ( [Open Units] > 0, 1, BLANK () )
				    )

	annotation PBI_Id = 2c7ccc70d656467eafa72be2870f0280

