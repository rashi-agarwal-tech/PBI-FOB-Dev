	column 'Time Since Last Purchase Bucket' =
			
			IF(Orders[Days Since Last Purchase] = 0, "1st Purchase",
			    IF(AND(Orders[Days Since Last Purchase] > 0, Orders[Days Since Last Purchase] <= 91), "0-3 months",
			       IF(AND(Orders[Days Since Last Purchase] >= 92, Orders[Days Since Last Purchase] <= 182), "4-6 months",
			         IF(AND(Orders[Days Since Last Purchase] >= 183, Orders[Days Since Last Purchase] <= 365), "7-12 months",
			            IF(AND(Orders[Days Since Last Purchase] >= 366, Orders[Days Since Last Purchase] <= 730), "1-2 years",
			                IF(AND(Orders[Days Since Last Purchase] >= 731, Orders[Days Since Last Purchase] <= 1095), "2-3 years",
			                    IF(AND(Orders[Days Since Last Purchase] >= 1096, Orders[Days Since Last Purchase] <= 1825), "3-5 years", "5+ years")
			    ))))))
		dataType: string
		displayFolder: 2. eCom Details
		lineageTag: a3b9853c-2bd9-4860-8c15-0bfec57574fb
		summarizeBy: none
		isDataTypeInferred
		sortByColumn: 'Time Since Last Purchase Bucket Sort'

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

