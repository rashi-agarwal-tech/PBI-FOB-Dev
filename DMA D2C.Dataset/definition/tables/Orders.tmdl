			    AND (
			        ISBLANK ( Orders[RETURNEDSALESQUANTITY_ROL_ZEROS] ),
			        Orders[INVOICEDQUANTITY_SIL] > 0
			    ),
			    ROUND ( Orders[COSTAMOUNTPOSTED_SILCS], 2 ) * -1,
