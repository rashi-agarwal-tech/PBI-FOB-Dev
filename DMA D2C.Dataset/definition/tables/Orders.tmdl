	column 'Discounts (inc tax) Open Col' =
			VAR DiscountSubject = Orders[Open Units Col]
			VAR AvailDiscount = Orders[Discount]
			VAR TotalLineUnits = Orders[Ordered Units Col]
			RETURN
			    DIVIDE ( AvailDiscount, TotalLineUnits ) * DiscountSubject
		dataType: double
		isHidden
		displayFolder: zz_Values
		lineageTag: d81b1be7-f5ee-48ae-a034-2a2bd3ed2621
		summarizeBy: sum
		isDataTypeInferred

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column 'eCom Demand Cancelled Value Col' =
			VAR main =
			    IF (
			        Orders[Cancelled Units Col] > 0,
			         ( Orders[Unit Price] * Orders[Cancelled Units Col] ) - Orders[Discount],
			        BLANK ()
			    )
			RETURN
			    IF ( main > 0, main, BLANK () )
			--var main = (Orders[UnitPrice_CONS_GBP]*[Cancelled Units])-[Discount]
			--return
			--if(main>0,main,blank())
		dataType: double
		isHidden
		displayFolder: zz_Values
		lineageTag: 31b275d7-cd76-4564-9f1c-fe187cab9324
		summarizeBy: sum
		isDataTypeInferred

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column 'eCom Demand Open Value Col' =
			VAR main = ( Orders[Unit Price] * Orders[Open Units Col] ) - Orders[Open Discounts Col]
			RETURN
			    IF (
			        Orders[SALESORDERPOOLID_SOH] = "EO",
			        IF ( ISBLANK ( Orders[RMA Number] ), main, BLANK () ),
			        BLANK ()
			    )
		dataType: double
		isHidden
		displayFolder: zz_Values
		lineageTag: 467b8019-cf44-408d-8379-d9fa43565c37
		summarizeBy: sum
		isDataTypeInferred

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column 'eCom Demand Value Col' = ```
			VAR main = ( Orders[Unit Price] * Orders[Ordered Units Col] ) - Orders[Discount]
			RETURN
			    IF (
			        Orders[SALESORDERPOOLID_SOH] = "EO",
			        IF ( ISBLANK ( Orders[RMA Number] ), main, BLANK () ),
			        BLANK ()
			    )
			--if(main>0,main,blank()) 
			--var main = (Orders[UnitPrice_CONS_GBP]*[Ordered Units])-[Discount]
			```
		dataType: double
		isHidden
		displayFolder: zz_Values
		lineageTag: 76be5b44-68cd-46a9-af46-a337c09cc6ca
		summarizeBy: sum
		isDataTypeInferred

