	column OrdersEmailWebsiteCode_Key = CONCATENATE ( Orders[Email], CONCATENATE ( "-", Orders[Website Code] ) )
		dataType: string
		isHidden
		displayFolder: zz_Keys
		lineageTag: 9aa63f4f-95eb-4785-829d-b078b17f3dff
		summarizeBy: none
		isDataTypeInferred

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column OpeneComReturn_Key =
			VAR main =
			    IF (
			        AND ( 'Orders'[Web Order #] <> "", 'Orders'[ITEMNUMBER_SOL_ROL] <> "" ),
			        CONCATENATE (
			            CONCATENATE (
			                CONCATENATE ( 'Orders'[Web Order #], "_" ),
			                CONCATENATE ( 'Orders'[ITEMNUMBER_SOL_ROL], "000" )
			            ),
			            RELATED ( Size[Size] )
			        ),
			        BLANK ()
			    )
			VAR check =
			    LOOKUPVALUE (
			        'Open eCom Return Info'[OpeneComReturn_Key],
			        'Open eCom Return Info'[OpeneComReturn_Key], main
			    )
			RETURN
			    IF ( ISBLANK ( check ), BLANK (), main )
		dataType: string
		isHidden
		displayFolder: zz_Keys
		lineageTag: 8ebb8749-6127-40d1-9887-00296863fe0f
		summarizeBy: none
		isDataTypeInferred

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column DateMaster =
			IF (
			    ISBLANK ( 'Orders'[INVOICEDATE_SIL] ),
			    'Orders'[DELIVERYDATE_SOL],
			    'Orders'[INVOICEDATE_SIL]
			)
		dataType: dateTime
		isHidden
		formatString: Short Date
		displayFolder: zz_Misc
		lineageTag: 45df243d-c4f9-46c6-bf2e-6e6d92bb2f17
		summarizeBy: none
		isDataTypeInferred

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column 'DateMaster Order' =
			IF (
			    Orders[SALESORDERPOOLID_SOH] = "RO",
			    Orders[INVOICEDATE_SIL],
			    IF (
			        ISBLANK ( Orders[Order DateTime] ),
			        Orders[SALESORDERCREATEDDATETIME_SOH],
			        Orders[Order DateTime]
			    )
			)
		dataType: dateTime
		isHidden
		formatString: Short Date
		displayFolder: zz_Misc
		lineageTag: 8c6ca69a-df51-4953-a2f0-a1f1f60d8145
		summarizeBy: none
		isDataTypeInferred

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column 'Full Price or Markdown' =
			IF (
			    RELATED ( Region[Company ID] ) = "201",
			    IF (
			        Orders[Return Reason] <> "",
			        "Full Price",
			        IF (
			            Orders[Line Discount] < 0.0,
			            "Full Price",
			            IF (
			                Orders[Line Discount] >= 0.0
			                    && Orders[Line Discount] < 0.095,
			                "Full Price",
			                IF (
			                    Orders[Line Discount] >= 0.095
			                        && Orders[Line Discount] < 0.155,
			                    "Customer Acquisition",
			                    IF ( Orders[Line Discount] >= 0.155, "Promo Markdown", "Undefined" )
			                )
			            )
			        )
			    ),
			    IF (
			        OR ( Orders[Line Discount] >= .20, Orders[Selling Status] = 1001 ),
			        "Markdown",
			        "Full Price"
			    )
			)
		dataType: string
		isHidden
		displayFolder: zz_Misc
		lineageTag: 08859000-a626-4c22-826c-0676832aeb8c
		summarizeBy: none
		isDataTypeInferred

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column RefitExclusion = IF(NOT ISBLANK(RELATED('Refit Exclusion'[StoreDateKey])), "Refit", "No Refit")
		dataType: string
		isHidden
		displayFolder: zz_Misc
		lineageTag: a0332d76-8dc2-4125-a6b0-9462ce90bc05
		summarizeBy: none
		isDataTypeInferred

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column 'Time Since Last Purchase Bucket Sort' =
			
			IF(Orders[Days Since Last Purchase] = 0, "01",
			    IF(AND(Orders[Days Since Last Purchase] > 0, Orders[Days Since Last Purchase] <= 91), "02",
			       IF(AND(Orders[Days Since Last Purchase] >= 92, Orders[Days Since Last Purchase] <= 182), "03",
			         IF(AND(Orders[Days Since Last Purchase] >= 183, Orders[Days Since Last Purchase] <= 365), "04",
			            IF(AND(Orders[Days Since Last Purchase] >= 366, Orders[Days Since Last Purchase] <= 730), "05",
			                IF(AND(Orders[Days Since Last Purchase] >= 731, Orders[Days Since Last Purchase] <= 1095), "06",
			                    IF(AND(Orders[Days Since Last Purchase] >= 1096, Orders[Days Since Last Purchase] <= 1825), "07", "08")
			    ))))))
		dataType: string
		isHidden
		displayFolder: zz_Misc
		lineageTag: b18c3c32-1723-49db-8b58-02ad96ef7417
		summarizeBy: none
		isDataTypeInferred

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column 'Cancelled Units Col' =
			IF (
			    'Orders'[Transaction Status] = "Cancelled",
			    Orders[ORDEREDSALESQUANTITY_SOL_ZEROS],
			    BLANK ()
			)
		dataType: int64
		isHidden
		displayFolder: zz_Units
		lineageTag: 3b978dea-1b62-4d70-840a-8f9962df6914
		summarizeBy: sum

		changedProperty = IsHidden

		changedProperty = DataType

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column 'Invoiced Units Col' =
			IF (
			    AND (
			        Orders[Transaction Type] = "Sale",
			        Orders[Transaction Status] = "Invoiced"
			    ),
			    Orders[INVOICEDQUANTITY_SIL],
			    BLANK ()
			)
		dataType: int64
		isHidden
		displayFolder: zz_Units
		lineageTag: 320390b2-3337-42d3-83e4-4f6e8e1c6c6f
		summarizeBy: sum
		isDataTypeInferred

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column 'Net Units Col' = Orders[Open Units Col] + Orders[Invoiced Units Col] - Orders[Returned Units Col]
		dataType: int64
		isHidden
		formatString: #,##0
		displayFolder: zz_Units
		lineageTag: c01d3881-e0bb-4389-aa41-36fc90e9dbb9
		summarizeBy: none

		changedProperty = IsHidden

		changedProperty = DataType

		annotation SummarizationSetBy = User

		annotation PBI_FormatHint = {"isCustom":true}

	column 'Open eCom Return Quantity' =
			IF (
			    ISBLANK ( RELATED ( 'Open eCom Return Info'[Processed Date] ) ) = TRUE ()
			        && RELATED ( 'Open eCom Return Info'[Returned Status] ) <> "Expired",
			    RELATED ( 'Open eCom Return Info'[Quantity] ),
			    BLANK ()
			)
		dataType: int64
		isHidden
		displayFolder: zz_Units
		lineageTag: 5532b8db-6b13-4770-a6c5-63df3d5dbafc
		summarizeBy: none
		isDataTypeInferred

		changedProperty = IsHidden

		annotation SummarizationSetBy = User

	column 'Open Units Col' =
			IF (
			    AND ( Orders[Transaction Type] = "Sale", Orders[Transaction Status] = "Open" ),
			    Orders[REMAININVENTPHYSICAL_SOL],
			    BLANK ()
			)
		dataType: int64
		isHidden
		formatString: #,##0
		displayFolder: zz_Units
		lineageTag: 5acb1092-df69-4134-b537-29d18e9ac493
		summarizeBy: none

		changedProperty = IsHidden

		changedProperty = DataType

		annotation SummarizationSetBy = User

		annotation PBI_FormatHint = {"isCustom":true}

	column 'Open Units Pct' =
			IF (
			    AND ( Orders[Transaction Type] = "Sale", Orders[Transaction Status] = "Open" ),
			    DIVIDE (
			        Orders[REMAININVENTPHYSICAL_SOL],
			        Orders[ORDEREDSALESQUANTITY_SOL],
			        BLANK ()
			    ),
			    BLANK ()
			)
		dataType: double
		isHidden
		formatString: #,##0.00
		displayFolder: zz_Units
		lineageTag: 6e6527c6-5bfe-4296-b3b1-94f2b3ca0849
		summarizeBy: none
		isDataTypeInferred

		changedProperty = IsHidden

		annotation SummarizationSetBy = User

		annotation PBI_FormatHint = {"isCustom":true}

	column 'Ordered eCom Return Quantity' = RELATED ( 'Open eCom Return Info'[Quantity] )
		dataType: int64
		isHidden
		displayFolder: zz_Units
		lineageTag: a59cf077-d8b3-4509-bf55-0d22c764c522
		summarizeBy: none
		isDataTypeInferred

		changedProperty = IsHidden

		annotation SummarizationSetBy = User

	column 'Ordered Units Col' =
			IF (
			    Orders[Returned Units Col] > 0,
			    BLANK (),
			    Orders[ORDEREDSALESQUANTITY_SOL_ZEROS]
			)
		dataType: int64
		isHidden
		formatString: 0
		displayFolder: zz_Units
		lineageTag: 703d0fae-c764-4d44-86b6-41821239952b
		summarizeBy: sum

		changedProperty = IsHidden

		changedProperty = DataType

		annotation SummarizationSetBy = Automatic

	column 'Returned Units Col' =
			IF (
			    AND (
			        Orders[Transaction Type] = "Return",
			        Orders[Transaction Status] = "Invoiced"
			    ),
			    IF (
			        Orders[INVOICEDQUANTITY_SIL] <> 0,
			        ABS ( Orders[INVOICEDQUANTITY_SIL] ),
			        ABS ( Orders[RETURNEDSALESQUANTITY_ROL_ZEROS] )
			    ),
			    BLANK ()
			)
		dataType: double
		isHidden
		displayFolder: zz_Units
		lineageTag: cc588308-3cf5-443c-ac24-c74b35d5d982
		summarizeBy: sum
		isDataTypeInferred

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column 'Discount Bucket EMEA/Americas' =
			SWITCH (
			    TRUE (),
			    OR ( Orders[Line Discount] = 0, ISBLANK ( Orders[Line Discount] ) ), "0 %",
			    AND ( Orders[Line Discount] > 0, Orders[Line Discount] < .11 ), "0-10 %",
			    AND ( Orders[Line Discount] >= .11, Orders[Line Discount] < .21 ), "11-20 %",
			    AND ( Orders[Line Discount] >= .21, Orders[Line Discount] < .41 ), "21-40 %",
			    AND ( Orders[Line Discount] >= .41, Orders[Line Discount] < .61 ), "41-60 %",
			    AND ( Orders[Line Discount] >= .61, Orders[Line Discount] < .71 ), "61-70 %",
			    AND ( Orders[Line Discount] >= .71, Orders[Line Discount] <= 1 ), "71-100 %",
			    "No Discount Bucket"
			)
		dataType: string
		isHidden
		displayFolder: zz_Values
		lineageTag: 55b703dc-9607-4c00-b105-4e7a3b87b9ef
