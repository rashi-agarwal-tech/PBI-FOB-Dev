model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-GB
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup Parameters

	annotation PBI_QueryGroupOrder = 0

annotation PBI_ProTooling = ["DevMode"]

annotation PBIDesktopVersion = 2.128.952.0 (24.04)

annotation PBI_QueryOrder = ["Datasource_Server","Datasource_Warehouse","Datasource_Database","Datasource_Schema","NumberOfRows","Global Product Forecast","Bridge InventTransID","Display Currency","Customer","Product Class","Sales Order Pool","Sales Order Type","Size","Vendor","Warehouse","Allocation Details","Availability","Exchange Rates","Intake","Adjustments","Movements","Pick","Products - Last PO","Date","Products - Last PO SKU","Purchase Season","PO ETD Date","Date Slicer","Products","Selling Status - Invoice","Selling Status - Order Entry","Bridge PPM Supplier PO","Product Weights","Customer Sell Out US","From Warehouse","To Warehouse","Metrics"]

annotation __PBI_TimeIntelligenceEnabled = 1

ref table 'Global Product Forecast'
ref table 'Bridge InventTransID'
ref table 'Display Currency'
ref table Customer
ref table 'Product Class'
ref table 'Sales Order Pool'
ref table 'Sales Order Type'
