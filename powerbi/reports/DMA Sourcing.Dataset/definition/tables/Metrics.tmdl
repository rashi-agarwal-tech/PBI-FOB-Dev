			)
		formatString: " #,0.00"
		displayFolder: 2. Capacity
		lineageTag: dc88f94f-2b33-4281-98ed-7337ae931859

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'Max. Net Weight' = MAX ( 'Product Weights'[Net Weight] )
		formatString: " #,##0.000"
		displayFolder: 2. Capacity
		lineageTag: b7ddfc56-b921-4086-8a22-a15af6c09869

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'Max. Pack Weight' = MAX ( 'Product Weights'[Pack Weight] )
