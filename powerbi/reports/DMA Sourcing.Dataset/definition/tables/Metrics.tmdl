table Metrics
	lineageTag: 5a6a8f6f-9842-4214-9039-66667bd1dd17

	measure 'Total Capacity' =
			if(not(ISFILTERED(Size[Size])),
			SUM('Construction Capacity'[Current Capacity]))
		formatString: " #,0"
		displayFolder: 2. Capacity
		lineageTag: 55ac0fcd-589e-4ae5-8b23-8e3cbf56f89c

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'Welted Capacity' =
			if(not(ISFILTERED(Size[Size])),
			CALCULATE([Total Capacity], 'Construction Capacity'[Construction Code] = "WT"))
		formatString: " #,0"
		displayFolder: 2. Capacity
		lineageTag: 5780cbf2-5766-4be1-9cdc-c351da3776af

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'Gross Weight' =
			IF (
			    NOT ( ISFILTERED ( Size[Size] ) ),
			    SUM ( 'PO Daybook'[Gross Weight Source] )
			)
		formatString: " #,0.00"
		displayFolder: 2. Capacity
		lineageTag: 152853d7-4f65-4c12-9ff4-33eb0b237610

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'Total Cube' =
