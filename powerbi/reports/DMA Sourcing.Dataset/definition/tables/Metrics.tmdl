	measure XR =
			IF (
			    OR (
			        HASONEFILTER ( 'Display Currency'[Currency Name] ),
			        HASONEFILTER ( 'Display Currency'[Currency Code] )
			    ),
			    SUM ( 'Display Currency'[XRMultiplier] ),
			    1
			)
		isHidden
		displayFolder: Internal
		lineageTag: ff1896ee-e2fa-449b-860b-88e2666a62c7

	measure '02. Approved Value' = SUM ( 'PO Details'[ValueApproved] ) * [XR]
