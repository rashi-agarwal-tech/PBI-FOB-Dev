	measure 'To Be Shipped (Current Month)' =
			IF (
			    ISBLANK (
			        CALCULATE (
			            [To Be Shipped],
			            FILTER (
			                'Shipped Date',
			                'Shipped Date'[Calendar Month Number] = MONTH ( NOW () )
			                    && 'Shipped Date'[Year] = YEAR ( NOW () )
			            )
			        )
			    ),
			    0,
			    CALCULATE (
			        [To Be Shipped],
			        FILTER (
			            'Shipped Date',
			            'Shipped Date'[Calendar Month Number] = MONTH ( NOW () )
			                && 'Shipped Date'[Year] = YEAR ( NOW () )
			        )
			    )
			)
		isHidden
		displayFolder: z. PBI
		lineageTag: 17e405e1-bfc2-4590-8335-13245c8f84ee

	measure 'To Be Shipped (Current Week)' =
			IF (
			    ISBLANK (
			        CALCULATE (
			            [To Be Shipped],
			            FILTER (
			                'Shipped Date',
			                'Shipped Date'[Calendar Week Number]
			                    = WEEKNUM ( NOW () ) - 1
			                    && 'Shipped Date'[Year] = YEAR ( NOW () )
			            )
			        )
			    ),
			    0,
			    CALCULATE (
			        [To Be Shipped],
			        FILTER (
			            'Shipped Date',
			            'Shipped Date'[Calendar Week Number]
			                = WEEKNUM ( NOW () ) - 1
			                && 'Shipped Date'[Year] = YEAR ( NOW () )
			        )
			    )
			)
		isHidden
		displayFolder: z. PBI
		lineageTag: f756b572-382c-495d-ab90-9f7c25f7c680

