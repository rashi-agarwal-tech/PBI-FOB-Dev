	measure 'Quantity To Be Shipped (Current Season)' =
			CALCULATE (
			    [To Be Shipped],
			    FILTER (
			        'Purchase Season',
			        'Purchase Season'[Season Year] = [Current Year Number]
			    )
			)
		isHidden
		displayFolder: z. PBI
		lineageTag: db5c81e8-5efb-4db4-b500-c9362602e673

	measure 'Current Week' = WEEKNUM ( NOW () ) - 1
		formatString: 0
		isHidden
		displayFolder: z. PBI
		lineageTag: 81616829-061f-4f66-b0ee-0358e9f66d1f

	measure 'Shipped (Current Week)' =
			IF (
			    ISBLANK (
			        CALCULATE (
			            [Quantity Shipped],
			            FILTER (
			                'Shipped Date',
			                'Shipped Date'[Calendar Week Number]
			                    = WEEKNUM ( NOW () ) - 1
			                    && 'Shipped Date'[Year] = YEAR ( NOW () )
			            )
			        )
			    ),
			    0,
			    CALCULATE (
			        [Quantity Shipped],
			        FILTER (
			            'Shipped Date',
			            'Shipped Date'[Calendar Week Number]
			                = WEEKNUM ( NOW () ) - 1
			                && 'Shipped Date'[Year] = YEAR ( NOW () )
			        )
			    )
			)
		isHidden
		displayFolder: z. PBI
		lineageTag: 3bbdc9e9-f960-4415-aeaa-bcab1a13a42d

	measure 'Shipped (Current Month)' =
			IF (
			    ISBLANK (
			        CALCULATE (
			            [Quantity Shipped],
			            FILTER (
			                'Shipped Date',
			                'Shipped Date'[Calendar Month Number] = MONTH ( NOW () )
			                    && 'Shipped Date'[Year] = YEAR ( NOW () )
			            )
			        )
			    ),
			    0,
			    CALCULATE (
			        [Quantity Shipped],
			        FILTER (
			            'Shipped Date',
			            'Shipped Date'[Calendar Month Number] = MONTH ( NOW () )
			                && 'Shipped Date'[Year] = YEAR ( NOW () )
			        )
			    )
			)
		isHidden
		displayFolder: z. PBI
		lineageTag: bf31142f-56af-4cc4-81fc-a1ef14914193

	measure 'Current Month Name' = FORMAT ( DATE ( YEAR ( NOW () ), MONTH ( NOW () ), 1 ), "MMM" )
		isHidden
		displayFolder: z. PBI
