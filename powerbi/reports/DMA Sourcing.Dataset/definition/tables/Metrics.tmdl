		lineageTag: 7cfde2ba-c1a5-479f-a6bf-6f9c442d82a4

		annotation PBI_FormatHint = {"isCustom":true}

	measure '03. Confirmed Units' =
			CALCULATE (
			    [01. Ordered Units],
