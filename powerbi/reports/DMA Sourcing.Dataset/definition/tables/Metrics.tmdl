	measure '# OT Ackno (%)' =
			if(isblank([# OT Ackno (units)]),
			0,
			DIVIDE ( [# OT Ackno (units)], CALCULATE (
			    [01. Ordered Units],
			    'PO Daybook'[_OT Ackno Grouping] <> "(6) - To be acknowledged"
			), 0 )
