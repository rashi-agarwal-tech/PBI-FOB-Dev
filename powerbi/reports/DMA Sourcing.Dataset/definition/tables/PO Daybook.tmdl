	column 'Days Late' =
			VAR StartDate =
			    IF (
			        ISBLANK ( 'PO Daybook'[Available Ship Date] ),
			        'PO Daybook'[Latest Ex-Factory Date],
			        'PO Daybook'[Available Ship Date]
			    )
			VAR EndDate =
			    IF (
			        'PO Daybook'[Confirmed_Ex_Factory_Key] = 0,
			        'PO Daybook'[Latest Ex-Factory Date],
			        RELATED ( 'Confirmed Ex-Factory Date'[ Confirmed Ex-Factory Date] )
			    )
			RETURN
			    IF (
			        StartDate > EndDate,
			        DATEDIFF ( EndDate, Startdate, DAY ),
			        0 - DATEDIFF ( StartDate, EndDate, DAY )
			    )
		dataType: int64
		isHidden
		formatString: 0
		displayFolder: ToBeRemovedGFF
		lineageTag: 70a1be49-b1b3-4ffa-941f-ec9e0d31d6f0
		summarizeBy: sum
		isDataTypeInferred

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column 'Days Late Bin' =
			VAR temp = 'PO Daybook'[Days Late]
			RETURN
			    IF (
			        temp <= 0,
			        1,
			        IF (
			            AND ( temp > 0, temp <= 7 ),
			            2,
			            IF (
			                AND ( temp > 7, temp <= 14 ),
			                3,
			                IF (
			                    AND ( temp > 14, temp <= 21 ),
			                    4,
			                    IF ( AND ( temp > 21, temp <= 35 ), 5, 6 )
			                )
			            )
			        )
			    )
		dataType: int64
		isHidden
		formatString: 0
		displayFolder: ToBeRemovedGFF
		lineageTag: 9b8d5ec4-7984-4a79-bda4-84cdf016ac8b
		summarizeBy: sum
		isDataTypeInferred

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column 'Shipped Date Old' = ```
			IF (
			    ISBLANK ( 'PO Daybook'[Latest Ex-Factory Date] ),
			    RELATED ( 'Scheduled Ex-Factory Date'[ Scheduled Ex-Factory Date] ),
			    IF (
			        AND (
			            ISBLANK ( 'PO Daybook'[Available Ship Date] ),
			            ISBLANK ( 'PO Daybook'[ETD] )
			        ),
			        'PO Daybook'[Latest Ex-Factory Date],
			        IF (
			            OR (
			                ISBLANK ( 'PO Daybook'[Available Ship Date] ),
			                ISBLANK ( 'PO Daybook'[ETD] )
			            ),
			            'PO Daybook'[Available Ship Date],
			            IF (
			                AND (
			                    NOT ( ISBLANK ( 'PO Daybook'[ETD] ) ),
			                    NOT ( ISBLANK ( 'PO Daybook'[Available Ship Date] ) )
			                ),
			                'PO Daybook'[ETD]
			            )
			        )
			    )
			)
			//IF LatestExFactory is null then ScheduledExFactory
			//ELSE
			//IF AvailableShipDate and ETDDate is null then LatestExFactory
			//ELSE
			//IF AvailableShipDate or ETDDate is null then AvailableShipDate
			//ELSE 
			//IF ETDDate and AvailableShipDate are not null then ETDDate
			```
		dataType: dateTime
		formatString: Short Date
		lineageTag: f4e5ee51-3300-4b72-a3be-aa6aad4efa93
		summarizeBy: none
		isDataTypeInferred

		annotation SummarizationSetBy = Automatic

