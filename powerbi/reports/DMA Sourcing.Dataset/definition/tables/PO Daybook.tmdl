	column 'Is Late Shipment' =
			VAR X =
			    IF (
			        ISBLANK ( 'PO Daybook'[Available Ship Date] ),
			        'PO Daybook'[Latest Ex-Factory Date],
			        'PO Daybook'[Available Ship Date]
			    )
			VAR Y =
			    IF (
			        'PO Daybook'[Confirmed_Ex_Factory_Key] = 0,
			        'PO Daybook'[Latest Ex-Factory Date],
			        RELATED ( 'Confirmed Ex-Factory Date'[ Confirmed Ex-Factory Date] )
			    )
			RETURN
			    IF ( X > Y, "LATE", IF ( X <= Y, "EARLY/ON TIME", BLANK () ) )
		dataType: string
		lineageTag: 40438c33-62c9-413e-abb3-fce33e8e5ada
		summarizeBy: none
		isDataTypeInferred

		annotation SummarizationSetBy = Automatic

	column 'Is Dispatched' = IF('PO Daybook'[OrderStatus_Key] = "b23b9132e1fdacbbfee320f36e727ec1", TRUE(), FALSE())
		dataType: boolean
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 5c2a4597-db7b-4078-9918-0bebf6934611
		summarizeBy: none
		isDataTypeInferred

		annotation SummarizationSetBy = Automatic

	column 'Booking Status' =
			IF(NOT(AND(ISBLANK('PO Daybook'[14. Date Booking Made]),ISBLANK('PO Daybook'[15. Vendor Placed OMB Booking]))), "Y", "N"
			  )
		dataType: string
		lineageTag: 2f01d0f6-d1d7-43e9-8fd4-35c0919d5a79
		summarizeBy: none
		isDataTypeInferred

		annotation SummarizationSetBy = Automatic

	column 'DM Ownership' = ```
			CONCATENATE(CONCATENATE('PO Daybook'[Ownership],"-"),'PO Daybook'[Country (Ordering)]) 
			```
		dataType: string
		lineageTag: a9e6a916-a550-4a9e-ba00-2f3968c9c7a0
		summarizeBy: none
		isDataTypeInferred

		annotation SummarizationSetBy = Automatic

	column '_Is Prebuy?' =
			SWITCH (
			    LEFT ( RELATED ( 'Purchase Season'[Season] ), 2 ),
			    "SS", 0,
			    "AW",
			        IF (
			            'PO Daybook'[02. Date Loaded - Original] <> 'PO Daybook'[03. Date Loaded - Revised],
			            1,
			            0
			        )
			)
		dataType: int64
		formatString: 0
		lineageTag: 72e54ebb-a588-4134-84c7-d3fbb7e6c519
		summarizeBy: sum
		isDataTypeInferred

		annotation SummarizationSetBy = Automatic

	column '_Order Status Group' =
			SWITCH (
			    RELATED ( 'Order Status'[Order Status] ),
			    "Despatched", "Shipped",
			    "Date Passed", "To be Shipped",
			    "No Ship Date", "To be Shipped",
			    "Ready to Ship", "To be Shipped",
			    "Ship Within 2 weeks", "To be Shipped",
			    "Unknown", "To be Shipped",
			    "n/a"
			)
		dataType: string
		lineageTag: edc58a13-74ab-42b5-868a-955a6268567f
		summarizeBy: none
		isDataTypeInferred

		annotation SummarizationSetBy = Automatic

	column '_Is Backlog?' =
			IF (
			    'PO Daybook'[_Order Status Group] = "To be Shipped",
			    IF (
			        OR (
			            ISBLANK (
			                RELATED ( 'Confirmed Ex-Factory Date'[ Confirmed Ex-Factory Date] )
			            ),
			            YEAR (
			                RELATED ( 'Confirmed Ex-Factory Date'[ Confirmed Ex-Factory Date] )
			            ) = 1900
			        ),
			        0,
			        IF (
			            RELATED ( 'Confirmed Ex-Factory Date'[ Confirmed Ex-Factory Date] )
			                < TODAY (),
			            1,
			            0
			        )
			    )
			)
		dataType: int64
		lineageTag: 320ac2bf-80d0-4e3a-8bb6-8c4671fc6cde
		summarizeBy: none
		isDataTypeInferred

		annotation SummarizationSetBy = Automatic

	column '_Is Backlog(Available)?' =
			IF (
			    'PO Daybook'[_Order Status Group] = "To be Shipped",
			    IF (
			        OR (
			            ISBLANK (
			                RELATED ( 'Confirmed Ex-Factory Date'[ Confirmed Ex-Factory Date] )
			            ),
			            YEAR (
			                RELATED ( 'Confirmed Ex-Factory Date'[ Confirmed Ex-Factory Date] )
			            ) = 1900
			        ),
			        0,
			        IF (
			            RELATED ( 'Confirmed Ex-Factory Date'[ Confirmed Ex-Factory Date] )
			                < TODAY (),
			            IF (
			                ISBLANK ( [12. Available Ship Date] ),
			                1,
			                0
			            ),
			            0
			        )
			    )
			)
		dataType: int64
		formatString: 0
		lineageTag: 4fbc4d16-fbb9-4d1a-8de2-9de6e2b47246
		summarizeBy: sum
		isDataTypeInferred

		annotation SummarizationSetBy = Automatic

	column '_OT Ackno n.of days' = DATEDIFF ( [06. First Xmit Date], [08. Acknowledgement Date], DAY )
		dataType: int64
		formatString: 0
		lineageTag: 7a5607f3-a1d5-43b2-8a7f-7b832895c27b
		summarizeBy: sum
		isDataTypeInferred

		annotation SummarizationSetBy = Automatic

	column '_OT Ackno Grouping' =
			IF (
			    ISBLANK ( [08. Acknowledgement Date] ),
			    "(6) - To be acknowledged",
			    SWITCH (
			        TRUE (),
			        [_OT Ackno n.of days] < 16, "(1) - Early/On-Time",
			        [_OT Ackno n.of days] < 23, "(2) - 1 week late",
			        [_OT Ackno n.of days] < 30, "(3) - 2 weeks late",
			        [_OT Ackno n.of days] < 38, "(4) - 3 weeks late",
			        "(5) - +3 weeks late"
			    )
			)
		dataType: string
		lineageTag: 8e1cfd1e-d291-4747-8ceb-6621a865198f
		summarizeBy: none
		isDataTypeInferred

		annotation SummarizationSetBy = Automatic

	column '_OT Placement_1 n.of days' =
			DATEDIFF (
			    [04. Submitted Ex-Factory Date],
			    [05. Approved Ex-Factory Date],
			    DAY
			)
		dataType: int64
		formatString: 0
		lineageTag: 2e0dd493-e41e-4818-b126-aa0863eb5f40
		summarizeBy: sum
		isDataTypeInferred

		annotation SummarizationSetBy = Automatic

	column '_OT Placement_1 Grouping' =
			SWITCH (
			    TRUE (),
			    [_OT Placement_1 n.of days] < 6, "(1) - Early/On-Time",
			    [_OT Placement_1 n.of days] < 13, "(2) - 1 week late",
			    [_OT Placement_1 n.of days] < 20, "(3) - 2 weeks late",
			    [_OT Placement_1 n.of days] < 28, "(4) - 3 weeks late",
			    "(5) - +3 weeks late"
			)
		dataType: string
		lineageTag: 7f98e48a-f1a5-4044-857b-e4c37135333f
		summarizeBy: none
		isDataTypeInferred

		annotation SummarizationSetBy = Automatic

	column '_OT Confirmed n.of days' =
			DATEDIFF (
			    [05. Approved Ex-Factory Date],
			    RELATED ( 'Confirmed Ex-Factory Date'[ Confirmed Ex-Factory Date] ),
			    DAY
			
			)
		dataType: int64
		formatString: 0
		lineageTag: 9b2fdd41-f253-4f5f-ab4d-e1985668be3d
		summarizeBy: sum
		isDataTypeInferred

		annotation SummarizationSetBy = Automatic

	column '_OT Confirmed Grouping' =
			IF (
			    OR (
			        YEAR (
			            RELATED ( 'Confirmed Ex-Factory Date'[ Confirmed Ex-Factory Date] )
			        ) = 1900,
			        ISBLANK (
			            RELATED ( 'Confirmed Ex-Factory Date'[ Confirmed Ex-Factory Date] )
			        )
			    ),
			    "(6) - Pending to be Confirmed",
			    SWITCH (
			        TRUE (),
			        [_OT Confirmed n.of days] < 6, "(1) - Early/On-Time",
			        [_OT Confirmed n.of days] < 13, "(2) - 1 week late",
			        [_OT Confirmed n.of days] < 20, "(3) - 2 weeks late",
			        [_OT Confirmed n.of days] < 28, "(4) - 3 weeks late",
			        "(5) - +3 weeks late"
			    )
			)
		dataType: string
		lineageTag: 82c31fa4-0726-4a14-a704-76491f051e7d
		summarizeBy: none
		isDataTypeInferred

		annotation SummarizationSetBy = Automatic

	column '_OT Availability n.of days' =
			IF (
			    'PO Daybook'[_Is Prebuy?] = 0,
			    DATEDIFF (
			       [09. Contractual Ex-Factory Date],
			       [12. Available Ship Date],
			               DAY
			    ),
			    DATEDIFF (
			        [09. Contractual Ex-Factory Date] - 49,
			        [12. Available Ship Date],
			             DAY
			    )
			)
		dataType: int64
		formatString: 0
		lineageTag: 55e6e2bd-fb43-4166-955c-ca83f952e6c5
		summarizeBy: sum
		isDataTypeInferred

		annotation SummarizationSetBy = Automatic

	column '_OT Availability Grouping' =
			IF (
			    ISBLANK ( [12. Available Ship Date] ),
			    "(6) - Awaiting Available Ship Date",
			    IF (
			                  ISBLANK (
			               [09. Contractual Ex-Factory Date]
			            ),
			        "(7) - Pending to be Confirmed",
			        SWITCH (
			            TRUE (),
			            [_OT Availability n.of days] < 6, "(1) - Early/On-Time",
			            [_OT Availability n.of days] < 13, "(2) - 1 week late",
			            [_OT Availability n.of days] < 20, "(3) - 2 weeks late",
			            [_OT Availability n.of days] < 28, "(4) - 3 weeks late",
			            "(5) - +3 weeks late"
			        )
			    )
			)
		dataType: string
		lineageTag: f6b9e6ea-3925-4e35-a4c9-4e2630b8da6b
		summarizeBy: none
		isDataTypeInferred

		annotation SummarizationSetBy = Automatic

	column '_Expected Booking Date' = [12. Available Ship Date] - 14
		dataType: dateTime
		formatString: General Date
		lineageTag: 8a7d731a-c5be-48df-9371-8d03fe7565c3
		summarizeBy: none
		isDataTypeInferred

		annotation SummarizationSetBy = Automatic

	column '_Booked on time n.of days' =
			DATEDIFF (
			    'PO Daybook'[_Expected Booking Date],
			    [14. Date Booking Made],
			    DAY
			)
		dataType: int64
		formatString: 0
		lineageTag: c1415343-646a-428c-84b2-a9edddb8e927
		summarizeBy: sum
		isDataTypeInferred

		annotation SummarizationSetBy = Automatic

	column '_Booked on time Grouping' =
			IF (
			    ISBLANK ( [12. Available Ship Date] ),
			    "(6) - Awaiting Available Ship Date",
			    IF (
			        ISBLANK ( [14. Date Booking Made] ),
			        "(7) - Pending to be Booked",
			        SWITCH (
			            TRUE (),
			            [_Booked on time n.of days] < 6, "(1) - Early/On-Time",
			            [_Booked on time n.of days] < 13, "(2) - 1 week late",
			            [_Booked on time n.of days] < 20, "(3) - 2 weeks late",
			            [_Booked on time n.of days] < 28, "(4) - 3 weeks late",
			            "(5) - +3 weeks late"
			        )
			    )
			)
		dataType: string
		lineageTag: eeeafac0-e835-4396-bfd9-4797b9c9647a
		summarizeBy: none
		isDataTypeInferred

		annotation SummarizationSetBy = Automatic

	column '_OT Supplier n.of days' =
			IF (
			    'PO Daybook'[Ownership] = "O",
			    IF (
			        'PO Daybook'[_Is Prebuy?] = 0,
			        SWITCH (
			            'PO Daybook'[_Order Status Group],
			            "Shipped",
			                DATEDIFF (
			                    [09. Contractual Ex-Factory Date],
			                    [15a. Actual Ex-Factory Date],
			                    DAY
			                ),
			            "To be Shipped",
			                DATEDIFF (
			                   [09. Contractual Ex-Factory Date],
			                    [11. Latest Ex-Factory Date],
			                    DAY
			                )
			        ),
			        DATEDIFF (
			            'PO Daybook'[05. Approved Ex-Factory Date] - 49,
			            [12. Available Ship Date],
			            DAY
			        )
			    ),
			    IF (
			        'PO Daybook'[_Is Prebuy?] = 0,
			        DATEDIFF (
			         [09. Contractual Ex-Factory Date],
			          [12. Available Ship Date],
			            DAY
			        ),
			        DATEDIFF (
			          [09. Contractual Ex-Factory Date] - 49,
			            [12. Available Ship Date],
			            DAY
			        )
			    )
			)
		dataType: int64
		formatString: 0
		lineageTag: e83cc194-6962-4303-bff2-5116d852df83
		summarizeBy: sum
		isDataTypeInferred

		annotation SummarizationSetBy = Automatic

	column '_OT Supplier Grouping' =
			IF (
			            ISBLANK (
			            [09. Contractual Ex-Factory Date]
			        ),
			    "(6) - Pending to be Confirmed",
			    IF (
			        ISBLANK ( [_OT Supplier n.of days] ),
			        "(7) - Awaiting date",
			        SWITCH (
			            TRUE (),
			            [_OT Supplier n.of days] < 6, "(1) - Early/On-Time",
			            [_OT Supplier n.of days] < 13, "(2) - 1 week late",
			            [_OT Supplier n.of days] < 20, "(3) - 2 weeks late",
			            [_OT Supplier n.of days] < 28, "(4) - 3 weeks late",
			            "(5) - +3 weeks late"
			        )
			    )
			)
		dataType: string
		lineageTag: d31f32c1-c75a-4709-a6d4-a0e87790480d
		summarizeBy: none
		isDataTypeInferred

		annotation SummarizationSetBy = Automatic

	column '_Is Current Month?' =
			IF (
			    YEAR ( 'PO Daybook'[15a. Actual Ex-Factory Date] )
			        = YEAR (
			            TODAY ()
			        ),
			    IF (
			        MONTH ( 'PO Daybook'[15a. Actual Ex-Factory Date] )
			            = MONTH (
			                TODAY ()
			            ),
			        1,
			        0
			    ),
			    0
			)
		dataType: int64
		formatString: 0
		lineageTag: 7d36272b-6683-49ff-8bce-e27b2c8fff5c
		summarizeBy: sum
		isDataTypeInferred

		annotation SummarizationSetBy = Automatic

	column '_Is Current Week?' =
			IF (
			    YEAR ( 'PO Daybook'[15a. Actual Ex-Factory Date] )
			        = YEAR (
			            TODAY ()
			        ),
			    IF (
			        WEEKNUM (
			            'PO Daybook'[15a. Actual Ex-Factory Date],
			            2
			        )
			            = WEEKNUM (
			                TODAY (),
			                2
			            ),
			        1,
			        0
			    ),
			    0
			)
		dataType: int64
		formatString: 0
		lineageTag: 50d7eb98-ac5c-4ae5-b5f4-4e477e8d081e
		summarizeBy: sum
		isDataTypeInferred

		annotation SummarizationSetBy = Automatic

	column '_Is Past dues?' =
			IF (
			    'PO Daybook'[_Order Status Group] = "To be Shipped",
			    IF (
			        OR (
			            ISBLANK ( [11. Latest Ex-Factory Date] ),
			            YEAR ( [11. Latest Ex-Factory Date] ) = 1900
			        ),
			        0,
			        IF (
			            [11. Latest Ex-Factory Date]
			                < TODAY (),
			            1,
			            0
			        )
			    ),
			    0
			)
		dataType: int64
		formatString: 0
		lineageTag: 25d1ccce-550a-4a6a-a5f4-7eddc717200d
		summarizeBy: sum
		isDataTypeInferred

		annotation SummarizationSetBy = Automatic

	column '_Is Available?' =
			IF (
			    'PO Daybook'[_Order Status Group] = "To be Shipped",
			    IF (
			        ISBLANK ( [12. Available Ship Date] ),
			        0,
			        1
			    ),
			    0
			)
		dataType: int64
		formatString: 0
		lineageTag: 8747e61c-d6d6-4224-9d11-12e57132bcfe
		summarizeBy: sum
		isDataTypeInferred

		annotation SummarizationSetBy = Automatic

	column '_Is Delayed?' =
			IF (
			    'PO Daybook'[_Order Status Group] = "To be Shipped",
			    IF (
			        ISBLANK ( [12. Available Ship Date] ),
			        IF (
			            RELATED ( 'Confirmed Ex-Factory Date'[ Confirmed Ex-Factory Date] )
			                > TODAY (),
			            IF (
			                RELATED ( 'Confirmed Ex-Factory Date'[ Confirmed Ex-Factory Date] ) < [11. Latest Ex-Factory Date],
			                1,
			                0
			            ),
			            0
			        ),
			        0
			    ),
			    0
			)
		dataType: int64
		formatString: 0
		lineageTag: 99d20930-b363-4204-a965-ddce1d036472
		summarizeBy: sum
		isDataTypeInferred

		annotation SummarizationSetBy = Automatic

	column '_Is On Time?' =
			IF (
			    'PO Daybook'[_Order Status Group] = "To be Shipped",
			    IF (
			        'PO Daybook'[_Is Backlog?] + 'PO Daybook'[_Is Available?] + 'PO Daybook'[_Is Delayed?] = 0,
			        1,
			        0
			    ),
			    0
			)
		dataType: int64
		formatString: 0
		lineageTag: 9f0f7e29-487b-4f6c-8c09-6e2c478a5ce5
		summarizeBy: sum
		isDataTypeInferred

		annotation SummarizationSetBy = Automatic

	column '_Past dues Grouping' =
			VAR nDays =
			    DATEDIFF (
			        [11. Latest Ex-Factory Date],
			        TODAY (),
			        DAY
			    )
			RETURN
			    IF (
			        ISBLANK ( [11. Latest Ex-Factory Date] ),
			        "(6) - No Latest Ex-Factory Date",
			        SWITCH (
			            TRUE (),
			            nDays < 6, "(1) - Early/On-Time",
			            nDays < 13, "(2) - 1 week late",
			            nDays < 20, "(3) - 2 weeks late",
			            nDays < 28, "(4) - 3 weeks late",
			            "(5) - +3 weeks late"
			        )
			    )
		dataType: string
		lineageTag: b614e6d3-ec38-48bb-8ac9-e44ba8632926
		summarizeBy: none
		isDataTypeInferred

		annotation SummarizationSetBy = Automatic

	column '_Is Previous Week?' =
			IF (
			    YEAR ( 'PO Daybook'[15a. Actual Ex-Factory Date] )
			        = YEAR (
			            TODAY ()
			        ),
			    IF (
			        WEEKNUM (
			            'PO Daybook'[15a. Actual Ex-Factory Date],
			            2
			        )
			            = WEEKNUM (
			                TODAY (),
			                2
			            ) - 1,
			        1,
			        0
			    ),
			    0
			)
		dataType: int64
		formatString: 0
		lineageTag: b6be6f5f-ef3a-42bc-a053-4d7dbba341d6
		summarizeBy: sum
		isDataTypeInferred

