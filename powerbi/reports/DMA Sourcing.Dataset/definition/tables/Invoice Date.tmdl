	column 'Calendar Month Short Number' = ```
			SWITCH(MONTH('Invoice Date'[Invoice Date]), 
			1,"01",
			2,"02",
			3,"03",
			4,"04",
			5,"05",
			6,"06",
			7,"07",
			8,"08",
			9,"09",
			10,"10",
			11,"11",
			12,"12")
			```
		dataType: string
		lineageTag: 90a4ca5e-d659-4d12-85ef-2e45e6f233ce
		summarizeBy: none
		isDataTypeInferred

		annotation SummarizationSetBy = Automatic

	column 'Calendar Month Short Name' = ```
			SWITCH('Invoice Date'[Calendar Month Short Number], "01", "Jan", "02", "Feb", "03", "Mar", "04", "Apr"  
			              , "05", "May", "06", "Jun", "07", "Jul", "08", "Aug"  
			               , "09", "Sep", "10", "Oct", "11", "Nov", "12", "Dec") 
			```
		dataType: string
		lineageTag: a63249cc-a4e1-4264-89c4-7483c287c884
