expression 'DirectQuery to AS - DMA GL' =
		let
		    Source = AnalysisServices.Database("powerbi://api.powerbi.com/v1.0/myorg/Dr.%20Martens%20Datasets", "DMA GL"),
		    Cubes = Table.Combine(Source[Data]),
		    Cube = Cubes{[Id="Model", Kind="Cube"]}[Data]
		in
		    Cube
	lineageTag: 5e344d81-7c2c-44ad-872e-598b640f1534

	annotation PBI_IncludeFutureArtifacts = True

