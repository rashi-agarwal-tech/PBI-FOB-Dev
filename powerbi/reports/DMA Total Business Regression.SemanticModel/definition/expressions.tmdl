expression 'DirectQuery to AS - DMA Total Business' =
		let
		    Source = AnalysisServices.Database("powerbi://api.powerbi.com/v1.0/myorg/Dr.%20Martens%20Datasets", "DMA Total Business"),
		    Cubes = Table.Combine(Source[Data]),
		    Cube = Cubes{[Id="Model", Kind="Cube"]}[Data]
		in
		    Cube
	lineageTag: 28a9fbcb-dece-4acd-9259-5831a9f7ea9b

	annotation PBI_IncludeFutureArtifacts = True

