	measure 'sales Sum of AbsDiff' =
			
			[sales open units Diff]
			+[sales invoiced units Diff]
			+[sales returned units Diff]
			+[sales returned units Diff]
			+[sales net units Diff]
			+[sales ecom demand units Diff]
			+[sales ecom demand cancelled units Diff]
			+[sales total units ecom Diff]
			+[sales ecom demand transactions Diff]
			+[sales ecom demand discount Diff]
			+[sales open net value Diff]
			+[sales invoiced net value Diff]
			+[sales returned net value Diff]
			+[sales total net value Diff]
			+[sales net value Diff]
			+[sales ecom demand gross value Diff]
			+[sales ecom demand cancelled gross value Diff]
			+[sales total net value ecom Diff]
			+[sales footfall Diff]
		formatString: #,0.00
		lineageTag: 8b855803-9206-471f-96c9-2f3272fc252e

