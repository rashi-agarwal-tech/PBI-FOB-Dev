expression 'DirectQuery to AS - DMA B2B' =
		let
		    Source = AnalysisServices.Database("powerbi://api.powerbi.com/v1.0/myorg/Dr.%20Martens%20Datasets", "DMA B2B"),
		    Cubes = Table.Combine(Source[Data]),
		    Cube = Cubes{[Id="Model", Kind="Cube"]}[Data]
		in
		    Cube
	lineageTag: 5b0cf0b3-b829-4ad7-a78a-596655447098

	annotation PBI_IncludeFutureArtifacts = True

