		annotation SummarizationSetBy = Automatic

	column 'Alloc Units Arrived Col' =
			VAR alloc =
			    CALCULATE ( SUM ( SmartRes[QtyAllocated] ), SmartRes[StatusOLD] = "Green" )
			RETURN
			    IF (
			        AND (
			            AND ( Orders[Transaction Type] = "Sale", Orders[Transaction Status] = "Open" ),
			            alloc <> 0
			        ),
			        alloc,
			        BLANK ()
			    )
		dataType: int64
		isHidden
		displayFolder: zz_Units
		lineageTag: e812848f-6f30-4915-8791-83d798019cec
		summarizeBy: sum

		changedProperty = IsHidden

		changedProperty = DataType

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column 'Alloc Units Late Col' =
			
			VAR check = CALCULATE ( SUM ( SmartRes[QtyAllocated] ) )
			VAR alloc = CALCULATE ( SUM ( SmartRes[QtyAllocated] ), SmartRes[StatusOLD] = "Red" )
			VAR POUnits =
			    IF (
			        Orders[PO Confirmed Delivery Date] >= Orders[Requested Shipping Date],
			        Orders[Open PO Units],
			        BLANK ()
			    )
			VAR POCHECK = IF ( CHECK > 0, BLANK (), POUnits )
			VAR ALLOC1 = IF ( alloc > 0, alloc, POCHECK )
			RETURN
			    IF (
			        AND ( Orders[Transaction Type] = "Sale", Orders[Transaction Status] = "Open" ),
			        alloc1,
			        BLANK ()
			    )
		dataType: int64
		isHidden
		formatString: 0
		displayFolder: zz_Units
		lineageTag: 64bda7c3-4426-49d0-b9ec-0350ef8a0731
		summarizeBy: sum

		changedProperty = IsHidden

		changedProperty = DataType

		annotation SummarizationSetBy = Automatic

	column 'Alloc Units Ontime Col' =
			VAR check =
			    CALCULATE ( SUM ( SmartRes[QtyAllocated] ) )
			VAR alloc =
			    CALCULATE (
			        SUM ( SmartRes[QtyAllocated] ),
			        SmartRes[StatusOLD] IN { "Yellow" }
			    )
			VAR POUnits =
			    IF (
			        Orders[PO Confirmed Delivery Date] < Orders[Requested Shipping Date],
			        Orders[Open PO Units],
			        BLANK ()
			    )
			VAR POCHECK =
			    IF ( check > 0, BLANK (), POUnits )
			VAR ALLOC1 =
			    IF ( alloc > 0, alloc, POCHECK )
			RETURN
			    IF (
			        AND (
			            AND ( Orders[Transaction Type] = "Sale", Orders[Transaction Status] = "Open" ),
			            alloc1 > 0
			        ),
			        alloc1,
			        BLANK ()
			    )
		dataType: int64
		isHidden
		formatString: 0
		displayFolder: zz_Units
		lineageTag: a97744b1-f9a7-48bb-a37f-00c5dc9fcf3d
		summarizeBy: sum

