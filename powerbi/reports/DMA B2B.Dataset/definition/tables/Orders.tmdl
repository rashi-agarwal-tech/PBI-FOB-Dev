	column 'Order Duration' =
			VAR StartDateField = Orders[SALESLINECREATEDDATETIME_SOL]
			VAR EndDateField = Orders[Invoice Date]
			RETURN
			    IF (
			        ISBLANK ( Orders[Invoice Date] ),
			        BLANK (),
			        IF (
			            StartDateField > EndDateField,
			            0 - DATEDIFF ( EndDateField, StartDateField, DAY ),
			            DATEDIFF ( StartDateField, EndDateField, DAY )
			        )
			    )
		dataType: int64
		isHidden
		formatString: 0
		displayFolder: zz_Misc
		lineageTag: 1e440bfa-746e-4571-aba5-092aff11a921
		summarizeBy: sum
		isDataTypeInferred

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column 'Order Duration Bucket' =
			SWITCH (
			    TRUE (),
			    OR ( Orders[Order Duration] = 0, ISBLANK ( Orders[Order Duration] ) ), "0 Days",
			    AND ( Orders[Order Duration] > 0, Orders[Order Duration] < 10 ), "0-10 Days",
			    AND ( Orders[Order Duration] >= 10, Orders[Order Duration] < 28 ), "10-28 Days",
			    AND ( Orders[Order Duration] >= 29, Orders[Order Duration] < 59 ), "29-59 Days",
			    Orders[Order Duration] >= 60, "60+ Days",
			    "no bucket"
			)
		dataType: string
		lineageTag: d743d115-c48e-4410-887e-290bce365f97
		summarizeBy: none
		isDataTypeInferred

		annotation SummarizationSetBy = Automatic

