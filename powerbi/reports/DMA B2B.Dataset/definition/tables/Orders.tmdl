	column 'Open Order Payment Date' = ```
			var maxdate = max(today(), Orders[Start Ship Date])
			var CName = if(
			                RELATED(Customer[Invoice Acct Name])=BLANK(), 
			                RELATED(Customer[Customer Name]), 
			                RELATED(Customer[Invoice Acct Name])
			              )
			var CADP = MIN(
			            CALCULATE(
			                sum(Customer[Current Customer ADP]),
			                FILTER(Customer, Customer[Customer Name]= CName))
			            , 120)
			var CADP1 = if ((CADP=0 || CADP<0), 
			                (IFERROR(value(IFERROR(left(RELATED(Customer[Payment Terms]),
			                                        (search("D", RELATED(Customer[Payment Terms]),, 0)-2) ),0)),0)+5),
			                CADP
			                )
			return if (Orders[Source]="D365_Open", maxdate+CADP1, BLANK())
			```
		dataType: dateTime
		formatString: Short Date
		lineageTag: ad36b0c4-51ff-4421-8d43-ccb74caaf869
		summarizeBy: none
		isDataTypeInferred

		annotation SummarizationSetBy = Automatic

