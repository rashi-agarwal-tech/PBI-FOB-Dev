	column 'Discount Bucket' =
			SWITCH (
			    TRUE (),
			    OR (
			        Orders[Total Discount % Col] = 0,
			        ISBLANK ( Orders[Total Discount % Col] )
			    ), "0 %",
			    AND ( Orders[Total Discount % Col] > 0, Orders[Total Discount % Col] < .1 ), "0-9 %",
			    AND ( Orders[Total Discount % Col] >= .10, Orders[Total Discount % Col] < .2 ), "10-19 %",
			    AND ( Orders[Total Discount % Col] >= .20, Orders[Total Discount % Col] < .4 ), "20-39 %",
			    AND ( Orders[Total Discount % Col] >= .40, Orders[Total Discount % Col] < .6 ), "40-59 %",
			    AND ( Orders[Total Discount % Col] >= .60, Orders[Total Discount % Col] < 1 ), "60-99 %",
			    Orders[Total Discount % Col] = 1, "99-100 %",
			    "no bucket"
			)
		dataType: string
		lineageTag: 620d7390-8077-4dcd-aae3-f1dfb736506f
		summarizeBy: none
		isDataTypeInferred

		changedProperty = IsHidden

