	column 'Allocated Product Units Late' = 0
		dataType: int64
		isHidden
		formatString: 0
		displayFolder: 5. US\zz_Values
		lineageTag: b5b95c55-e610-4de5-b79c-34e0e50ecfcb
		summarizeBy: sum
		isDataTypeInferred

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column 'Available w/c' =
			var pickunits = Orders[Pick Act Units col]+Orders[Pick Comp Units col]
			var lfd = IF(Orders[Open Product Units]=Orders[Pick Complete Product Units],TODAY(),Orders[Fill Date - US Account])
			var lfdavail = lfd - (WEEKDAY(lfd,2)+1)
			var pickc = Orders[Pick Complete Product units]
			var picka = Orders[Pick Activated Product units]
			var res = Orders[Reserved Product units]
			var alloc = Orders[Allocated product units]
			var availyr = if(year(lfdavail)=year(today()),"Avail w/c ","Avail. w/c ")
			var availdate = availyr & lfdavail
			var fulfil = VALUE(RELATED(Customer[Order Fullfillment %]))
			var OpenQty = if(VALUE(RELATED(Customer[Order Fullfillment %]))<100,Orders[Open Product units]*0.7,Orders[Open Product units])
			var PicOpenQty = Orders[Open Product units]*0.7
			
			return
			
			if(Orders[Source]="D365_Open",
			if(pickc>PicOpenQty,"...Pick Completed",
			if((picka+pickc)>PicOpenQty,"..Pick Activated",
			if((picka+pickc+res)>OpenQty,".Reserved",
			if(lfd<5,"No Avail Date",availdate)))),"Invoiced")
		dataType: string
		displayFolder: 5. US
		lineageTag: 020ac9c3-ba39-456e-8053-0163911cd687
		summarizeBy: none
		isDataTypeInferred

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column 'Cancel Fill %' =
			var pickunits = Orders[Pick Act Units Col]+Orders[Pick Comp Units Col]
			var lfd = if(divide(Orders[Allocated Product Units]+Orders[Reserved Product Units]+pickunits,Orders[Open Product Units])=1,Orders[Fill Date - Order],today()+180)
			var cnx = Orders[Cancel Risk Date]
			var produnits = (Orders[Allocated Product Units]-Orders[Allocated Product Units Late])+Orders[Reserved Product Units]+Orders[Pick Activated Product Units]+Orders[Pick Complete Product Units]
			var fillpc = divide(produnits,Orders[Open Product Units])
			
			var fillbucket = IF(fillpc >= 0.0 && fillpc <0.50, "0-49%",
			                    IF(fillpc >= 0.50 && fillpc <0.60, "50-59%",
			                    IF(fillpc >= 0.60 && fillpc <0.70, "60-69%",
			                   IF(fillpc >= 0.70 && fillpc <0.80, "70-79%",
			                   IF(fillpc >= 0.80 && fillpc <0.90, "80-89%",
			                    IF(fillpc >= 0.90 && fillpc <1.00, "90-99%", "All Avail"))))))
			return
			if(Orders[Source]="D365_Open",if(lfd<cnx,"All Avail",fillbucket),"Complete")
		dataType: string
		displayFolder: 5. US
		lineageTag: ee1af84a-39a0-463f-b8ca-34de0d3b844c
		summarizeBy: none
		isDataTypeInferred

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column 'Cancel Risk Days Late' =
			var pickunits = Orders[Pick Activated Product Units]+Orders[Pick Complete Product Units]
			var lfd = Orders[Fill Date - US Account]
			var otf = Switch(Orders[Cancel Risk Order Status],">Cancel","Missing",">Cancel+4wks","Missing",blank())
			var cnx = Orders[Cancel Risk Date]
			var dayl = DATEDIFF(cnx,lfd,DAY)
			var dayslbucket = IF(dayl <= 7, "0-1 weeks",
			                    IF(dayl <= 14, "1-2 weeks",
			                    IF(dayl <= 21, "2-3 weeks",
			                    IF(dayl <= 28, "3-4 weeks","4+ weeks"))))
			
			RETURN
			if(Orders[Source]="D365_Open",
			if(otf=blank(),Orders[Cancel Risk Order Status],dayslbucket))
		dataType: string
		displayFolder: 5. US
		lineageTag: 08d13771-e0c7-4ba8-a4a6-712bf3e798b4
		summarizeBy: none
		isDataTypeInferred

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column 'Cancel Risk Line Status' = ```
			var pickunits = Orders[Pick Act Units Col]+Orders[Pick Comp Units Col]
			var lfd = Orders[Fill Date - Line]
			var cnx = value(Orders[Cancel Risk Date])
			var stshp = value(Orders[Start Ship Date])
			var outs1 = Orders[O/S Units Col]
			var addcnx = VALUE(Orders[Cancel Risk Date]+28)
			return
			 
			if(Orders[Source]="D365_Open",
			if(and(Orders[Fill Date - Order]=blank(),pickunits=Orders[Open Product Units]),"In-Pick",
			IF(cnx=blank(),"No Cancel",
			if(outs1=Orders[Open Product Units],"Outstanding",
			if(and(lfd>stshp,lfd<=cnx),"Late",
			if(and(lfd>cnx,lfd<=addcnx),">Cancel",
			if(lfd>addcnx,">Cancel+4wks","On-Time")))))),
			"Complete")
			```
		dataType: string
		displayFolder: 5. US
		lineageTag: 5c269412-067f-426d-8414-c5b62c6a9240
		summarizeBy: none
		isDataTypeInferred

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column 'Cancel Risk Line Status Sort' = ```
			var pickunits = Orders[Pick Act Units Col]+Orders[Pick Comp Units Col]
			var lfd = Orders[Fill Date - Line]
			var cnx = value(Orders[Cancel Risk Date])
			var stshp = value(Orders[Start Ship Date])
			var outs1 = Orders[O/S Units Col]
			var addcnx = VALUE(Orders[Cancel Risk Date]+28)
			return
			 
			if(Orders[Source]="D365_Open",
			if(and(Orders[Fill Date - Order]=blank(),pickunits=Orders[Open Product Units]),"01",
			IF(cnx=blank(),"07",
			if(outs1=Orders[Open Product Units],"06",
			if(and(lfd>stshp,lfd<=cnx),"03",
			if(and(lfd>cnx,lfd<=addcnx),"04",
			if(lfd>addcnx,"05","02")))))),
			"08")
			```
		dataType: string
		isHidden
		displayFolder: 5. US\zz_Misc
		lineageTag: ff2477b3-d5dc-4cd8-afde-f14fea8f45df
		summarizeBy: none
		isDataTypeInferred

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column 'Cancel Risk Order Status' =
			var pickunits = Orders[Pick Activated Product Units]+Orders[Pick Complete Product Units]
			var lfd = Orders[Fill Date - US Account]
			var cnx = value(Orders[Cancel Risk Date])
			var stshp = value(Orders[Start Ship Date])
			var outs1 = value(Orders[Allocated Product Units]+Orders[Reserved Product Units]+pickunits-Orders[Open Product Units])
			var addcnx = VALUE(Orders[Cancel Risk Date]+28)
			return
			
			if(Orders[Source]="D365_Open",
			if(and(Orders[Fill Date - Order]=blank(),pickunits=Orders[Open Product Units]),"In-Pick",
			IF(cnx=blank(),"No Cancel",
			if(outs1>(Orders[Open Product Units]*0.9),"Outstanding",
			if(and(lfd>stshp,lfd<=cnx),"Late",
			if(and(lfd>cnx,lfd<=addcnx),">Cancel",
			if(lfd>addcnx,">Cancel+4wks","On-Time"))))))
			,"Complete")
		dataType: string
		displayFolder: 5. US
		lineageTag: 577b6a9e-6445-41ee-ba01-f9fc3f557698
		summarizeBy: none
		isDataTypeInferred

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column 'Cancel Risk Order Status Sort' =
			var pickunits = Orders[Pick Activated Product Units]+Orders[Pick Complete Product Units]
			var lfd = Orders[Fill Date - US Account]
			var cnx = value(Orders[Cancel Risk Date])
			var stshp = value(Orders[Start Ship Date])
			var outs1 = value(Orders[Allocated Product Units]+Orders[Reserved Product Units]+pickunits-Orders[Open Product Units])
			var addcnx = VALUE(Orders[Cancel Risk Date]+28)
			return
			
			if(Orders[Source]="D365_Open",
			if(and(Orders[Fill Date - Order]=blank(),pickunits=Orders[Open Product Units]),"01",
			IF(cnx=blank(),"07",
			if(outs1>(Orders[Open Product Units]*0.9),"06",
			if(and(lfd>stshp,lfd<=cnx),"03",
			if(and(lfd>cnx,lfd<=addcnx),"04",
			if(lfd>addcnx,"05","02"))))))
			,"08")
		dataType: string
		isHidden
		displayFolder: 5. US\zz_Misc
