	column 'Req. vs Inv Days' =
			VAR StartDateField = Orders[Invoice Date]
			VAR EndDateField = Orders[Requested Shipping Date]
			RETURN
			    IF (
			        ISBLANK ( Orders[Invoice Date] ),
			        BLANK (),
			        IF (
			            StartDateField > EndDateField,
			            DATEDIFF ( EndDateField, StartDateField, DAY ),
			            0 - DATEDIFF ( StartDateField, EndDateField, DAY )
			        )
			    )
		dataType: int64
		formatString: 0
		lineageTag: b684e087-2db8-44b2-aeaf-bfde7490eb28
		summarizeBy: none
		isDataTypeInferred

		annotation SummarizationSetBy = User

		annotation PBI_FormatHint = {"isCustom":true}

	column 'Req. vs Inv Days Bucket' =
			SWITCH (
			    TRUE (),
			    ISBLANK ( Orders[Req. vs Inv Days] ), BLANK (),
			    Orders[Req. vs Inv Days] <= 0, " On Time / Early",
			    AND ( Orders[Req. vs Inv Days] > 0, Orders[Req. vs Inv Days] <= 7 ), "0-1 Weeks",
			    AND ( Orders[Req. vs Inv Days] > 7, Orders[Req. vs Inv Days] <= 14 ), "1-2 Weeks",
			    AND ( Orders[Req. vs Inv Days] > 14, Orders[Req. vs Inv Days] <= 21 ), "2-3 Weeks",
			    AND ( Orders[Req. vs Inv Days] > 21, Orders[Req. vs Inv Days] <= 28 ), "3-4 Weeks",
			    Orders[Req. vs Inv Days] > 28, "4+ Weeks",
			    "no bucket"
			)
		dataType: string
		lineageTag: 15a7f453-5d7d-45b4-a45f-50fb063fa3eb
		summarizeBy: none
		isDataTypeInferred

		annotation SummarizationSetBy = Automatic

	column 'Requested Order Duration Bucket' =
			SWITCH (
			    TRUE (),
			    OR (
			        Orders[Requested Order Duration Col] = 0,
			        ISBLANK ( Orders[Requested Order Duration Col] )
			    ), "0 Days",
			    AND (
			        Orders[Requested Order Duration Col] > 0,
			        Orders[Requested Order Duration Col] < 10
			    ), "0-10 Days",
			    AND (
			        Orders[Requested Order Duration Col] >= 10,
			        Orders[Requested Order Duration Col] < 28
			    ), "10-28 Days",
			    AND (
			        Orders[Requested Order Duration Col] >= 29,
			        Orders[Requested Order Duration Col] < 59
			    ), "29-59 Days",
			    Orders[Requested Order Duration Col] >= 60, "60+ Days",
			    "no bucket"
			)
		dataType: string
		lineageTag: d92278e3-0c6e-4afe-925f-9b33a18888f2
		summarizeBy: none
		isDataTypeInferred

		annotation SummarizationSetBy = Automatic

	column 'Requested Order Duration Col' =
			VAR StartDateField = Orders[Order Entry Date]
			VAR EndDateField = Orders[Requested Shipping Date]
			RETURN
			    IF (
			        StartDateField > EndDateField,
			        0 - DATEDIFF ( EndDateField, StartDateField, DAY ),
			        DATEDIFF ( StartDateField, EndDateField, DAY )
			    )
		dataType: int64
		isHidden
		formatString: 0
		displayFolder: zz_Misc
		lineageTag: 9b42ceec-20d9-4171-ac2c-69d1b02337c3
		summarizeBy: sum
		isDataTypeInferred

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column 'Res Units Col' =
