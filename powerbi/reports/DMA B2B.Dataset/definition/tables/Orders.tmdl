	column 'Fill Date - US Account' =
			-- use [Fill Date - Cust Req #] for US designated customer invoice accounts who will only take delivery of orders when the full customer requisition is available
			-- customer invoice accounts list in formula provided by Ben Harrison, they are fixed and not changing soon
			IF(Orders[Customer Invoice Acct No] IN {"201C000000938", "201C000000395", "201C000001314", "201C000003091"
			                                       ,"201C000007736", "201C000000998", "201C000004659", "201C000007703"
			                                       ,"201C000002784", "201C000005083", "201C000003493"},
			    Orders[Fill Date - Cust Req #], Orders[Fill Date - Order]
			    )
