			    IF (
			        AND ( Orders[Transaction Type] = "Return", Orders[Transaction Status] = "Open" ),
			        Orders[RETURNSALESQUANTITY_ROL_ZEROS],
			        BLANK ()
			    )
			VAR OrderedUnits =
			    IF (
			        ISBLANK ( Orders[ORDEREDSALESQUANTITY_SOL] ),
			        Orders[RETURNSALESQUANTITY_ROL],
			        Orders[ORDEREDSALESQUANTITY_SOL]
			    )
			RETURN
			    IF (
			        Orders[Transaction Type] = "Return",
			        ABS ( DIVIDE ( OpenReturnUnits, OrderedUnits, BLANK () ) ),
			        BLANK ()
			    )
