	column 'Alloc Units Outside Of Time Fence Col' =
			VAR alloc =
			    CALCULATE ( SUM ( SmartRes[QtyAllocated] ), SmartRes[StatusOLD] = "White" )
			RETURN
			    IF (
			        AND (
			            AND ( Orders[Transaction Type] = "Sale", Orders[Transaction Status] = "Open" ),
			            alloc <> 0
			        ),
			        alloc,
			        BLANK ()
			    )
