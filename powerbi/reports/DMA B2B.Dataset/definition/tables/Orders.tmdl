	column 'Return Discounts Col' =
			IF (
			    Orders[Return Units Col] > 0,
			    IF (
			        Orders[AREPRICESINCLUDINGSALESTAX_SOH] = TRUE,
			        IF (
			            Orders[Returned Tax Col] = 0,
			            Orders[Returned Tax Col],
			            Orders[Return Discounts Col (inc tax)]
			                * (
			                    1
			                        - DIVIDE (
			                            Orders[Returned Tax Col],
			                            Orders[Returned Tax Col] + Orders[Return Net Value Col]
			                        )
			                )
			        ),
			        Orders[Return Discounts Col (inc tax)]
			    ),
			    BLANK ()
			)
		dataType: double
		isHidden
		displayFolder: zz_Values
		lineageTag: ca229a53-8f5f-4f97-b45f-06127ed18c10
		summarizeBy: sum
		isDataTypeInferred

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column 'Return Discounts Col (inc tax)' =
			VAR DiscountSubject = Orders[Return Units Col]
			VAR AvailDiscount = Orders[Discount]
			VAR TotalLineUnits = Orders[ORDEREDSALESQUANTITY_SOL]
			RETURN
			    AvailDiscount
			--AvailDiscount * -1
		dataType: double
		isHidden
		displayFolder: zz_Values
		lineageTag: a21b4ead-5dd0-40cf-90a0-6d5314c1f4d9
		summarizeBy: sum
		isDataTypeInferred

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column 'Return Discounts Col Cons GBP' =
			IF (
			    Orders[Return Units Col] > 0,
			    ( Orders[HeaderDiscount_CONS_GBP] + Orders[LineDiscount_CONS_GBP] ) * Orders[Return Units Pct],
			    BLANK ()
			)
		dataType: double
		isHidden
		displayFolder: zz_Values
		lineageTag: f9e53c91-20e0-42d8-ac2e-ac08be588945
		summarizeBy: sum
		isDataTypeInferred

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column 'Return Full Price' =
			IF (
			    Orders[AREPRICESINCLUDINGSALESTAX_SOH] = TRUE,
			    Orders[Return Net Value Col] + Orders[Return Discounts Col],
			    ( Orders[Unit Price] * Orders[Return Units Col] )
			)
		dataType: double
		isHidden
		formatString: " #,##0.00"
		displayFolder: zz_Values
		lineageTag: 68584971-283d-456f-a209-cc79a5ed7c52
		summarizeBy: sum
		isDataTypeInferred

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isCustom":true}

	column 'Return Full Value Col (inc tax)' =
			IF (
			    Orders[AREPRICESINCLUDINGSALESTAX_SOH] = TRUE,
			    ( Orders[Unit Price] * Orders[Return Units Col] ),
			    BLANK ()
			)
		dataType: double
		isHidden
		displayFolder: zz_Values
		lineageTag: aa16ca17-c988-42a9-ac7c-b33e0c7a3eb2
		summarizeBy: sum
		isDataTypeInferred

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column 'Return Net Value Col' =
			IF (
			    Orders[Return Units Col] > 0,
			    IF (
			        Orders[AREPRICESINCLUDINGSALESTAX_SOH] = TRUE,
			        'Orders'[Return Full Value Col (inc tax)] - Orders[Returned Tax Col] - 'Orders'[Return Discounts Col (inc tax)],
			        ( Orders[Return Units Col] * Orders[Unit Price] ) - Orders[Return Discounts Col (inc tax)]
			    ),
			    BLANK ()
			)
		dataType: double
		isHidden
		displayFolder: zz_Values
		lineageTag: c35a34fe-c64c-4111-b6ea-6bb9b9153f04
		summarizeBy: sum
		isDataTypeInferred

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column 'Return Net Value Col Cons GBP' =
			IF (
			    Orders[Return Units Col] > 0,
			    IF (
			        ISBLANK ( Orders[LINEAMOUNT_ROL_CONS_GBP] ),
			        Orders[LINEAMOUNT_SIL_CONS_GBP] + Orders[HeaderDiscount_CONS_GBP] * Orders[Return Units Pct],
			        Orders[LINEAMOUNT_ROL_CONS_GBP] + Orders[HeaderDiscount_CONS_GBP] * Orders[Return Units Pct]
			    ),
			    BLANK ()
			)
		dataType: double
		isHidden
		displayFolder: zz_Values
		lineageTag: 8187fcff-81f3-47a4-af4f-77f01883fcbc
		summarizeBy: sum
		isDataTypeInferred

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column 'Return Units Col' =
			VAR isreturn =
			    IF (
			        Orders[RETURNSALESQUANTITY_ROL] < 0,
			        Orders[RETURNSALESQUANTITY_ROL] * -1,
			        IF (
			            Orders[INVOICEDQUANTITY_SIL] < 0,
			            Orders[INVOICEDQUANTITY_SIL] * -1,
			            BLANK ()
			        )
			    )
			RETURN
			    IF ( ISBLANK ( Orders[RETURNORDERNUMBER_ROH] ), BLANK (), isreturn )
		dataType: int64
		isHidden
		displayFolder: zz_Units
		lineageTag: a53004d1-719e-44e3-ab36-c8b40ba357ec
		summarizeBy: sum

		changedProperty = IsHidden

		changedProperty = DataType

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column 'Return Units Pct' =
			VAR ReturnUnits = Orders[Return Units Col]
			VAR OrderedUnits =
			    IF (
			        ISBLANK ( Orders[ORDEREDSALESQUANTITY_SOL] ),
			        Orders[RETURNSALESQUANTITY_ROL],
			        Orders[ORDEREDSALESQUANTITY_SOL]
			    )
			RETURN
			    IF (
			        ISBLANK ( Orders[RETURNORDERNUMBER_ROH] ),
			        BLANK (),
			        ABS ( DIVIDE ( ReturnUnits, OrderedUnits, BLANK () ) )
			    )
		dataType: int64
		isHidden
		formatString: " #,##0"
		displayFolder: zz_Units
		lineageTag: b12a60c9-fcab-43e3-85fe-75c333b6834f
		summarizeBy: sum

		changedProperty = IsHidden

		changedProperty = DataType

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isCustom":true}

	column 'Returned COGs Col' =
			IF (
			    Orders[Transaction Type] = "Return",
