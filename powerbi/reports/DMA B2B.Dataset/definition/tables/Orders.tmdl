	column 'Pick Activated Product Units' =
			CALCULATE (
			    [Pick Activated Units],
			    ALLEXCEPT ( Orders, 'Orders'[Sales Order Number], Orders[Product_Key] )
			)
		dataType: int64
		isHidden
		displayFolder: 5. US\zz_Misc
		lineageTag: c25013ae-cf10-4baf-a3cd-99ad84cd8bfc
