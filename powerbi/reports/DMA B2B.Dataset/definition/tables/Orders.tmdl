	column Late? =
			IF (
			    OR ( Orders[SALESORDERPOOLID_SOH] = "DD", Orders[SALESORDERPOOLID_SOH] = "MTO" ),
			    "",
			    IF (
			        ISBLANK ( Orders[SALESINVOICELINERECID_SIL] ),
			        IF (
			            OR (
			                Orders[SRMaxDateLU] > Orders[Requested Shipping Date],
			                TODAY () > Orders[Requested Shipping Date]
			            ),
			            "Late",
			            "On Time"
			        ),
			        IF ( Orders[Req. vs Inv Days] > 0, "Late", "On Time" )
			    )
			)
