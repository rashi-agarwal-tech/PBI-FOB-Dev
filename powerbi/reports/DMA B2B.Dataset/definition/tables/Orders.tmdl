	column 'Cancelled Net Value Col Cons GBP' =
			VAR MAIN =
			    IF (
			        Orders[Cancelled Units Col] > 0,
			        IF (
			            Orders[Transaction Status] = "Cancelled",
			            Orders[LINEAMOUNT_SOL_CONS_GBP] - Orders[HeaderDiscount_CONS_GBP],
			            Orders[DMRCANCELQTY_SOL] * Orders[NetUnitPrice]
			        ),
			        BLANK ()
			    )
			RETURN
			    MAIN
		dataType: double
		isHidden
		formatString: " ""£""#,0.00;-""£""#,0.00;""£""#,0.00"
