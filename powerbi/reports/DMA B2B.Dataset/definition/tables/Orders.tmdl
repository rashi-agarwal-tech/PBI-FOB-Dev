	column 'Invoiced Full Value Col Cons GBP' =
			VAR CHGS = Orders[Invoiced Charges Col Cons GBP]
			VAR MAIN =
			    IF (
			        AND ( ISBLANK ( Orders[Returned Units Col] ), Orders[INVOICEDQUANTITY_SIL] > 0 ),
			        Orders[LINEAMOUNT_SIL_CONS_GBP] + Orders[LineDiscount_CONS_GBP],
			        BLANK ()
			    )
			VAR INVONLY =
			    IF (
			        ISBLANK ( Orders[RETURNORDERNUMBER_ROH] ),
			        Orders[LINEAMOUNT_SIL_CONS_GBP] + Orders[LineDiscount_CONS_GBP],
			        BLANK ()
			    )
			RETURN
			    IF ( ISBLANK ( Orders[Sales Order Number] ), INVONLY, MAIN + CHGS )
		dataType: double
		isHidden
		formatString: " 0.00"
		displayFolder: zz_Values
		lineageTag: 22b6eef9-4cd8-40c4-87b7-c9ea836713a1
		summarizeBy: sum
		isDataTypeInferred

