annotation PBI_QueryOrder = ["Customer Ageing","Accounts Receivable","Deductions","Hold Code Trans","SmartRes","On Hand Stock","Intake","Adjustments Sales","Exchange Rates","Purchase Orders","Product Weights","Seasonal Product Info","Invoice Number","Customer","Forecast","Allocation Details","POCountry","Regions","Seasonal Product Forecast","Financial Channel","Region","Display Currency","Product Class","Selling Status - Order Entry","Sales Order Type","Size","Vendor","Warehouse","Products","Selling Status - Invoice","Date Slicer","Seasons","Customer Sell Out EMEA","Order Type","Adjustments CoGS","Pick","Orders","Sales Packing Slip","Date","Forecast Version","Bridge InventTransID","NumberOfRows","Datasource_Server","Datasource_Warehouse","Datasource_Database","Datasource_Schema"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBIDesktopVersion = 2.127.1080.0 (24.03)

annotation __TEdtr = 1

annotation PBI_ProTooling = ["DevMode"]

