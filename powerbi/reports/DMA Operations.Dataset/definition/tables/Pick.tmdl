	column 'Destination Warehouse' =
			CALCULATE(FIRSTNONBLANK('Movements'[To Warehouse Name],1),FILTER(ALL('Movements'),Pick[D365 Order #]='Movements'[TO#]))
		dataType: string		
		lineageTag: 85408e37-cc03-4a0f-b8c7-3cf771cb7b65
		summarizeBy: none
		isDataTypeInferred		

		annotation SummarizationSetBy = Automatic

	partition Pick = m
		mode: import
		source =
				let
					Source = Snowflake.Databases(Datasource_Server, Datasource_Warehouse),
					PRESENTATION_Database = Source{[Name=Datasource_Database,Kind="Database"]}[Data],
					BFN_PRESENTATION_Schema = PRESENTATION_Database{[Name=Datasource_Schema,Kind="Schema"]}[Data],
					BFN_Datatable_View = BFN_PRESENTATION_Schema{[Name="OPS_BFN_VW_D365FACTPICKINGLIST",Kind="View"]}[Data],
					#"Kept First Rows" = Table.FirstN(BFN_Datatable_View,NumberOfRows),
					ParameterFilter = if NumberOfRows > 0 then #"Kept First Rows" else BFN_Datatable_View
				in
					ParameterFilter

	annotation PBI_ResultType = Table

