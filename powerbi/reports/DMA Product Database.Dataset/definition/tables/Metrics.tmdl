table Metrics
	lineageTag: 7986893c-0847-4c11-b738-02540fe0f7f9

	measure Yesterday =
			CALCULATE (
			    MAX ( DATES[Date] ),
			    ALL ( DATES ),
			    FILTER ( DATES, DATES[- Is Yesterday?] = "Yes" )
			)
		formatString: General Date
		isHidden
		displayFolder: Internal
		lineageTag: 7f943d5b-b67a-4cdc-afb6-eaa746f74300

	measure 'Net Units' = [Sold Units] - [Returned Units]
		formatString: " #,0"
		lineageTag: 03ec5029-a604-4e3d-8f0e-c03b524aa528

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'Sold Value' = SUM ( Orders[Invoiced Net Value Col Direct Cons GBP] )
		formatString: #,0.00
		lineageTag: ef5d174f-70c1-4d12-a68b-d141edf61464

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'Returns Value' = ```
			CALCULATE (
			    SUM ( 'Orders'[Returned Net Value Col Direct Cons GBP] ),
			    FILTER ( Orders, Orders[isCarrierBag] = FALSE )
			) 
			```
		formatString: #,0.00
		lineageTag: c3de4710-7d46-4295-a0f6-3bd3ee42bc34

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'Net Sales' = [Sold Value] - ABS ( [Returns Value] )
		formatString: #,0.00
		lineageTag: 471e3476-d46a-44df-a57a-c9c93f2da0f0

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'Sold Units' =
			CALCULATE (
			    SUM ( 'Orders'[Invoiced Units Col] ),
			    FILTER ( 'Orders', Orders[isCarrierBag] = FALSE )
			)
		formatString: #,0
		lineageTag: 140be064-3118-47aa-a9e1-9cf16506c7ab

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'Returned Units' =
			CALCULATE (
			    SUM ( Orders[Returned Units Col] ),
			    FILTER ( Orders, Orders[isCarrierBag] = FALSE )
			)
		formatString: #,0
		lineageTag: 53e01568-370c-42b2-9f45-9b4a6fba4623

		annotation PBI_FormatHint = {"isCustom":true}

	measure COGS = SUM ( 'Orders'[Invoiced COGS Col] ) - SUM ( 'Orders'[Returned COGS Col] )
		lineageTag: 5cd53fc2-aaae-4379-99c4-1d0d5d132a31

		annotation PBI_FormatHint = {"isGeneralNumber":true}

