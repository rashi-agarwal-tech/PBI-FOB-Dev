	column CGID = Customer[Customer Group] & ":" & Customer[Company ID]
		dataType: string
		lineageTag: 596687f1-1fc3-41aa-ac29-09c227d3623c
		summarizeBy: none
		isDataTypeInferred

		annotation SummarizationSetBy = Automatic

	column 'Sell Thru Account' =
			IF (
			    OR (
			        Customer[Customer Channel] = "Retail",
			        Customer[Customer Channel] = "eCommerce"
			    ),
			    Customer[Customer Region Channel],
			    IF (
			        Customer[Customer Region Channel] IN { "USA eCommerce", "USA Retail" },
			        Customer[Invoice Account Name],
			        Customer[Customer Name]
			    )
			)
		dataType: string
		lineageTag: b8f08eaa-a172-4a2b-82da-b86cbc8a9030
		summarizeBy: none
		isDataTypeInferred

		annotation SummarizationSetBy = Automatic

	column ' Last External Sell Thru Upload (US)' = CALCULATE ( LASTDATE ( 'Customer Sell Out US'[To Date] ), ALL ( Products ) )
		dataType: dateTime
		formatString: Short Date
		lineageTag: 54927ef5-0e6b-4e66-90e2-9d683a24f577
		summarizeBy: none
		isDataTypeInferred

		annotation SummarizationSetBy = Automatic

	column 'Top Line Channel' =
			SWITCH (
			    Customer[Customer Channel],
			    "Retail", "DTC",
			    "eCommerce", "DTC",
			    "Distributors", "Wholesale & Export",
			    "Wholesale", "Wholesale & Export",
			    "Other", "Other",
			    BLANK ()
			)
		dataType: string
		lineageTag: 5618897e-b927-4976-943b-1bab7a11a053
		summarizeBy: none
		isDataTypeInferred

		annotation SummarizationSetBy = Automatic

	partition Customer = m
		mode: import
		source =
				let
				    Source = Snowflake.Databases(Datasource_Server,Datasource_Warehouse),
				    PRESENTATION_Database = Source{[Name=Datasource_Database,Kind="Database"]}[Data],
				    BFN_PRESENTATION_Schema = PRESENTATION_Database{[Name=Datasource_Schema,Kind="Schema"]}[Data],
				    TB_BFN_VW_D365DIMCUSTOMER_View = BFN_PRESENTATION_Schema{[Name="TB_BFN_VW_D365DIMCUSTOMER",Kind="View"]}[Data],
				    #"Kept First Rows" = Table.FirstN(TB_BFN_VW_D365DIMCUSTOMER_View,NumberOfRows),
				    ParameterFilter = if NumberOfRows > 0 then #"Kept First Rows" else TB_BFN_VW_D365DIMCUSTOMER_View
				in
				    ParameterFilter

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

