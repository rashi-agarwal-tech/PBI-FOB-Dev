model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup Parameters

	annotation PBI_QueryGroupOrder = 0

annotation PBI_QueryOrder = ["Channel","Regions","Pick","Hours Worked","Order Taker","Seasonal Product Forecast","Store Activity FC","Forecast","Bridge InventTransID","BridgeSalesOrderNumber","Order Type","Deductions","Hold Code Trans","SmartRes","Retail Demographics","Orders","Sales Packing Slip","Financial Channel","Region","Display Currency","Customer","Product Class","Account Details","Sales Order Type","Selling Status - Invoice","Size","Warehouse","Adjustments CoGS","Adjustments Sales","Exchange Rates","Purchase Orders","Products","Selling Status - Order Entry","Time","Date","Date Slicer","Product Forecast","Seasons","Footfall","Website","Product Weights","Seasonal Product Info","Customer Sell Out EMEA","Customer Sell Out US","Forecast Version","Seasons (Product Report)","Bridge Product","NumberOfRows","Refit Slicer","Datasource_Server","Datasource_Warehouse","Datasource_Database","Datasource_Schema"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBIDesktopVersion = 2.126.927.0 (24.02)

annotation __TEdtr = 1

annotation PBI_ProTooling = ["DevMode"]

