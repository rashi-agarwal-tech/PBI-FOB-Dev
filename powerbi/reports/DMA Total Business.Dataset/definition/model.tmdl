model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup Parameters

	annotation PBI_QueryGroupOrder = 0

annotation PBI_QueryOrder = ["Account Details", "Adjustments CoGS", "Adjustments Sales", "Bridge InventTransID", "Bridge Product", "BridgeSalesOrderNumber", "Channel", "Customer", "Customer Sell Out EMEA", "Customer Sell Out US", "Datasource_Database", "Datasource_Schema", "Datasource_Server", "Datasource_Warehouse", "Date", "Date Slicer", "Deductions", "Display Currency", "Exchange Rates", "Financial Channel", "Footfall", "Forecast", "Forecast Version", "Hold Code Trans", "Hours Worked", "NumberOfRows", "Order Taker", "Order Type", "Orders", "Pick", "Product Class", "Product Forecast", "Product Weights", "Products", "Purchase Orders", "Refit Slicer", "Region", "Regions", "Retail Demographics", "Sales Order Type", "Sales Packing Slip", "Seasonal Product Forecast", "Seasonal Product Info", "Seasons", "Seasons (Product Report)", "Selling Status - Invoice", "Selling Status - Order Entry", "Size", "SmartRes", "Store Activity FC", "Time", "Warehouse", "Website"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBIDesktopVersion = 2.126.927.0 (24.02)

annotation __TEdtr = 1

annotation PBI_ProTooling = ["DevMode"]

