ref table 'Adjustments Sales'
ref table 'Exchange Rates'
ref table 'Purchase Orders'
ref table Products
ref table 'Selling Status - Order Entry'
ref table Time
ref table Date
ref table 'Date Slicer'
ref table 'Product Forecast'
