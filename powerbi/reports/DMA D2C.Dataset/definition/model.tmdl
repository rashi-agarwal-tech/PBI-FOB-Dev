model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-GB
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup Parameters

	annotation PBI_QueryGroupOrder = 0

annotation PBI_QueryOrder = ["Account Details", "Adjustments CoGS", "Adjustments Sales", "Availability", "Bridge InventTransID", "BridgeSalesOrderNumber", "Channel", "Customer", "Datasource_Database", "Datasource_Schema", "Datasource_Server", "Datasource_Warehouse", "Date", "Date - Order Date", "Date Slicer", "Display Currency", "Ecom Email Marketing", "Exchange Rates", "Financial Channel", "Footfall", "Forecast", "Forecast Additional Ecom", "Forecast Ecom Demand", "Forecast Version", "GA Country", "GA Demand FC", "Google Analytics", "Google Analytics Ads", "Google Analytics Goals", "Hours Worked", "NumberOfRows", "Open eCom Return Info", "Order Taker", "Order Type", "Orders", "Orders_View", "Pick", "Product Class", "Product Weights", "Products", "Purchase Orders", "RangeEnd", "RangeStart", "Refit Exclusion", "Refit Slicer", "Region", "Regions", "Retail Demographics", "Retail Payment Details", "Retail Payment Methods", "Seasonal Product Forecast", "Seasonal Product Info", "Selling Status - Invoice", "Selling Status - Order Entry", "Size", "Size Classification", "SmartRes", "Store Activity FC", "TMALL", "Territory", "Time", "Warehouse", "Web Channel", "Web Device", "Website", "Website Name"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBIDesktopVersion = 2.128.952.0 (24.04)

annotation PBI_ProTooling = ["DevMode"]

