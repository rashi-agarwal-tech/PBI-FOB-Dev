model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-GB
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup Parameters

	annotation PBI_QueryGroupOrder = 0

annotation PBI_QueryOrder = ["Regions","Pick","GA Demand FC","Hours Worked","Order Taker","Seasonal Product Forecast","Refit Exclusion","Store Activity FC","Forecast","Bridge InventTransID","Retail Demographics","Retail Payment Details","Retail Payment Methods","Orders","Financial Channel","Region","Display Currency","Customer","Product Class","Selling Status - Invoice","Selling Status - Order Entry","Account Details","Size","Warehouse","Adjustments CoGS","Adjustments Sales","Exchange Rates","Purchase Orders","Order Type","Ecom Email Marketing","Products","Time","Date","Date - Order Date","Date Slicer","Google Analytics Ads","Google Analytics","Google Analytics Goals","GA Country","Website Name","Open eCom Return Info","Product Weights","Web Channel","Web Device","Website","BridgeSalesOrderNumber","Size Classification","SmartRes","Availability","Footfall","Forecast Version","Refit Slicer","Channel","Territory","Seasonal Product Info","Forecast Additional Ecom","Forecast Ecom Demand","TMALL","NumberOfRows","RangeStart","RangeEnd","Datasource_Server","Datasource_Warehouse","Datasource_Database","Datasource_Schema","Orders_View"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBIDesktopVersion = 2.128.751.0 (24.04)

annotation PBI_ProTooling = ["DevMode"]

