	column 'Net Units Col' = Orders[Open Units Col] + Orders[Invoiced Units Col] - Orders[Returned Units Col]
		dataType: int64
		isHidden
		formatString: #,##0
		displayFolder: zz_Units
		lineageTag: c01d3881-e0bb-4389-aa41-36fc90e9dbb9
		summarizeBy: none

		changedProperty = IsHidden

		changedProperty = DataType

		annotation SummarizationSetBy = User

		annotation PBI_FormatHint = {"isCustom":true}

	column 'Open eCom Return Quantity' =
			IF (
			    ISBLANK ( RELATED ( 'Open eCom Return Info'[Processed Date] ) ) = TRUE ()
			        && RELATED ( 'Open eCom Return Info'[Returned Status] ) <> "Expired",
			    RELATED ( 'Open eCom Return Info'[Quantity] ),
			    BLANK ()
			)
		dataType: int64
		isHidden
		displayFolder: zz_Units
		lineageTag: 5532b8db-6b13-4770-a6c5-63df3d5dbafc
		summarizeBy: none
		isDataTypeInferred

		changedProperty = IsHidden

		annotation SummarizationSetBy = User

	column 'Ordered eCom Return Quantity' = RELATED ( 'Open eCom Return Info'[Quantity] )
		dataType: int64
		isHidden
		displayFolder: zz_Units
		lineageTag: a59cf077-d8b3-4509-bf55-0d22c764c522
		summarizeBy: none
		isDataTypeInferred

		changedProperty = IsHidden

		annotation SummarizationSetBy = User

	column 'eCom Demand Open Value Col' =
			VAR main = ( Orders[Unit Price] * Orders[Open Units Col] ) - Orders[Open Discounts Col]
			RETURN
			    IF (
			        Orders[SALESORDERPOOLID_SOH] = "EO",
			        IF ( ISBLANK ( Orders[RMA Number] ), main, BLANK () ),
			        BLANK ()
			    )
		dataType: double
		isHidden
		displayFolder: zz_Values
		lineageTag: 467b8019-cf44-408d-8379-d9fa43565c37
		summarizeBy: sum
		isDataTypeInferred

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column 'Full Price (inc tax) Invoiced Col' =
			IF (
			    Orders[AREPRICESINCLUDINGSALESTAX_SOH] = TRUE,
			    IF (
			        Orders[Source] = "AX_Invoiced_US"
			            && Orders[LINEAMOUNT_SIL_CONS_GBP] > 0
			            && Orders[Invoiced Units Col] = 0,
			        Orders[LINEAMOUNT_SIL_CONS_GBP],
			         ( Orders[Unit Price] * Orders[Invoiced Units Col] )
			    ),
			    BLANK ()
			)
		dataType: double
		isHidden
		displayFolder: zz_Values
		lineageTag: 98773fe3-5470-46bb-927a-3a0ce60b9c75
		summarizeBy: sum
		isDataTypeInferred

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column 'Full Price (inc tax) Open Col' =
			IF (
			    Orders[AREPRICESINCLUDINGSALESTAX_SOH] = TRUE,
			     ( Orders[Unit Price] * Orders[Open Units Col] ),
			    BLANK ()
			)
		dataType: double
		isHidden
		displayFolder: zz_Values
		lineageTag: 61fa2ba4-f4fa-4336-84b0-c154289ec301
		summarizeBy: sum
		isDataTypeInferred

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column 'Invoiced Discounts Col Cons GBP' =
			IF (
			    Orders[Invoiced Units Col] > 0,
			    Orders[HeaderDiscount_CONS_GBP] + Orders[LineDiscount_CONS_GBP],
			    BLANK ()
			)
		dataType: double
		isHidden
		displayFolder: zz_Values
		lineageTag: e2eca71c-0d02-4700-85a5-af1f65c45def
		summarizeBy: sum
		isDataTypeInferred

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column 'Invoiced Full Value Col Cons GBP' =
			VAR CHGS = Orders[Invoiced Charges Col Cons GBP]
			VAR MAIN =
			    IF (
			        Orders[Invoiced Units Col] > 0,
			        Orders[LINEAMOUNT_SIL_CONS_GBP] + Orders[LineDiscount_CONS_GBP],
			        BLANK ()
			    )
			RETURN
			    IF ( Orders[Transaction Type] IN { "Sale", "Charge" }, MAIN + CHGS, BLANK () )
		dataType: double
		isHidden
		formatString: 0.00
		displayFolder: zz_Values
		lineageTag: 99444dd7-6e49-49d2-8282-febd73305dc3
		summarizeBy: sum
		isDataTypeInferred

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isCustom":true}

	column 'Invoiced Tax Col' =
			IF (
			    AND (
			        'Orders'[Transaction Status] = "Invoiced",
			        ISBLANK ( Orders[Returned Units Col] )
			    ),
			    'Orders'[Tax_CONS_GBP],
			    BLANK ()
			)
		dataType: double
		isHidden
		displayFolder: zz_Values
		lineageTag: 6b378e0e-9c3b-42bd-9b54-48ec318cb5ab
		summarizeBy: sum
		isDataTypeInferred

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

