	measure 'Net Units LFY' =
			IF (
			    HASONEVALUE ( 'Date'[Financial Year] ),
			    CALCULATE (
			        [Net Units],
			        ALL ( 'Date Slicer'[Date Slicer] ),
			        FILTER (
			            ALL ( 'Date' ),
			            'Date'[Financial Year]
			                = VALUES ( 'Date'[Financial Year] ) - 1
			                && CONTAINS (
			                    VALUES ( 'Date'[Fiscal Day #] ),
			                    'Date'[Fiscal Day #], 'Date'[Fiscal Day #]
			                )
			        )
			    ),
			    BLANK ()
			)
		formatString: #,0
		isHidden
		displayFolder: Sales Metrics\x1. Net\vs.\vs EMEA LFY
		lineageTag: 95f9dc7a-1c85-47b9-abbc-83c818207a20

		annotation PBI_FormatHint = {"isCustom":true}

