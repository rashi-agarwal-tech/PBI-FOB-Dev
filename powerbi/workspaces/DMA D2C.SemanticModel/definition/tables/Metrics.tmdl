	measure 'Avg Depth LFY' =
			IF (
			    HASONEFILTER ( 'Date'[Fiscal Year] )
			        && HASONEFILTER ( 'Date'[Is Week Filter (544)] ),
			    CALCULATE (
			     [Avg Depth],
			        ALL ( 'Date' ),
			        FILTER (
			            ALL ( 'Date' ),
			            'Date'[Financial Year]
			                = VALUES ( 'Date'[Financial Year] ) - 1
			                && CONTAINS (
			                    VALUES ( 'Date' ),
			                    'Date'[Fiscal Period Number], 'Date'[Fiscal Period Number]
			                )
			        )
			    ),
			    CALCULATE (
			       [Avg Depth],
			        FILTER (
			            ALL ( 'Date' ),
			            CONTAINS (
			                VALUES ( 'Date'[ Last Year Date] ),
			                'Date'[ Last Year Date], 'Date'[ Date]
			            )
			        )
			    )
			)
		displayFolder: Web Analytics\vs.\vs EMEA LFY
		lineageTag: 02cd807a-31ee-4905-9df1-2133f6bca5ce

		annotation PBI_FormatHint = {"isGeneralNumber":true}

