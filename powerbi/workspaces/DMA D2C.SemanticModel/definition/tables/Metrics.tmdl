			        [Returned Net Value] ,
			        All ('Date'),
			        All ('Date Slicer'[Date Slicer]),
			        FILTER (
			            ALL ( 'Date' ),
			            'Date'[Reporting Year] = VALUES ( 'Date'[Reporting Year] ) - 1
			                && CONTAINS(
			                    VALUES ( 'Date'[Day # of Year] ),
			                    'Date'[Day # of Year],
			                    'Date'[Day # of Year] ) 
			        )
			    ),
			    BLANK ()
			)            
			```
		formatString: #,0.00
		displayFolder: Sales Metrics\03. Returned\vs.\vs LY
		lineageTag: b566820d-c0ee-44dc-b64d-6c287abaf3e3

