	measure 'Retail Days % Gone' = divide([Retail Days Gone],[Retail Days Gone]+[Retail Days Remaining])
		formatString: 0%;-0%;0%
		displayFolder: Sales Metrics\10. Other
		lineageTag: 89f6079f-b304-48c2-86c4-7696d3c16a51

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'Retail Days Gone' = ```
			
			VAR CurrYear =  CALCULATE(MAX('Date'[Year]), ALL('Date'), FILTER('Date', 'Date'[- Is Yesterday?] = "Yes"))
			
			VAR CurrDate = CALCULATE(MAX('Date'[ Date]), ALL('Date'), FILTER('Date', 'Date'[- Is Yesterday?] = "Yes"))
			
			VAR CurrXmas = DATE(YEAR(CurrYear), MONTH(12), DAY(25)) 
			
			RETURN 
			    CALCULATE(COUNTROWS('Date'), ALL('Date'), FILTER('Date', 'Date'[Year] = CurrYear && 'Date'[ Date] <= CurrDate
			            && 'Date'[ Date] <> CurrXmas))
			```
		formatString: 0
		displayFolder: Sales Metrics\10. Other
		lineageTag: 4d4723b4-c8d3-4981-b44a-8109bc8a457c

	measure 'Retail Days Remaining' = ```
			
			VAR CurrYear =  CALCULATE(MAX('Date'[Year]), ALL('Date'), FILTER('Date', 'Date'[- Is Yesterday?] = "Yes"))
			
			VAR CurrDate = CALCULATE(MAX('Date'[ Date]), ALL('Date'), FILTER('Date', 'Date'[- Is Yesterday?] = "Yes"))
			
			VAR CurrXmas = DATE(YEAR(CurrYear), MONTH(12), DAY(25)) 
			
			RETURN 
			    CALCULATE(COUNTROWS('Date'), ALL('Date'), FILTER('Date', 'Date'[Year] = CurrYear && 'Date'[ Date] > CurrDate
			            && 'Date'[ Date] <> CurrXmas))
			```
		formatString: 0
		displayFolder: Sales Metrics\10. Other
		lineageTag: 07998775-8677-44c2-8bdc-7e9491ea1cba

