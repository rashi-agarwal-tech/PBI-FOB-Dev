	measure 'Avg Unit Value LY' = ```
			IF (
			    HASONEVALUE ( 'Date'[Reporting Year] ),
			    CALCULATE (
			          [Avg Unit Value] ,
			        All ('Date Slicer'[Date Slicer]),
			        FILTER (
			            ALL ( 'Date' ),
			            'Date'[Reporting Year] = VALUES ( 'Date'[Reporting Year] ) - 1
			                && CONTAINS(
			                    VALUES ( 'Date'[Day # of Year] ),
			                    'Date'[Day # of Year],
			                    'Date'[Day # of Year] ) 
			        )
			    ),
			    BLANK ()
			)
