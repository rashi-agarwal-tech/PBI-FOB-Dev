		annotation PBI_FormatHint = {"isCustom":true}

	measure 'eCom Multiple Size Order %' =
			DIVIDE (
			    CALCULATE (
			        DISTINCTCOUNT ( Orders[Sales Order Number] ),
			        Orders[EcomMultipleSizeOrderFlag] = TRUE ()
			    ),
			    CALCULATE (
			        DISTINCTCOUNT ( Orders[Sales Order Number] ),
			        Orders[SALESORDERPOOLID_SOH] = "EO"
			    )
			)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Sales Metrics\05. Net Transactions
