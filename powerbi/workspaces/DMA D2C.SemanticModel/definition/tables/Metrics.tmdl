	measure 'ROS (ranged)' =
			CALCULATE (
			    SUMX ( Availability, Availability[InvoicedUnits] ),
			    Availability[Ranged?] = TRUE,
			    Products[Product General] = "Footwear"
			)
		formatString: #,0.00
		isHidden
		displayFolder: Stock Metrics\3. ROS / Cover
		lineageTag: 46142658-7a68-4a0d-b33d-984f46370928

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'ROS (stocked)' =
			VAR TmpAvailability =
			    CALCULATETABLE ( Availability, Availability[Ranged?] = TRUE )
			VAR RangedCount =
			    COUNTROWS ( TmpAvailability )
			RETURN
			    DIVIDE ( [ROS (ranged)], [Stocked] ) * RangedCount
		formatString: #,0.00
		isHidden
		displayFolder: Stock Metrics\3. ROS / Cover
		lineageTag: 90c088c9-290c-47ae-bd63-7da59ba0d2d5

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'ROS 1W' =
			var LNBUnits = Calculate ([Total Units], DATESINPERIOD('Date'[ Date], LASTNONBLANK('Date'[ Date],[Total Units]),-7,DAY))
			
			return
			LNBUnits
		formatString: #,0
		displayFolder: Stock Metrics\3. ROS / Cover
		lineageTag: 2dfdb33f-6e9b-46a7-ba63-e2c2f39e8fe2

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'ROS 4W' =
			var LNBUnits = CALCULATE([Total Units], DATESINPERIOD('Date'[ Date], LASTNONBLANK('Date'[ Date],[Total Units]),-28,DAY))
			
			return
			LNBUnits
		displayFolder: Stock Metrics\3. ROS / Cover
		lineageTag: 827e4b4a-f44b-4fea-9bdf-b76d3a7e6dfc

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'ROS N3M' = ```
			
			VAR L3M =
			    DIVIDE (
			        CALCULATE (
			            [Total Units],
			            DATESINPERIOD ( 'Date'[ Date], LASTNONBLANK( 'Date'[ Date] , [Total Units]), -91, DAY ) 
			            ),
			        13
			    )
			
			VAR L3MLY =
			    CALCULATE (
			        [Total Units],
			        DATESINPERIOD ( 'Date'[ Date], LASTNONBLANK( 'Date'[ Date] , [Total Units]) -364, -91, DAY ) ,
			        ALL ( Products )
			    )
			VAR N3MLY =
			    CALCULATE (
			        [Total Units],
			        DATESINPERIOD ( 'Date'[ Date], LASTNONBLANK( 'Date'[ Date] , [Total Units]) -364, 91, DAY ), 
			        ALL ( Products )
			    )
			VAR uplift =
			    DIVIDE ( N3MLY, L3MLY, 1 )
			VAR ROSN3M = L3M * uplift
			
			RETURN
			    IF ( ROSn3m > 0, ROSN3M, BLANK () )
			```
		formatString: #,0
		displayFolder: Stock Metrics\3. ROS / Cover
		lineageTag: 9b81605d-9f50-44b2-8060-021689511c62

		annotation PBI_FormatHint = {"isCustom":true}

	measure ROS/Store =
			VAR main =
			    DIVIDE (
			        CALCULATE (
			            [Total Units],
			            DATESINPERIOD ( 'Date'[ Date], LASTDATE ( 'Date'[ Date] ), -7, DAY ),
			            Orders[Finance Dimension - Channel] = "101"
			        ),
			        [Ranged Stores]
			    )
			RETURN
			    IF ( main > 0, main, BLANK () )
		formatString: 0.0
		displayFolder: Stock Metrics\3. ROS / Cover
		lineageTag: 314a998c-7366-459a-b1f0-fb4d76b7a001

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'Stock Turn' =
			var yearsales = divide([Total Units],DISTINCTCOUNT('Date'[ Date])*365)
			var main = DIVIDE(yearsales,[1. All On Hand Stock Units])
			
			return
			
			if(main>0,main,blank())
		displayFolder: Stock Metrics\3. ROS / Cover
		lineageTag: 21e29b79-180d-4d73-b248-ff54920d8ab9

