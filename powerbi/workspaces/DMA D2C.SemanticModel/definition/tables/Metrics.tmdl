	measure '2. WH Stock Units' =
			VAR ldate =
			    CALCULATE (
			        LASTDATE ( Availability[DATE] ),
			        ALL ( Products ),
			        ALL ( Size ),
			        ALL ( 'Account Details' )
			    )
			VAR Main =
			    CALCULATE (
			        SUM ( Availability[OnHandUnits] ),
			        ( Warehouse[Warehouse ID]
			            IN {
			            "UKRET01",
