	measure 'Returned % LFY' =
			IF (
			    HASONEFILTER ( 'Date'[Fiscal Year] )
			        && HASONEFILTER ( 'Date'[Is Week Filter (544)] ),
			    CALCULATE (
			        [Returned %],
			        ALL ( 'Date' ),
			        FILTER (
			            ALL ( 'Date' ),
			            'Date'[Financial Year]
			                = VALUES ( 'Date'[Financial Year] ) - 1
			                && CONTAINS (
			                    VALUES ( 'Date' ),
			                    'Date'[Fiscal Period Number], 'Date'[Fiscal Period Number]
			                )
			        )
			    ),
			    CALCULATE (
			        [Returned %],
			        FILTER (
			            ALL ( 'Date' ),
			            CONTAINS (
			                VALUES ( 'Date'[ Last Year Date] ),
			                'Date'[ Last Year Date], 'Date'[ Date]
			            )
			        )
			    )
			)
		formatString: #,0.0%;-#,0.0%;#,0.0%
		displayFolder: Sales Metrics\03. Returned\vs.\vs EMEA LFY
		lineageTag: 8090b8b5-e540-44f5-883e-18fe21543e20

		annotation PBI_FormatHint = {"isCustom":true}

