		annotation PBI_FormatHint = {"isCustom":true}

	measure 'eCom Raw Demand Units' =
			VAR TmpEcomOrders =
			    CALCULATETABLE (
			        Orders,
			        Orders[Finance Dimension - Channel] = "102",
			        USERELATIONSHIP ( Orders[Order DateTime], 'Date'[ Date] )
			    )
			VAR ItemSizeCount =
			    COUNTROWS (
			        GROUPBY (
			            TmpEcomOrders,
			            Orders[Sales Order Number],
			            Orders[ITEMNUMBER_SOL_ROL],
			            Size[Size_Key]
			        )
			    )
			VAR ItemCount =
			    COUNTROWS (
			        GROUPBY (
			            TmpEcomOrders,
			            Orders[Sales Order Number],
			            Orders[ITEMNUMBER_SOL_ROL]
			        )
			    )
			VAR main = [eCom Demand Units] - ( ItemSizeCount - ItemCount )
			RETURN
			    IF ( main > 0, main, BLANK () )
		formatString: #,##0
		displayFolder: Sales Metrics\07. Demand
		lineageTag: 1228fa7c-cdb9-4a13-8157-e25315bf9677

