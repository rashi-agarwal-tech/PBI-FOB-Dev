	measure 'N3M Uplift' =
			
			VAR L3MLY =
			    CALCULATE (
			        [Total Units],
			         DATESINPERIOD ( 'Date'[ Date], LASTNONBLANK( 'Date'[ Date] , [Total Units]) -364, -91, DAY ) ,
			        ALL ( Products )
			    )
			VAR N3MLY =
			    CALCULATE (
			        [Total Units],
			        DATESINPERIOD ( 'Date'[ Date], LASTNONBLANK( 'Date'[ Date] , [Total Units]) -364, 91, DAY ) ,
			        ALL ( Products )
			    )
			VAR uplift =
			    DIVIDE ( N3MLY, L3MLY, 1 ) - 1
			RETURN
			    IF ( not(uplift = 0), uplift, BLANK () )
		formatString: #,0%;-#,0%;#,0%
		displayFolder: Stock Metrics\9. Other
