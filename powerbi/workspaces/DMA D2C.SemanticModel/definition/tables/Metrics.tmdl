		lineageTag: 365a1f2e-8059-46c4-96c7-24013a034d8f

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'eCom Demand Conversion' = DIVIDE([eCom Demand Transactions], [Web Sessions])
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Sales Metrics\08. eCom Demand
		lineageTag: d9b7f24c-f7f3-48bb-b6db-4fd04bf3f7c4

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'eCom Demand Conversion %' =
			VAR FNBMonth =
			    FIRSTDATE ( 'Date'[ Date] )
			VAR LNBMonth =
			    LASTDATE ( 'Date'[ Date] )
			VAR OrderedNV =
			    CALCULATE (
			        [eCom Demand Units],
			        DATESBETWEEN ( Orders[Order DateTime], FNBMonth, LNBMonth )
			    )
			VAR InvoicedNV =
			    CALCULATE (
			        [Invoiced Units],
			        DATESBETWEEN ( Orders[Order DateTime], FNBMonth, LNBMonth ),
			        DATESBETWEEN ( 'Orders'[INVOICEDATE_SIL], FNBMonth, LNBMonth )
			    )
			VAR Main =
			    DIVIDE ( InvoicedNV, OrderedNV )
			RETURN
			    Main
		formatString: 0.0%;-0.0%;0.0%
		isHidden
		displayFolder: Sales Metrics\08. eCom Demand
		lineageTag: bf729a23-2697-4399-9dec-6ed04daf246e

		annotation PBI_FormatHint = {"isCustom":true}

