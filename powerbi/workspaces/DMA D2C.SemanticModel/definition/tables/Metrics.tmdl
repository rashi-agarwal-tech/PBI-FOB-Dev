	measure Downsize = ```
			
			countrows(
			    filter(
			        SUMMARIZE(Orders, 
			            Orders[Customer_Key],
			            Products[Style Colour Material],
			            "Total Trans", COUNTROWS(Orders),
			            "NoOfSale", COUNTROWS(filter(Orders,Orders[Transaction Type]="Sale")),
			            "NoOfReturn", COUNTROWS(filter(Orders,Orders[Transaction Type]="Return")),
			            "MinReturnDate", CALCULATE(min('Date - Order Date'[ Order Date]), Orders[Transaction Type]="Return"),
			            "MaxSaleDate", CALCULATE(max('Date - Order Date'[ Order Date]), Orders[Transaction Type]="Sale"),
			            "min_sale_size", CALCULATE(min(Size[Size_Key]),Orders[Transaction Type]="Sale"),
			            "min_return_size", CALCULATE(min(Size[Size_Key]),Orders[Transaction Type]="Return")
			                ),
			        [Total Trans]>=2 && [NoOfSale]=2 && [NoOfReturn]=1 && [Net Value]>15 && [MinReturnDate]<[MaxSaleDate] && [min_sale_size]< [min_return_size]
			        )
			)+
			countrows(
			filter(
			    SUMMARIZE(Orders, 
			        Products[Style Colour Material],
			      //  Orders[Customer Order Reference],
			        Orders[Sales Order Number],
			        "Total Trans", COUNTROWS(Orders),
			        "Invoice-Return", [Invoiced Net Value]-[Returned Net Value],
			        "size_cnt", DISTINCTCOUNT(Size[DisplayOrder]),
			        "sale_size", CALCULATE(min(Size[DisplayOrder]),Orders[Transaction Type]="Sale"),
			        "return_size", CALCULATE(min(Size[DisplayOrder]),Orders[Transaction Type]="Return"),
			        "Return Trans", CALCULATE(COUNTROWS(Orders), Orders[Transaction Type]="Return")
			            ),
			    [Total Trans]>=2 && [Invoice-Return]>15  && [Return Trans]=1 && [size_cnt]>1 && [sale_size]<>[return_size]
			        )
			)
			```
		displayFolder: Sales Metrics\10. Other
		lineageTag: bf2021dd-441c-4953-94ea-cbce342eba42

