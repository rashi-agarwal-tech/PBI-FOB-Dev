	measure 'Returned % US LFY' =
			IF (
			    HASONEFILTER ( 'Date'[Fiscal US Year] )
			        && HASONEFILTER ( 'Date'[Is Week Filter (544)] ),
			    CALCULATE (
			        [Returned %],
			        ALL ( 'Date' ),
			        FILTER (
			            ALL ( 'Date' ),
			            'Date'[Financial Year]
			                = VALUES ( 'Date'[Financial Year] ) - 1
			                && CONTAINS (
			                    VALUES ( 'Date' ),
			                    'Date'[Fiscal US Period Number], 'Date'[Fiscal US Period Number]
			                )
			        )
			    ),
			    CALCULATE (
			        [Returned %],
			        FILTER (
			            ALL ( 'Date' ),
			            CONTAINS (
			                VALUES ( 'Date'[ Last Year Date] ),
			                'Date'[ Last Year Date], 'Date'[ Date]
			            )
			        )
			    )
			)
		formatString: #,0.0%;-#,0.0%;#,0.0%
		displayFolder: Sales Metrics\03. Returned\vs.\vs US LFY
		lineageTag: c4c28f0d-e121-46cf-a3ec-973ff2c57b5e

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'Returned Net Value US LFY' = ```
			IF (
			    HASONEFILTER ( 'Date'[Fiscal US Year] )
			        && HASONEFILTER ( 'Date'[Is Week Filter (544)] ),
			    CALCULATE (
			       [Returned Net Value], 
			        ALL ( 'Date' ),
			        FILTER (
			            ALL ( 'Date' ),
			            'Date'[Financial Year]
			                = VALUES ( 'Date'[Financial Year] ) - 1
			                && CONTAINS (
			                    VALUES ( 'Date' ),
			                    'Date'[Fiscal US Period Number], 'Date'[Fiscal US Period Number]
			                )
			        )
			    ),
			    CALCULATE (
			     [Returned Net Value],
			        FILTER (
			            ALL ( 'Date' ),
			            CONTAINS (
			                VALUES ( 'Date'[ Last Year Date] ),
			                'Date'[ Last Year Date], 'Date'[ Date]
			            )
			        )
			    )
			)
			```
		displayFolder: Sales Metrics\03. Returned\vs.\vs US LFY
		lineageTag: b7cc73b3-17c3-4d94-94ce-e3aa6bb9ce44

		annotation PBI_FormatHint = {"isGeneralNumber":true}

