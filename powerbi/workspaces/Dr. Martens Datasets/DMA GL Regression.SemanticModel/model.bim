            "mode": "import",
            "source": {
              "expression": [
                "",
                "SUMMARIZE",
                "(",
                "    'Parameter - Metrics'",
                "    ,\"RowCount of GeneralLedgerFact\",COUNTROWS('General Ledger Fact')",
