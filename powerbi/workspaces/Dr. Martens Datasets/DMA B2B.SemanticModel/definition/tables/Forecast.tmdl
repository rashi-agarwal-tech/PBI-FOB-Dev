	column FCRanker =
			IF (
			    ISBLANK ( FIND ( "+", Forecast[Forecast Version], 1, BLANK () ) ),
			    BLANK (),
			    YEAR ( Forecast[Date] )
			        + LEFT (
			            Forecast[Forecast Version],
			            LEN ( Forecast[Forecast Version] )
			                - FIND ( "+", Forecast[Forecast Version], 1, BLANK () )
			        )
			)
		formatString: " #,##0.00"
		displayFolder: zz_Misc
		lineageTag: 69b9bdf5-99d7-4e54-b33f-f184520a646b
		summarizeBy: none

		annotation SummarizationSetBy = User

		annotation PBI_FormatHint = {"isCustom":true}

