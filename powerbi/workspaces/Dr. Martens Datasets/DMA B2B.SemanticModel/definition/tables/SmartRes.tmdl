	column 'Available Date'
		dataType: dateTime
		formatString: Short Date
		sourceProviderType: datetime2
		displayFolder: zz_Values
		lineageTag: 2f6d9264-a338-472a-8f33-5d75e67de25a
		summarizeBy: none
		sourceColumn: Available Date

		annotation SummarizationSetBy = Automatic

	column 'Delay Buckets Sort' =
			VAR dayslate =
			    DATEDIFF ( SmartRes[TRANSDATE], SmartRes[Available Date], DAY )
			RETURN
			    IF (
			        SmartRes[TRANSDATE] < SmartRes[Available Date],
			        IF (
			            SmartRes[StatusOLD] = "Red",
			            SWITCH (
			                TRUE (),
			                dayslate <= 7, "01",
			                AND ( dayslate > 7, dayslate <= 14 ), "02",
			                AND ( dayslate > 14, dayslate <= 21 ), "03",
			                AND ( dayslate > 21, dayslate <= 28 ), "04",
			                "05"
			            ),
			            "07"
			        ),
			        "06"
			    )
		isHidden
		displayFolder: zz_Misc
		lineageTag: 1400cdc5-9920-412b-a80d-291e81c49293
		summarizeBy: none

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column 'Delay Buckets' =
			VAR dayslate =
			    DATEDIFF ( SmartRes[TRANSDATE], SmartRes[Available Date], DAY )
			RETURN
			    IF (
			        SmartRes[TRANSDATE] < SmartRes[Available Date],
			        IF (
			            SmartRes[StatusOLD] = "Red",
			            SWITCH (
			                TRUE (),
			                dayslate <= 7, "<=7 Days late",
			                AND ( dayslate > 7, dayslate <= 14 ), "8-14 Days late",
			                AND ( dayslate > 14, dayslate <= 21 ), "15-21 Days late",
			                AND ( dayslate > 21, dayslate <= 28 ), "22-28 Days late",
			                AND ( dayslate > 28, dayslate <= 56 ), "29-56 Days (1-2 months) late",
			                AND ( dayslate > 56, dayslate <= 84 ), "57-84 Days (2-3 months) late",
			                AND ( dayslate > 84, dayslate <= 168 ), "85-168 Days (3-6 months) late",
			                "> 168 days (6 months) late"
			            ),
			            BLANK ()
			        ),
			        "Future Trans Date"
			    )
		lineageTag: f565f443-e694-4480-9ce9-49aff22c369e
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

