                "    ,\"RowCount of FixedAssetTransactions diff DEV\",COUNTROWS('Fixed Asset Transactions 3')-COUNTROWS('Fixed Asset Transactions')",
                "    ,\"Count of Date_Key\",DISTINCTCOUNT('Fixed Asset Transactions'[Date_Key])",
                "    ,\"Count of Date_Key diff UAT\",DISTINCTCOUNT('Fixed Asset Transactions 2'[Date_Key])-DISTINCTCOUNT('Fixed Asset Transactions'[Date_Key])",
                "    ,\"Count of Date_Key diff DEV\",DISTINCTCOUNT('Fixed Asset Transactions 3'[Date_Key])-DISTINCTCOUNT('Fixed Asset Transactions'[Date_Key])",
                ")"
              ],
              "type": "calculated"
            }
          }
        ]
      }
    ]
  }
}