    "expressions": [
      {
        "name": "DirectQuery to AS - DMA Fixed Asset",
        "annotations": [
          {
            "name": "PBI_IncludeFutureArtifacts",
            "value": "True"
          }
        ],
        "expression": [
          "let",
          "    Source = AnalysisServices.Database(\"powerbi://api.powerbi.com/v1.0/myorg/Dr.%20Martens%20Datasets\", \"DMA Fixed Asset\"),",
          "    Cubes = Table.Combine(Source[Data]),",
          "    Cube = Cubes{[Id=\"Model\", Kind=\"Cube\"]}[Data]",
          "in",
          "    Cube"
        ],
        "kind": "m",
        "lineageTag": "4567eff2-7999-4d33-8c1f-b82cb00f4456"
      },
      {
