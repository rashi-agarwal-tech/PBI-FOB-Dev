	column 'Day Name' =
			
			SWITCH(
			   weekday(VW_BFN_POWERBI_REFRESH_STATUS[Start Date Local]),
			    1, "Sunday",
			    2, "Monday",
			    3, "Tuesday",
			    4, "Wednesday",
			    5, "Thursday",
			    6, "Friday",
			    7, "Saturday"
			)
