table VW_BFN_POWERBI_REFRESH_STATUS
	lineageTag: 4d5ed83a-46f9-4cf6-b9a2-0b1ea841febe

	measure BG_Colour =
			SWITCH(
			    TRUE(),
			    max(VW_BFN_POWERBI_REFRESH_STATUS[SLA Met])="Yes", "Green",
			    max(VW_BFN_POWERBI_REFRESH_STATUS[SLA Met])="No" && sum(VW_BFN_POWERBI_REFRESH_STATUS[SLA Delta])>0 && sum(VW_BFN_POWERBI_REFRESH_STATUS[SLA Delta])<=60, "Amber",
			    max(VW_BFN_POWERBI_REFRESH_STATUS[SLA Met])="No" && sum(VW_BFN_POWERBI_REFRESH_STATUS[SLA Delta])>60, "Red")
		lineageTag: e6ed37dd-8751-458d-822d-a158fdaad845

	measure OverallStatus =
			SWITCH(
			    TRUE(),
			    SUM(VW_BFN_POWERBI_REFRESH_STATUS[SLA_Binary])=3 , "Green",
			    SUM(VW_BFN_POWERBI_REFRESH_STATUS[SLA_Binary])<3 &&  [FA_SLA_Missed_mins] <=60 && [GL_SLA_Missed_mins]<=60 && [D2C_SLA_Missed_mins]<=60, "Amber",
			    SUM(VW_BFN_POWERBI_REFRESH_STATUS[SLA_Binary])<3 &&  ([FA_SLA_Missed_mins] >60 || [GL_SLA_Missed_mins]>60 || [D2C_SLA_Missed_mins]>60), "Red"
			    )
		lineageTag: 1b7f51e3-a73a-4490-909b-3120710f686d

	measure FA_SLA_Missed_mins = CALCULATE(SUM(VW_BFN_POWERBI_REFRESH_STATUS[SLA Delta]), VW_BFN_POWERBI_REFRESH_STATUS[Model Name]="DMA Fixed Asset")
		lineageTag: b8b5e6c2-43cc-41bd-9866-1339045da20d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure GL_SLA_Missed_mins = CALCULATE(SUM(VW_BFN_POWERBI_REFRESH_STATUS[SLA Delta]), VW_BFN_POWERBI_REFRESH_STATUS[Model Name]="DMA GL")
		lineageTag: 7c441685-7c0d-48e9-a90e-862d28de3aeb

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure D2C_SLA_Missed_mins = CALCULATE(SUM(VW_BFN_POWERBI_REFRESH_STATUS[SLA Delta]), VW_BFN_POWERBI_REFRESH_STATUS[Model Name]="DMA D2C")
		lineageTag: c8b350b8-58b9-4f7d-8d13-4a66f7428ad4

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'SLA Success %' = DIVIDE(sum(VW_BFN_POWERBI_REFRESH_STATUS[SLA_Binary]), count(VW_BFN_POWERBI_REFRESH_STATUS[SLA_Binary]))
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: f3cad48e-469b-4a84-bd1a-a3bd28adcd40

	measure 'SLA Tooltip' = "Total number of successful SLAs/ Total number of model refreshes"
		lineageTag: edee5c4a-cb1d-4dc6-8bc9-827a23af2f80

