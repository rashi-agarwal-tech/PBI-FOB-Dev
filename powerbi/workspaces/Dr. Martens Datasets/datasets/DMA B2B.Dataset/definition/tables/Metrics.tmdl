		annotation PBI_FormatHint = {"isCustom":true}

	measure 'Ordered Units by OE Date LFY' =
			IF (
			    HASONEFILTER ( 'Date'[Fiscal Year] )
			        && HASONEFILTER ( 'Date'[Is Week Filter (544)] ),
			    CALCULATE (
			       [Ordered Units by OE Date],
			        ALL ( 'Date' ),
			        FILTER (
			            ALL ( 'Date' ),
			            'Date'[Financial Year]
			                = VALUES ( 'Date'[Financial Year] ) - 1
			                && CONTAINS (
			                    VALUES ( 'Date' ),
			                    'Date'[Fiscal Period Number], 'Date'[Fiscal Period Number]
			                )
			        )
			    ),
			    CALCULATE (
			      [Total Net Value],
			        FILTER (
			            ALL ( 'Date' ),
			            CONTAINS (
			                VALUES ( 'Date'[ Last Year Date] ),
			                'Date'[ Last Year Date], 'Date'[ Date]
			            )
			        )
			    )
			)
		formatString: #,0
		displayFolder: 01. Ordered\vs.\vs EMEA LFY
		lineageTag: cf8fad90-9cde-4f37-96c2-f8c563d126a6

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'Ordered Net Value by OE Date LFY' = ```
			IF (
			    HASONEFILTER ( 'Date'[Fiscal Year] )
			        && HASONEFILTER ( 'Date'[Is Week Filter (544)] ),
			    CALCULATE (
			         [Ordered Net Value by OE Date], 
			        ALL ( 'Date' ),
			        FILTER (
			            ALL ( 'Date' ),
			            'Date'[Financial Year]
			                = VALUES ( 'Date'[Financial Year] ) - 1
			                && CONTAINS (
			                    VALUES ( 'Date' ),
			                    'Date'[Fiscal Period Number], 'Date'[Fiscal Period Number]
			                )
			        )
			    ),
			    CALCULATE (
			       [Total Net Value],
			        FILTER (
			            ALL ( 'Date' ),
			            CONTAINS (
			                VALUES ( 'Date'[ Last Year Date] ),
			                'Date'[ Last Year Date], 'Date'[ Date]
			            )
			        )
			    )
			)
			```
		formatString: 0.00
		displayFolder: 01. Ordered\vs.\vs EMEA LFY
		lineageTag: 7b6e2215-ac7a-49a1-8537-6e31d14a6b7f

