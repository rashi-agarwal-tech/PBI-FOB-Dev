		annotation PBI_FormatHint = {"isCustom":true}

	measure 'Write-Offs (non-MDF)' =
			VAR Filtered =
			    IF (
			        ISFILTERED ( Orders ) || ISFILTERED ( 'Order Type' )
			            || ISFILTERED ( 'Selling Status - Invoice' )
			            || ISFILTERED ( 'Selling Status - Order Entry' )
			            || ISFILTERED ( 'Product Class' )
			            || ISFILTERED ( Size )
			            || ISFILTERED ( Products )
			            || ISFILTERED ( 'Invoice Number' ),
			        TRUE (),
			        FALSE ()
			    )
			VAR main =
			    SUM ( 'Deductions'[Amount_CONS_GBP] ) * [XR]
			RETURN
			    IF ( main = 0 || Filtered, BLANK (), main )
		formatString: " #,##0.00"
		displayFolder: 11. Others\2. Deductions
