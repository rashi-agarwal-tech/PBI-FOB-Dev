	measure 'Ordered Net Value by OE Date vs LY %' = divide ( ([Ordered Net Value by OE Date] - [Ordered Net Value by OE Date LY])  ,  [Ordered Net Value by OE Date LY])
		formatString: " 0.00%;-0.00%;0.00%"
