		annotation PBI_FormatHint = {"isCustom":true}

	measure 'Orderbook Conversion %' = ```
			Var FNBMonth     = FIRSTDATE('Date'[ Date]) 
			Var LNBMonth     = LASTDATE ('Date'[ Date]) 
			Var OrderedNV    = CALCULATE([Net Value], DATESBETWEEN(Orders[Requested Shipping Date], FNBMonth, LNBMonth ) )
			Var InvoicedNV   = CALCULATE([Net Value], 
			                        DATESBETWEEN(Orders[Requested Shipping Date], FNBMonth, LNBMonth ), 
			                        DATESBETWEEN(Orders[Invoice Date], FNBMonth, LNBMonth ) )
			
			Var Main = divide(InvoicedNV,OrderedNV)
			
			Return
			Main
			```
		formatString: " 0%;-0%;0%"
		displayFolder: 11. Others
		lineageTag: edd39a73-bf57-4b36-8e82-6aa21073e2b8

