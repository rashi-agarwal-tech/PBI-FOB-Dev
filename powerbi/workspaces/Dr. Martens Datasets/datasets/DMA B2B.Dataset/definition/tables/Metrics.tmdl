			            NOT ( Products[Product General] IN { "Marketing", "Materials & Supplies" } )
			        )
			    )
			VAR Units =
			    CALCULATE ( [Total Units], Products[Product General] = "Footwear" )
			RETURN
			    DIVIDE ( NetValue, Units )
