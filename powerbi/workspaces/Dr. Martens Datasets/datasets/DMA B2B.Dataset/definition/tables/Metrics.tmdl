	measure XR = ```
			if(
			    OR(HASONEFILTER('Display Currency'[Currency Name]),HASONEFILTER('Display Currency'[Currency Code])), 
			    if ( FIRSTNONBLANK('Display Currency'[Currency Code],1)="999",
			        1,
			        sum('Display Currency'[XRMultiplier]) ),
			1
