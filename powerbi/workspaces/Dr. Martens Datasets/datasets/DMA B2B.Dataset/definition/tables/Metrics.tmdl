			                All ('Date'),
			                FILTER (
			                  ALL ( 'Date' ),
			                  'Date'[Financial Year] = VALUES ( 'Date'[Financial Year] ) - 1
			                  && CONTAINS(
			                  VALUES ('Date'),
			                    'Date'[Fiscal Period Number],
			                    'Date'[Fiscal Period Number]) 
			        )
