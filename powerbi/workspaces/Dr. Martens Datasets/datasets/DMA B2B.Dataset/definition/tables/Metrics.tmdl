	measure 'Fulfilment Buckets' = ```
			var fbuckets = CALCULATE([% Fulfilment], ALLEXCEPT(Orders, Orders[Sales Order Number]))
			
			return 
			
			IF(fbuckets < 0.25, "1- 00-24% Fulfilment",
			    IF(AND(fbuckets >= 0.25, fbuckets < 0.50), "2- 25-49% Fulfilment",
			        IF(AND(fbuckets >= 0.50, fbuckets < 0.84), "3- 50-84% Fulfilment",
			           IF(AND(fbuckets >= 0.85, fbuckets < 1.00), "4- 85-99% Fulfilment",
			              IF(fbuckets = 1.00, "5- 100% Fulfilment",
			                    IF(fbuckets > 1.00, "Over 100% Fulfilment", "6- No Bucket")
			     ))))       
			)
			```
		isHidden
		lineageTag: b9695bfa-8f05-4d7a-923e-cd5d6b95c362

