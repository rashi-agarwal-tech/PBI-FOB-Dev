	measure 'Pre-Cancel Units' = ```
			var nondd = CALCULATE([Open Units],
			                FILTER('Allocation Details', 'Allocation Details'[Allocation Date] < 'Allocation Details'[SO Cancel Risk Date]), 
			                FILTER('Order Type', 'Order Type'[Order Type ID] <> "DD")
			            )
			var dd = CALCULATE([Open Units], 
			            FILTER(Orders, Orders[DD Pre-Post? ] = "Pre"), 
			            FILTER('Order Type', 'Order Type'[Order Type ID] = "DD") 
			         )
			
			var main = nondd  + dd
			
			return
			IF(main=0, BLANK(), main)
			```
		formatString: " #,0"
		displayFolder: 02. Open\Open Breakdown\US
		lineageTag: add9ad58-1259-439e-bc33-0d9cd93ec405

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'Post-Cancel Units' = ```
			var main = [Open Units] - [Pre-Cancel Units] 
			return
