	column 'SO Days to Despatch' =
			IF(Movements[DespatchedUnits] = Movements[OrderedUnits],
			    DATEDIFF(Movements[SO Entry Date], Movements[SO Despatch Date] ,DAY),
			    BLANK()
			)
		dataType: int64
		formatString: 0
		displayFolder: z Sales Orders
		lineageTag: d6896e15-bf5d-403a-933c-1ab3d9fcef30
		summarizeBy: sum
		isDataTypeInferred

		annotation SummarizationSetBy = Automatic

