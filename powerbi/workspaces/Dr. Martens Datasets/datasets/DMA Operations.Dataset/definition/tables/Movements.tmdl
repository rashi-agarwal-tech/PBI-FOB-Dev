	column 'eCom Despatch Time Band' = ```
			SWITCH(TRUE(),
			    Movements[SO Days to Despatch] = 0, "Same Day",
			    Movements[SO Days to Despatch] = 1, "Next Day",
			    Movements[SO Days to Despatch] = 2, "2 Days", 
			    Movements[SO Days to Despatch] = 3, "3 Days", 
			    Movements[SO Days to Despatch] = 4, "4 Days", 
			    Movements[SO Days to Despatch] = 5, "5 Days", 
			    Movements[SO Days to Despatch] = 6, "6 Days",
			    Movements[SO Days to Despatch] = 7, "7 Days",
			    Movements[SO Days to Despatch] = 8, "8 Days",
			    Movements[SO Days to Despatch] = 9, "9 Days", 
			    Movements[SO Days to Despatch] = 10, "10 Days",
			    Movements[SO Days to Despatch] = 11, "11 Days", 
			    Movements[SO Days to Despatch] = 12, "12 Days", 
			    "12+ Days"
			)
			```
