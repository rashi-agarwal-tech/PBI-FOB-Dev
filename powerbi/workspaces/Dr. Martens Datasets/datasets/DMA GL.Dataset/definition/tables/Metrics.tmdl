		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Amount (Actual) LFY' =
			
			IF (
			    HASONEFILTER ( 'Date'[Fiscal Year] )
			        && HASONEFILTER ( 'Date'[Is Week Filter (544)] ),
			    CALCULATE (
			    [Amount (Actual)],
			        ALL ( 'Date' ),
			        FILTER (
			            ALL ( 'Date' ),
			            'Date'[Financial Year]
			                = VALUES ( 'Date'[Financial Year] ) - 1
			                && CONTAINS (
			                    VALUES ( 'Date' ),
			                    'Date'[Fiscal Period Number], 'Date'[Fiscal Period Number]
			                )
			        )
			    ),
			    CALCULATE (
			     [Amount (Actual)],
			        FILTER (
			            ALL ( 'Date' ),
			            CONTAINS (
			                VALUES ( 'Date'[Last Year Date] ),
			                'Date'[Last Year Date], 'Date'[Date]
			            )
			        )
			    )
			)
		displayFolder: 1. GL Measures\vs.\vs EMEA LFY
		lineageTag: c6f8e761-ef7e-45d4-afee-6a9bda66117d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

