model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-GB
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["DEV","UAT","PROD","RefreshDateTime"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBIDesktopVersion = 2.141.1558.0 (25.03)+75b5f06a991f8f8a8a4d6b6fcd0f66e1ec2d6fdc

ref table PROD
ref table RefreshDateTime
ref table Summary
ref table DEV
ref table UAT

ref role 'Global Users'
ref role 'NA Users'
ref role 'EMEA Users'
ref role 'HK Users'
ref role 'HK Users - Global'
ref role 'JP Users'
ref role 'JP Users - Global'
ref role 'AsiaPac Users'

ref cultureInfo en-US

