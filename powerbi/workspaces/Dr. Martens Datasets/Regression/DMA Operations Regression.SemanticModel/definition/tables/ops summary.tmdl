	partition 'ops summary' = calculated
		mode: import
		source =
				
				SUMMARIZE
				(
				    ops
				    ,"RowCount of Movements",COUNTROWS('Movements')
				    ,"RowCount of Movements diff UAT",COUNTROWS('Movements 2')-COUNTROWS('Movements')
				    ,"RowCount of Movements diff DEV",COUNTROWS('Movements 3')-COUNTROWS('Movements')
				    ,"RowCount of Availability Today",CALCULATE(COUNTROWS('Availability'),'Date'[- Is Today?]="Yes")
				    ,"RowCount of Availability Today diff UAT",CALCULATE(COUNTROWS('Availability 2'),'Date 2'[- Is Today?]="Yes")-CALCULATE(COUNTROWS('Availability'),'Date'[- Is Today?]="Yes")
				    ,"RowCount of Availability Today diff DEV",CALCULATE(COUNTROWS('Availability 3'),'Date 3'[- Is Today?]="Yes")-CALCULATE(COUNTROWS('Availability'),'Date'[- Is Today?]="Yes")
				    ,"Count of Availability Date (exc. weekends)",CALCULATE(DISTINCTCOUNT('Availability'[DATE]),'Date'[- Is Weekend?]="Weekday")
				    ,"Count of Availability Date (exc. weekends) diff UAT",CALCULATE(DISTINCTCOUNT('Availability 2'[DATE]),'Date 2'[- Is Weekend?]="Weekday")-CALCULATE(DISTINCTCOUNT('Availability'[DATE]),'Date'[- Is Weekend?]="Weekday")
				    ,"Count of Availability Date (exc. weekends) diff DEV",CALCULATE(DISTINCTCOUNT('Availability 3'[DATE]),'Date 3'[- Is Weekend?]="Weekday")-CALCULATE(DISTINCTCOUNT('Availability'[DATE]),'Date'[- Is Weekend?]="Weekday")
				    ,"RowCount of Allocation Details",COUNTROWS('Allocation Details')
				    ,"RowCount of Allocation Details diff UAT",COUNTROWS('Allocation Details 2')-COUNTROWS('Allocation Details')
				    ,"RowCount of Allocation Details diff DEV",COUNTROWS('Allocation Details 3')-COUNTROWS('Allocation Details')
				    ,"RowCount of Intake Today",CALCULATE(COUNTROWS('Intake'),'Date'[- Is Today?]="Yes")
				    ,"RowCount of Intake Today diff UAT",CALCULATE(COUNTROWS('Intake 2'),'Date 2'[- Is Today?]="Yes")-CALCULATE(COUNTROWS('Intake'),'Date'[- Is Today?]="Yes")
				    ,"RowCount of Intake Today diff DEV",CALCULATE(COUNTROWS('Intake 3'),'Date 3'[- Is Today?]="Yes")-CALCULATE(COUNTROWS('Intake'),'Date'[- Is Today?]="Yes")
				    ,"Count of Intake Date_Key (exc. weekends)",CALCULATE(DISTINCTCOUNT('Intake'[Date_Key]),'Date'[- Is Weekend?]="Weekday")
				    ,"Count of Intake Date_Key (exc. weekends) diff UAT",CALCULATE(DISTINCTCOUNT('Intake 2'[Date_Key]),'Date 2'[- Is Weekend?]="Weekday")-CALCULATE(DISTINCTCOUNT('Intake'[Date_Key]),'Date'[- Is Weekend?]="Weekday")
				    ,"Count of Intake Date_Key (exc. weekends) diff DEV",CALCULATE(DISTINCTCOUNT('Intake 3'[Date_Key]),'Date 3'[- Is Weekend?]="Weekday")-CALCULATE(DISTINCTCOUNT('Intake'[Date_Key]),'Date'[- Is Weekend?]="Weekday")
				)

	annotation PBI_Id = 00745480cc0b42ab921be4d425457988

