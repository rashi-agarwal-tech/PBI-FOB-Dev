expression 'DirectQuery to AS - DMA Sourcing' =
		let
		    Source = AnalysisServices.Database("powerbi://api.powerbi.com/v1.0/myorg/Dr.%20Martens%20Datasets", "DMA Sourcing"),
		    Cubes = Table.Combine(Source[Data]),
		    Cube = Cubes{[Id="Model", Kind="Cube"]}[Data]
		in
		    Cube
	lineageTag: 5ecd2123-1f87-436b-a270-288afb40e4a9

	annotation PBI_IncludeFutureArtifacts = True

