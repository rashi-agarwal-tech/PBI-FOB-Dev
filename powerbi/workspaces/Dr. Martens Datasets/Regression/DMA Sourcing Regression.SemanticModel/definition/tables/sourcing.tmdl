	partition sourcing = calculated
		mode: import
		source =
				
				UNION
				(
				    //date
				    SUMMARIZECOLUMNS
				    (
				        'Invoice Date'[Fiscal Year]
				        ,'Invoice Date'[Fiscal Year-Period]
				        ,'Invoice Date'[Invoice Date]
				        ,"Attribute",""
				        ,"Dimension","Date"
				        ,"Source","1 Footprint PROD"
				        ,"01. Ordered Units",[01. Ordered Units]
				        ,"01. Ordered Value",ROUND([01. Ordered Value],2)
				        ,"02. Approved Units",[02. Approved Units]
				        ,"02. Approved Value",ROUND([02. Approved Value],2)
				        ,"03. Confirmed Units",[03. Confirmed Units]
				        ,"03. Confirmed Value",ROUND([03. Confirmed Value],2)
				        ,"04. Unconfirmed Units",[04. Unconfirmed Units]
				        ,"04. Unconfirmed Value",ROUND([04. Unconfirmed Value],2)
				        ,"05. Placed to Factory Units",[05. Placed to Factory Units]
				        ,"05. Placed to Factory Value",ROUND([05. Placed to Factory Value],2)
				        ,"06. Rejected Units",[06. Rejected Units]
				        ,"06. Rejected Value",ROUND([06. Rejected Value],2)
				        ,"07. To Be Shipped Units",[07. To Be Shipped Units]
				        ,"07. To Be Shipped Value",ROUND([07. To Be Shipped Value],2)
				        ,"08. Shipped Units",[08. Shipped Units]
				        ,"08. Shipped Value",ROUND([08. Shipped Value],2)
				        ,"09. Received Units",[09. Received Units]
				        ,"09. Received Value",ROUND([09. Received Value],2)
				        ,"10. Invoiced Units",[10. Invoiced Units]
				        ,"10. Invoiced Value",ROUND([10. Invoiced Value],2)
				        ,"11. Duty",ROUND([11. Duty],2)
				        ,"Gross Weight",ROUND([Gross Weight],2)
				        ,"Total Capacity",[Total Capacity]
				        ,"Total Cube",ROUND([Total Cube],2)
				        ,"Welted Capacity",[Welted Capacity]
				        ,"# Booked on time (%)",ROUND([# Booked on time (%)],4)
				        ,"# Booked on time (units)",[# Booked on time (units)]
				        ,"# Ordered Units (Available)",[# Ordered Units (Available)]
				        ,"# Ordered Units (Backlog Available)",[# Ordered Units (Backlog Available)]
				        ,"# Ordered Units (Backlog)",[# Ordered Units (Backlog)]
				        ,"# Ordered Units (Delayed)",[# Ordered Units (Delayed)]
				        ,"# Ordered Units (Non-Prebuy)",[# Ordered Units (Non-Prebuy)]
				        ,"# Ordered Units (On Time)",[# Ordered Units (On Time)]
				        ,"# Ordered Units (Past dues)",[# Ordered Units (Past dues)]
				        ,"# Ordered Units (Prebuy)",[# Ordered Units (Prebuy)]
				        ,"# Ordered Units (Shipped)",[# Ordered Units (Shipped)]
				        ,"# Ordered Units (To be Shipped)",[# Ordered Units (To be Shipped) ]
				        ,"# OT Ackno (%)",ROUND([# OT Ackno (%)],4)
				        ,"# OT Ackno (units)",[# OT Ackno (units)]
				        ,"# OT Availability (%)",ROUND([# OT Availability (%)],4)
				        ,"# OT Availability (units)",[# OT Availability (units)]
				        ,"# OT Confirmed (%)",ROUND([# OT Confirmed (%)],4)
				        ,"# OT Confirmed (units)",[# OT Confirmed (units)]
				        ,"# OT Placement: (Subm vs Approved) (%)",ROUND([# OT Placement: (Subm vs Approved) (%)],4)
				        ,"# OT Placement: (Subm vs Approved) (units)",[# OT Placement: (Subm vs Approved) (units)]
				        ,"# OT Supplier (%)",ROUND([# OT Supplier (%)],4)
				        ,"# OT Supplier (units)",[# OT Supplier (units)]
				        ,"# Packed Quantity",[# Packed Quantity]
				        ,"# POs",[# POs]
				        ,"# POs (Non-Prebuy)",[# POs (Non-Prebuy)]
				        ,"# POs (Prebuy)",[# POs (Prebuy)]
				        ,"# Shipped Units (Non-Prebuy)",[# Shipped Units (Non-Prebuy)]
				        ,"# Shipped Units (Prebuy)",[# Shipped Units (Prebuy)]
				        ,"# To be Shipped Units (Non-Prebuy)",[# To be Shipped Units (Non-Prebuy)]
				        ,"# To be Shipped Units (Prebuy)",[# To be Shipped Units (Prebuy)]
				    )
				    ,SUMMARIZECOLUMNS
				    (
				        'Invoice Date 2'[Fiscal Year]
				        ,'Invoice Date 2'[Fiscal Year-Period]
				        ,'Invoice Date 2'[Invoice Date]
				        ,"Attribute",""
				        ,"Dimension","Date"
				        ,"Source","2 Footprint UAT"
				        ,"01. Ordered Units",[01. Ordered Units 2]
				        ,"01. Ordered Value",ROUND([01. Ordered Value 2],2)
				        ,"02. Approved Units",[02. Approved Units 2]
				        ,"02. Approved Value",ROUND([02. Approved Value 2],2)
				        ,"03. Confirmed Units",[03. Confirmed Units 2]
				        ,"03. Confirmed Value",ROUND([03. Confirmed Value 2],2)
				        ,"04. Unconfirmed Units",[04. Unconfirmed Units 2]
				        ,"04. Unconfirmed Value",ROUND([04. Unconfirmed Value 2],2)
				        ,"05. Placed to Factory Units",[05. Placed to Factory Units 2]
				        ,"05. Placed to Factory Value",ROUND([05. Placed to Factory Value 2],2)
