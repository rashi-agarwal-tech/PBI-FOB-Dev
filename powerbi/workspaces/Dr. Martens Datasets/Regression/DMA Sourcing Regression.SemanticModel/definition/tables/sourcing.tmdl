	column 'Max. Net Weight' =
			
			IF(sourcing[Source]="1 Footprint PROD" && sourcing[Dimension]="Date" && sourcing[Invoice Date]=TODAY(),[Max. Net Weight]
			,IF(sourcing[Source]="2 Footprint UAT" && sourcing[Dimension]="Date" && sourcing[Invoice Date]=TODAY(),[Max. Net Weight 2]
			,IF(sourcing[Source]="3 Footprint DEV" && sourcing[Dimension]="Date" && sourcing[Invoice Date]=TODAY(),[Max. Net Weight 3])))
		lineageTag: 2507df01-6987-4ffa-a2bd-98dc7764d54c
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column 'Max. Pack Weight' =
			
