			,IF(sourcing[Source]="2 Footprint UAT" && sourcing[Dimension]="Date" && sourcing[Invoice Date]=TODAY(),[Max. Pack Weight 2]
			,IF(sourcing[Source]="3 Footprint DEV" && sourcing[Dimension]="Date" && sourcing[Invoice Date]=TODAY(),[Max. Pack Weight 3])))
