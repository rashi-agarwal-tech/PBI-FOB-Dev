				        ,"09. Received Units",[09. Received Units 2]
				        ,"09. Received Value",ROUND([09. Received Value 2],2)
				        ,"10. Invoiced Units",[10. Invoiced Units 2]
				        ,"10. Invoiced Value",ROUND([10. Invoiced Value 2],2)
				        ,"11. Duty",ROUND([11. Duty 2],2)
				        ,"Gross Weight",ROUND([Gross Weight 2],2)
				        ,"Total Capacity",[Total Capacity 2]
				        ,"Total Cube",ROUND([Total Cube 2],2)
				        ,"Welted Capacity",[Welted Capacity 2]
				        ,"# Booked on time (%)",ROUND([# Booked on time (%) 2],4)
