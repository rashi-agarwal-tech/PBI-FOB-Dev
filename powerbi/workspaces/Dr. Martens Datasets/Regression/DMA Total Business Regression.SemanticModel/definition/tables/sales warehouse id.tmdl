	partition 'sales warehouse id' = calculated
		mode: import
		source =
				
				UNION
				(
				    //Warehouse ID
				    SUMMARIZECOLUMNS
				    (
				        'Warehouse'[Warehouse ID]
				        ,"Fiscal Year (544)",""
				        ,"Fiscal Year-Period (544)",""
				        ," Date",BLANK()
				        ,"Dimension","Warehouse ID"
				        ,"Source","1 Footprint PROD"
				        ,"Open Units",[Open Units]
				        ,"Invoiced Units",[Invoiced Units]
				        ,"Returned Units",[Returned Units]
				        ,"Total Units",[Total Units]
				        ,"Net Units",[Net Units]
				        ,"Open Net Value",ROUND([Open Net Value],2)
				        ,"Invoiced Net Value",ROUND([Invoiced Net Value],2)
				        ,"Returned Net Value",ROUND([Returned Net Value],2)
				        ,"Total Net Value",ROUND([Total Net Value],2)
				        ,"Net Value",ROUND([Net Value],2)
				        ,"Ordered Units",[Ordered Units]
				        ,"Ordered Net Value",ROUND([Ordered Net Value],2)
				    )
				    ,SUMMARIZECOLUMNS
				    (
				        'Warehouse 2'[Warehouse ID]
				        ,"Fiscal Year (544)",""
				        ,"Fiscal Year-Period (544)",""
				        ," Date",BLANK()
				        ,"Dimension","Warehouse ID"
				        ,"Source","2 Footprint UAT"
				        ,"Open Units",[Open Units 2]
				        ,"Invoiced Units",[Invoiced Units 2]
				        ,"Returned Units",[Returned Units 2]
				        ,"Total Units",[Total Units 2]
				        ,"Net Units",[Net Units 2]
				        ,"Open Net Value",ROUND([Open Net Value 2],2)
				        ,"Invoiced Net Value",ROUND([Invoiced Net Value 2],2)
				        ,"Returned Net Value",ROUND([Returned Net Value 2],2)
				        ,"Total Net Value",ROUND([Total Net Value 2],2)
				        ,"Net Value",ROUND([Net Value 2],2)
				        ,"Ordered Units",[Ordered Units 2]
				        ,"Ordered Net Value",ROUND([Ordered Net Value 2],2)
				    ),
				    SUMMARIZECOLUMNS
				    (
				        'Warehouse 3'[Warehouse ID]
				        ,"Fiscal Year (544)",""
				        ,"Fiscal Year-Period (544)",""
				        ," Date",BLANK()
				        ,"Dimension","Warehouse ID"
				        ,"Source","3 Footprint DEV"
				        ,"Open Units",[Open Units 3]
				        ,"Invoiced Units",[Invoiced Units 3]
				        ,"Returned Units",[Returned Units 3]
				        ,"Total Units",[Total Units 3]
				        ,"Net Units",[Net Units 3]
				        ,"Open Net Value",ROUND([Open Net Value 3],2)
				        ,"Invoiced Net Value",ROUND([Invoiced Net Value 3],2)
				        ,"Returned Net Value",ROUND([Returned Net Value 3],2)
				        ,"Total Net Value",ROUND([Total Net Value 3],2)
				        ,"Net Value",ROUND([Net Value 3],2)
				        ,"Ordered Units",[Ordered Units 3]
				        ,"Ordered Net Value",ROUND([Ordered Net Value 3],2)
				    )
				)

	annotation PBI_Id = 0b509e3526b44a6191aa4f47a03200b0

