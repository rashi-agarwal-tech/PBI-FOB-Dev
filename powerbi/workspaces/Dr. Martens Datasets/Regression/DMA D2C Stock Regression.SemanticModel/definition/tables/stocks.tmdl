	measure 'stocks Sum of AbsDiff %' =
			
			DIVIDE
			(
			    [stocks 1. All On Hand Stock Units Diff %]
			    +[stocks 2. WH Stock Units Diff %]
			    +[stocks 4. Store In-Transit Units Diff %]
			    +[stocks 5. Store Stock Units Diff %]
			    +[stocks Item Coverage Diff %]
			    +[stocks On Hand Spot Cover Diff %]
			    +[stocks Stock Outs % Diff %]
			    +[stocks Store Spot Cover Diff %]
			    +[stocks WH Spot Cover Diff %]
			    +[stocks 2.2 Available WH Stock Units Diff %]
			    +[stocks 3.1 Allocated Units Arrived Diff %]
			    +[stocks 4. Reserved Intake Units Diff %]
			    +[stocks Ranged Stores Diff %]
			    ,13
			)
		formatString: 0.0%;-0.0%;0.0%
