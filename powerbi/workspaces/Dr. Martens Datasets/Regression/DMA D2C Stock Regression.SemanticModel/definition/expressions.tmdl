expression 'DirectQuery to AS - DMA D2C' =
		let
		    Source = AnalysisServices.Database("powerbi://api.powerbi.com/v1.0/myorg/Dr.%20Martens%20Datasets", "DMA D2C"),
		    Cubes = Table.Combine(Source[Data]),
		    Cube = Cubes{[Id="Model", Kind="Cube"]}[Data]
		in
		    Cube
	lineageTag: d2154f80-4b97-4302-b5a0-d58f11ab07c2

	annotation PBI_IncludeFutureArtifacts = True

