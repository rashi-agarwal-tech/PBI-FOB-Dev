          {
            "name": "RowCount of SmartRes diff UAT",
            "changedProperties": [
              {
                "property": "Name"
              },
              {
                "property": "FormatString"
              }
            ],
            "expression": [
              "",
              "COUNTROWS('SmartRes 2') - [RowCount of SmartRes]"
            ],
            "formatString": "#,0",
            "lineageTag": "eabcd1e2-b6d4-4036-b807-05eff7a2d992"
          },
          {
            "name": "RowCount of Availability Today diff UAT",
            "changedProperties": [
              {
                "property": "Name"
              },
              {
                "property": "FormatString"
              }
            ],
            "expression": [
              "",
              "CALCULATE",
              "(",
              "    COUNTROWS('Availability 2')",
              "    ,'Date 2'[- Is Today?]=\"Yes\"",
              ") - [RowCount of Availability Today]"
            ],
            "formatString": "#,0",
            "lineageTag": "2c839971-6805-4659-a54c-9e06e5bef597"
          },
          {
            "name": "Count of Date (exc. weekends) diff UAT",
            "changedProperties": [
              {
                "property": "Name"
              },
              {
                "property": "FormatString"
              }
            ],
            "expression": [
              "",
              "CALCULATE",
              "(",
              "    DISTINCTCOUNT('Availability 2'[DATE])",
              "    ,'Date 2'[- Is Weekend?]=\"Weekday\"",
              ") - [Count of Date (exc. weekends)]"
            ],
            "formatString": "#,0",
            "lineageTag": "31f6f57b-e877-4ea7-b97f-8235c64cb533"
          }
        ],
