          {
            "name": "RowCount of SmartRes diff DEV",
            "changedProperties": [
              {
                "property": "Name"
              },
              {
                "property": "FormatString"
              }
            ],
            "expression": [
              "",
              "COUNTROWS('SmartRes 3') - [RowCount of SmartRes]"
            ],
            "formatString": "#,0",
            "lineageTag": "bc7f6329-3713-44c8-9e79-d41c137a3e89"
          },
          {
            "name": "RowCount of Availability Today diff DEV",
            "changedProperties": [
              {
                "property": "Name"
              },
              {
                "property": "FormatString"
              }
            ],
            "expression": [
              "",
              "CALCULATE",
              "(",
              "    COUNTROWS('Availability 3')",
              "    ,'Date 3'[- Is Today?]=\"Yes\"",
              ") - [RowCount of Availability Today]"
            ],
            "formatString": "#,0",
            "lineageTag": "3f15d5f8-b9ce-44b3-9366-eb965df783ae"
          },
          {
            "name": "Count of Date (exc. weekends) diff DEV",
            "changedProperties": [
              {
                "property": "Name"
              },
              {
                "property": "FormatString"
              }
            ],
            "expression": [
              "",
              "CALCULATE",
              "(",
              "    DISTINCTCOUNT('Availability 3'[DATE])",
              "    ,'Date 3'[- Is Weekend?]=\"Weekday\"",
              ") - [Count of Date (exc. weekends)]"
            ],
            "formatString": "#,0",
            "lineageTag": "f343674c-55ce-4ec4-af82-e14c131c0a7d"
          }
        ],
