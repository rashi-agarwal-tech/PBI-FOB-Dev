            ],
            "formatString": "#,0",
            "lineageTag": "d507b9c1-222a-485c-8347-e5f5361353e4"
          },
          {
            "name": "RowCount of Availability Today",
            "changedProperties": [
              {
                "property": "Name"
              },
              {
                "property": "FormatString"
              }
            ],
            "expression": [
              "",
              "CALCULATE",
              "(",
              "    COUNTROWS(Availability)",
              "    ,'Date'[- Is Today?]=\"Yes\"",
              ")"
            ],
            "formatString": "#,0",
            "lineageTag": "88b4822f-d3ab-452f-90a3-132ca052b286"
          },
          {
            "name": "Count of Date (exc. weekends)",
            "changedProperties": [
              {
                "property": "Name"
              },
              {
                "property": "FormatString"
              }
            ],
            "expression": [
              "",
              "CALCULATE",
              "(",
              "    DISTINCTCOUNT('Availability'[DATE])",
              "    ,'Date'[- Is Weekend?]=\"Weekday\"",
              ")"
            ],
            "formatString": "#,0",
            "lineageTag": "c2dc2990-6ce7-487d-8520-4d1c2e91f473"
          }
