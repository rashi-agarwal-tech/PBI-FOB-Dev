	column 'Warehouse Group' = LOOKUPVALUE ( Warehouse[Warehouse Group], Warehouse[Warehouse ID], 'Open eCom Return Info'[Warehouse] )
		dataType: string
		lineageTag: 4f30178c-c5c2-4b75-8e03-4b84ba01594a
		summarizeBy: none
		isDataTypeInferred

		annotation SummarizationSetBy = Automatic

	column 'Days to Process' =
			SWITCH (
			    TRUE (),
			    'Open eCom Return Info'[Returned Status] = "Complete",
			        DATEDIFF (
			            'Open eCom Return Info'[Actual Receipt Date],
			            'Open eCom Return Info'[Processed Date],
			            DAY
			        ),
			    'Open eCom Return Info'[Returned Status] = "Received",
			        DATEDIFF (
			            'Open eCom Return Info'[Actual Receipt Date],
			            TODAY (),
			            DAY
			        ),
			    BLANK ()
			)
		dataType: int64
		formatString: #,##0
		lineageTag: 5242413b-56f8-4a75-af6b-fe7870e0d2c0
		summarizeBy: none
		isDataTypeInferred

		annotation SummarizationSetBy = User

		annotation PBI_FormatHint = {"isCustom":true}

	column 'Days to Process Grouping' =
			VAR a = 'Open eCom Return Info'[Days to Process]
			RETURN
			    SWITCH (
			        TRUE,
			        ISBLANK ( a ), "No Receipt Date",
			        a <= 0, "0 Weeks",
			        a <= 7, "0-1 Week",
			        a <= 14, "1-2 Weeks",
			        a <= 21, "2-3 Weeks",
			        a <= 28, "3-4 Weeks",
			        a <= 35, "4-5 Weeks",
			        "5+ Weeks"
			    )
		dataType: string
		lineageTag: 4865db5c-e1ca-437d-b09b-58dcf45dd716
		summarizeBy: none
		isDataTypeInferred

		annotation SummarizationSetBy = Automatic

