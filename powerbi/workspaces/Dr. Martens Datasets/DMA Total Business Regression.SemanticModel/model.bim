        "lineageTag": "864c0f53-570d-4313-8310-50239fe4bf48",
        "partitions": [
          {
            "name": "sales summary",
            "mode": "import",
            "source": {
              "expression": [
                "",
                "SUMMARIZE",
                "(",
                "    Metrics",
                "    ,\"RowCount of Orders\",COUNTROWS('Orders')",
                "    ,\"RowCount of Orders diff UAT\",COUNTROWS('Orders 2')-COUNTROWS('Orders')",
                "    ,\"RowCount of Orders diff DEV\",COUNTROWS('Orders 3')-COUNTROWS('Orders')",
                "    ,\"Count of SalesOrderNumber\",DISTINCTCOUNT('Orders'[Sales Order Number])",
                "    ,\"Count of SalesOrderNumber diff UAT\",DISTINCTCOUNT('Orders 2'[Sales Order Number])-DISTINCTCOUNT('Orders'[Sales Order Number])",
                "    ,\"Count of SalesOrderNumber diff DEV\",DISTINCTCOUNT('Orders 3'[Sales Order Number])-DISTINCTCOUNT('Orders'[Sales Order Number])",
                ")"
              ],
              "type": "calculated"
            }
          }
        ]
      }
    ]
  }
}