	measure 'sales Sum of AbsDiff' =
			
			[sales open units Diff]
			+[sales open net value Diff]
			+[sales invoiced units Diff]
			+[sales invoiced net value Diff]
			+[sales returned units Diff]
			+[sales returned net value Diff]
			+[sales total units Diff]
			+[sales total net value Diff]
			+[sales net units Diff]
			+[sales net value Diff]
			+[sales ordered units Diff]
			+[sales ordered net value Diff]
		formatString: #,0.00
		lineageTag: 8b855803-9206-471f-96c9-2f3272fc252e

