expression 'DirectQuery to AS - DMA Operations' =
		let
		    Source = AnalysisServices.Database("powerbi://api.powerbi.com/v1.0/myorg/Dr.%20Martens%20Datasets", "DMA Operations"),
		    Cubes = Table.Combine(Source[Data]),
		    Cube = Cubes{[Id="Model", Kind="Cube"]}[Data]
		in
		    Cube
	lineageTag: b19d3919-77cb-48d0-aaa1-d85c9d548e18

	annotation PBI_IncludeFutureArtifacts = True

