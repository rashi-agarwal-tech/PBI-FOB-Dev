                "        ,\"0. Open Return Units\",[0. Open Return Units 2]",
                "        ,\"0. Open Return Amount\",ROUND([0. Open Return Amount 2],2)",
                "        ,\"0. Ordered Units\",[0. Ordered Units 2]",
                "        ,\"0. Ordered Amount\",ROUND([0. Ordered Amount 2],2)",
                "        ,\"1. Complete Return Units\",[1. Complete Return Units 2]",
                "        ,\"1. Complete Return Amount\",ROUND([1. Complete Return Amount 2],2)",
                "        ,\"1. Open Units\",[1. Open Units 2]",
                "        ,\"1. Open Amount\",ROUND([1. Open Amount 2],2)",
                "        ,\"1. Received Intake Units\",[1. Received Intake Units 2]",
                "        ,\"1. Received Intake Amount\",ROUND([1. Received Intake Amount 2],2)",
                "        ,\"2. Outstanding Units\",[2. Outstanding Units 2]",
