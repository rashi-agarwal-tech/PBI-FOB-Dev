        "partitions": [
          {
            "name": "ops",
            "mode": "import",
            "source": {
              "expression": [
                "",
                "UNION",
                "(",
                "    //date",
                "    SUMMARIZECOLUMNS",
                "    (",
                "        'Date'[Fiscal Year (544)]",
                "        ,'Date'[Fiscal Year-Period (544)]",
                "        ,'Date'[ Date]",
                "        ,\"Attribute\",\"\"",
                "        ,\"Dimension\",\"Date\"",
                "        ,\"Source\",\"1 Footprint PROD\"",
                "        ,\"0. Open Intake Units\",[0. Open Intake Units]",
                "        ,\"0. Open Intake Amount\",ROUND([0. Open Intake Amount],2)",
                "        ,\"0. Open Return Units\",[0. Open Return Units]",
                "        ,\"0. Open Return Amount\",ROUND([0. Open Return Amount],2)",
                "        ,\"0. Ordered Units\",[0. Ordered Units]",
                "        ,\"0. Ordered Amount\",ROUND([0. Ordered Amount],2)",
                "        ,\"1. Complete Return Units\",[1. Complete Return Units]",
                "        ,\"1. Complete Return Amount\",ROUND([1. Complete Return Amount],2)",
                "        ,\"1. Open Units\",[1. Open Units]",
                "        ,\"1. Open Amount\",ROUND([1. Open Amount],2)",
                "        ,\"1. Received Intake Units\",[1. Received Intake Units]",
                "        ,\"1. Received Intake Amount\",ROUND([1. Received Intake Amount],2)",
                "        ,\"2. Outstanding Units\",[2. Outstanding Units]",
                "        ,\"2. Outstanding Amount\",ROUND([2. Outstanding Amount],2)",
                "        ,\"2. Cancelled Intake Units\",[2. Cancelled Intake Units]",
                "        ,\"2. Cancelled Intake Amount\",ROUND([2. Cancelled Intake Amount],2)",
                "        ,\"3. Allocated Units\",[3. Allocated Units]",
                "        ,\"3. Allocated Amount\",ROUND([3. Allocated Amount],2)",
                "        ,\"3. Ordered Intake Units\",[3. Ordered Intake Units]",
                "        ,\"3. Ordered Intake Amount\",ROUND([3. Ordered Intake Amount],2)",
                "        ,\"3.1 Allocated Arrived Units\",[3.1 Allocated Arrived Units]",
                "        ,\"3.1 Allocated Arrived Amount\",ROUND([3.1 Allocated Arrived Amount],2)",
                "        ,\"3.2 Allocated On Time Units\",[3.2 Allocated On Time Units]",
                "        ,\"3.2 Allocated On Time Amount\",ROUND([3.2 Allocated On Time Amount],2)",
                "        ,\"3.3 Allocated Late Units\",[3.3 Allocated Late Units]",
                "        ,\"3.3 Allocated Late Amount\",ROUND([3.3 Allocated Late Amount],2)",
                "        ,\"3.4 Allocated Outside Of Time Fence Units\",[3.4 Allocated Outside Of Time Fence Units]",
                "        ,\"3.4 Allocated Outside Of Time Fence Amount\",ROUND([3.4 Allocated Outside Of Time Fence Amount],2)",
                "        ,\"3.5 Allocated Detail Units\",[3.5 Allocated Detail Units]",
                "        ,\"4. Reserved Units\",[4. Reserved Units]",
                "        ,\"4. Reserved Amount\",ROUND([4. Reserved Amount],2)",
                "        ,\"5. In Pick Units\",[5. In Pick Units]",
                "        ,\"5. In Pick Amount\",ROUND([5. In Pick Amount],2)",
                "        ,\"5.1 Pick Active Units\",[5.1 Pick Active Units]",
                "        ,\"5.1 Pick Active Amount\",ROUND([5.1 Pick Active Amount],2)",
                "        ,\"5.2 Pick Release Units\",[5.2 Pick Release Units]",
                "        ,\"5.2 Pick Release Amount\",ROUND([5.2 Pick Release Amount],2)",
                "        ,\"5.3 Pick Complete Units\",[5.3 Pick Complete Units]",
                "        ,\"5.3 Pick Complete Amount\",ROUND([5.3 Pick Complete Amount],2)",
                "        ,\"6. Despatched Units\",[6. Despatched Units]",
                "        ,\"6. Despatched Amount\",ROUND([6. Despatched Amount],2)",
                "        ,\"7. Despatched not Received Units\",[7. Despatched not Received Units]",
                "        ,\"7. Despatched not Received Amount\",ROUND([7. Despatched not Received Amount],2)",
                "        ,\"8. Received Units\",[8. Received Units]",
                "        ,\"8. Received Amount\",ROUND([8. Received Amount],2)",
                "        ,\"9. Cancelled Units\",[9. Cancelled Units]",
                "        ,\"9. Cancelled Amount\",ROUND([9. Cancelled Amount],2)",
                "        ,\"0. On Hand Stock Units\",CALCULATE([0. On Hand Stock Units],'Date'[- Is Today?]=\"Yes\")",
                "        ,\"0. On Hand Stock Value\",CALCULATE(ROUND([0. On Hand Stock Value],2),'Date'[- Is Today?]=\"Yes\")",
                "        ,\"1. On Hand Available Units\",CALCULATE([1. On Hand Available Units],'Date'[- Is Today?]=\"Yes\")",
                "        ,\"Unit Cost\",CALCULATE(ROUND([Unit Cost],2),'Date'[- Is Today?]=\"Yes\")",
                "        ,\"2. Intake Available Units\",CALCULATE([2. Intake Available Units],'Date'[- Is Today?]=\"Yes\")",
                "        ,\"3. Intake Ordered Available Units\",CALCULATE([3. Intake Ordered Available Units],'Date'[- Is Today?]=\"Yes\")",
                "    )",
                "    ,SUMMARIZECOLUMNS",
                "    (",
                "        'Date 2'[Fiscal Year (544)]",
                "        ,'Date 2'[Fiscal Year-Period (544)]",
