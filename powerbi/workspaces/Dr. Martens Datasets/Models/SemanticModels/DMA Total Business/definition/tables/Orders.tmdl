	column 'Hold Code' = RELATED('Hold Code Trans'[HOLDCODEDESCRIPTION])
		lineageTag: 98bb0a26-f687-41c8-9bcf-4ac1e5008161
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Period Orderbook Availability' =
			var Feat = SWITCH(Orders[Period Orderbook Status],"Period Available","feature","Pull Forward","feature","Roll-Out","feature","Cancel Risk","feature","On Hold","feature","other")
			var lfdavail = Orders[Fill Date - Order] - WEEKDAY(Orders[Fill Date - Order],2) +1
			var OpenQty = Orders[Open Units Col]*0.95
			var pickc = Orders[Pick Comp Units Col]
			var picka = Orders[Pick Act Units Col]
			var res = Orders[Res Units Col]
			var availdate = "Available w/c "&FORMAT(lfdavail,"m/d")
			
			return
			if(Feat="Feature",
			if(pickc>OpenQty,"...Pick Completed",
			if((picka+pickc)>OpenQty,"..Pick Activated",
			 if(res>OpenQty,".Reserved",availdate))))
		lineageTag: 3e13b7b9-a2d2-432e-a142-7b445004acee
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Start Ship Date' = Orders[DELIVERYDATE_SOL]
