	column 'Discounts (inc tax) Cancelled Col' =
			VAR DiscountSubject = Orders[Cancelled Units Col]
			VAR AvailDiscount = Orders[Discount]
			VAR TotalLineUnits = Orders[ORDEREDSALESQUANTITY_SOL]
			RETURN
			    DIVIDE ( AvailDiscount, TotalLineUnits ) * DiscountSubject
		isHidden
		displayFolder: zz_Values
		lineageTag: 67d0f131-4dbf-4409-bf01-693fbbf6e1dd
		summarizeBy: none

		changedProperty = IsHidden

