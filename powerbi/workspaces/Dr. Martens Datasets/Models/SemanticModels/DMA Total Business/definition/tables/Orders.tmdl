	column 'Cancelled Net Value Col' =
			VAR MAIN =
			    IF (
			        Orders[Cancelled Units Col] > 0,
			        IF (
			            Orders[AREPRICESINCLUDINGSALESTAX_SOH] = TRUE,
			            Orders[Full Price (inc tax) Cancelled Col] - Orders[Discounts (inc tax) Cancelled Col],
			            ( Orders[Cancelled Units Col] * Orders[NetUnitPrice] )
			        ),
			        BLANK ()
			    )
			RETURN
			    MAIN
		isHidden
		displayFolder: zz_Values
