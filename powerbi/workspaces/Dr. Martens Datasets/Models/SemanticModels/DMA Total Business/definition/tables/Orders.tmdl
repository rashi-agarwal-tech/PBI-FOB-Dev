	column 'Full Price (inc tax) Cancelled Col' =
			IF (
			    Orders[AREPRICESINCLUDINGSALESTAX_SOH] = TRUE,
			    ( Orders[Unit Price] * Orders[Cancelled Units Col] ),
			    BLANK ()
