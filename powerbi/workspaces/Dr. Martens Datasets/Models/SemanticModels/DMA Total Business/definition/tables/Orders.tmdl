			    RETURN
			        IF ( Orders[Source] = "D365_Open", pickact, BLANK () )
			)
			--CT update to handle returns, was previously 
			--var pickact = calculate(sum(Pick[Pick Qty]), Pick[HandlingStatusDesc] = "Activated")
			--return
