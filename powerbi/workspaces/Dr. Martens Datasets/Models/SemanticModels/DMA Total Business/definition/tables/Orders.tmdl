	column 'Pick Activated Product Units' = CALCULATE([Pick Activated Units],ALLEXCEPT(Orders,'Orders'[Sales Order Number],Orders[Product_Key]))
		isHidden
		displayFolder: 4. US
		lineageTag: b4ff86af-a94a-4b93-9758-bb5cab040b51
		summarizeBy: sum

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column 'Cancel Risk Order Status' =
			var pickunits = Orders[Pick Activated Product Units]+Orders[Pick Complete Product Units]
			var lfd = if(divide(Orders[Allocated Product Units]+Orders[Reserved Product Units]+pickunits,Orders[Open Product Units])=1,Orders[Fill Date - Order],today()+180)
			var produnits = (Orders[Allocated Product Units]-Orders[Allocated Product Units Late])+Orders[Reserved Product Units]+pickunits
			var fulfil = VALUE(related(Customer[Order Fullfillment %]))
			var cnx = Orders[Cancellation Date]
			var miss1 = if(lfd>cnx,if(fulfil<100,if(produnits<(Orders[Open Product Units]*0.7),"miss","part")))
			var miss2 = if(lfd>cnx,if(fulfil>=100,if(produnits<Orders[Open Product Units],"miss","full")))
			
			return
			
			if(Orders[Source]="D365_Open",
			if(pickunits>(Orders[Open Product Units]*0.7),"In-Pick",
			if(cnx<5,"No Cancel",
			if(today()>cnx,"Past Cancel",
			if(and(cnx<today()+5,lfd<=cnx),"At-Risk",
			if(or(miss1="miss",miss2="miss"),"Missing Cancel",
			if(or(lfd<=(cnx-5),produnits=Orders[Open Product Units]),"Safe",
			if(lfd<=cnx,"At-Risk",
			if(miss1="part","Partial","Missing Cancel")))))))),"Complete")
		displayFolder: 4. US
		lineageTag: d6759616-ae43-41b7-974f-9b78623f4062
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Available w/c' =
			var pickunits = Orders[Pick Act Units col]+Orders[Pick Comp Units col]
			var lfd = IF(Orders[Open Product Units]=Orders[Pick Complete Product Units],TODAY(),Orders[Fill Date - Order])
			var lfdavail = lfd - (WEEKDAY(lfd,2)+1)
			var pickc = Orders[Pick Complete Product units]
			var picka = Orders[Pick Activated Product units]
			var res = Orders[Reserved Product units]
			var alloc = Orders[Allocated product units]
			var availyr = if(year(lfdavail)=year(today()),"Avail. w/c ","Avail w/c ")
			var availdate = availyr & FORMAT(lfdavail,"mm/dd")
			var fulfil = VALUE(RELATED(Customer[Order Fullfillment %]))
			var OpenQty = if(VALUE(RELATED(Customer[Order Fullfillment %]))<100,Orders[Open Product units]*0.7,Orders[Open Product units])
			var PicOpenQty = Orders[Open Product units]*0.7
			
			return
			
			if(Orders[Source]="D365_Open",
			if(pickc>PicOpenQty,"...Pick Completed",
			if((picka+pickc)>PicOpenQty,"..Pick Activated",
			if((picka+pickc+res)>OpenQty,".Reserved",
			if(lfd<5,"No Avail Date",availdate)))),"Invoiced")
		displayFolder: 4. US
		lineageTag: ae785ed1-8c6f-45f6-961b-811e53b6c55e
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Discount Bucket' =
			SWITCH (
			    TRUE (),
			    OR (
			        Orders[Total Discount % Col] = 0,
			        ISBLANK ( Orders[Total Discount % Col] )
			    ), "0 %",
			    AND ( Orders[Total Discount % Col] > 0, Orders[Total Discount % Col] <= .1 ), "0-10 %",
			    AND ( Orders[Total Discount % Col] > .10, Orders[Total Discount % Col] < .25 ), "11-24 %",
			    AND ( Orders[Total Discount % Col] >= .25, Orders[Total Discount % Col] < .4 ), "25-39 %",
			    AND ( Orders[Total Discount % Col] >= .40, Orders[Total Discount % Col] < .6 ), "40-59 %",
			    AND ( Orders[Total Discount % Col] >= .60, Orders[Total Discount % Col] < 1 ), "60-99 %",
			    Orders[Total Discount % Col] = 1, "Free",
			    "no bucket"
			)
		lineageTag: a3248416-f218-40b5-bfe3-6db12eb35b9e
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Season =
			IF (
			    OR (
			        ISBLANK ( Orders[Order Season] ),
			        AND (
			            IFERROR ( SEARCH ( "AW", Orders[Order Season] ), 0 ) < 1,
			            IFERROR ( SEARCH ( "SS", Orders[Order Season] ), 0 ) < 1
			        )
			    ),
			    IF (
			        OR ( Orders[SALESORDERPOOLID_SOH] = "EO", Orders[SALESORDERPOOLID_SOH] = "RO" ),
			        SWITCH (
			            TRUE (),
			            AND ( MONTH ( Orders[DateMaster] ) >= 7, MONTH ( Orders[DateMaster] ) <= 12 ), "AW" & RIGHT ( YEAR ( Orders[DateMaster] ), 2 ),
			            AND ( MONTH ( Orders[DateMaster] ) >= 1, MONTH ( Orders[DateMaster] ) <= 6 ), "SS" & RIGHT ( YEAR ( Orders[DateMaster] ), 2 ),
			            BLANK ()
			        ),
			        IF (
			            AND (
			                Orders[SALESORDERPOOLID_SOH] = "DD",
			                NOT ( RELATED ( Warehouse[Warehouse ID] ) = "USDOMDD" )
			            ),
			            SWITCH (
			                TRUE (),
			                AND ( MONTH ( Orders[DateMaster] ) >= 4, MONTH ( Orders[DateMaster] ) <= 11 ), "AW" & RIGHT ( YEAR ( Orders[DateMaster] ), 2 ),
			                AND ( MONTH ( Orders[DateMaster] ) >= 12, MONTH ( Orders[DateMaster] ) <= 12 ),
			                    "SS"
			                        & RIGHT ( YEAR ( Orders[DateMaster] ) + 1, 2 ),
			                AND ( MONTH ( Orders[DateMaster] ) >= 1, MONTH ( Orders[DateMaster] ) <= 3 ), "SS" & RIGHT ( YEAR ( Orders[DateMaster] ), 2 ),
			                BLANK ()
			            ),
			            SWITCH (
			                TRUE (),
			                AND ( MONTH ( Orders[DateMaster] ) >= 12, MONTH ( Orders[DateMaster] ) <= 12 ),
			                    "SS"
			                        & RIGHT ( YEAR ( Orders[DateMaster] ) + 1, 2 ),
			                AND ( MONTH ( Orders[DateMaster] ) >= 1, MONTH ( Orders[DateMaster] ) <= 5 ), "SS" & RIGHT ( YEAR ( Orders[DateMaster] ), 2 ),
			                AND ( MONTH ( Orders[DateMaster] ) >= 6, MONTH ( Orders[DateMaster] ) <= 11 ), "AW" & RIGHT ( YEAR ( Orders[DateMaster] ), 2 ),
			                BLANK ()
			            ) --CT Update to align with B2B & D2C, was previously if ([SALESORDERPOOLID_SOH] = "DD", switch ( TRUE () , AND ( month(Orders[DateMaster]) >= 4 ,    month(Orders[DateMaster]) <= 9 ), "AW" & right(YEAR(Orders[DateMaster]),2) , AND ( month(Orders[DateMaster]) >= 10 ,    month(Orders[DateMaster]) <= 12 ), "SS" & right(YEAR(Orders[DateMaster])+1,2) , AND ( month(Orders[DateMaster]) >= 1 ,    month(Orders[DateMaster]) <= 3 ), "SS" & right(YEAR(Orders[DateMaster]),2) , blank()), switch ( TRUE () , AND ( month(Orders[DateMaster]) >= 1 ,    month(Orders[DateMaster]) <= 6 ), "SS" & right(YEAR(Orders[DateMaster]),2) ,AND ( month(Orders[DateMaster]) >= 7 ,    month(Orders[DateMaster]) <= 12 ), "AW" & right(YEAR(Orders[DateMaster]),2)  ,blank()
			        )
			    ),
			    Orders[Order Season]
			)
		lineageTag: 53b6f4c8-7d26-44fb-a369-ee654a05de49
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

