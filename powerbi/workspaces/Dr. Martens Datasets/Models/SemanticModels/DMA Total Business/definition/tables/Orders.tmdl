	column 'Returned Net Value Col Cons GBP' =
			IF (
			    AND (
			        Orders[Transaction Type] = "Return",
			        Orders[Transaction Status] = "Invoiced"
			    ),
			    ABS ( Orders[LINEAMOUNT_SIL_CONS_GBP] + Orders[HeaderDiscount_CONS_GBP] ),
