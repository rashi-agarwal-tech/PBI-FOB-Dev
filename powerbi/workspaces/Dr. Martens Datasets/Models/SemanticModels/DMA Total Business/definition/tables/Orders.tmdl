	column 'Pick Comp Units Col' =
			IF (
			    NOT ( ISBLANK ( Orders[RMA Number] ) ),
			    BLANK (),
			    VAR SHIPPED =
			        CALCULATE ( SUM ( 'Sales Packing Slip'[Shipped Qty] ) )
			    VAR PICKED =
			        CALCULATE ( SUM ( Pick[Pick Qty] ), Pick[HandlingStatusDesc] = "Complete" )
			    VAR sminusp =
			        CALCULATE (
			            PICKED - SHIPPED,
			            'Order Type'[Order Type ID] IN { "CO", "FO", "IO", "MTO", "PR", "SO", "UNK" }
			        )
			    VAR spin =
			        IF ( sminusp > 0, sminusp, BLANK () )
			    RETURN
			        IF ( Orders[Source] = "D365_Open", spin, BLANK () )
			)
			--CT update to handle returns, was previously
			--VAR SHIPPED = CALCULATE(SUM('Sales Packing Slip'[Shipped Qty]))
			--VAR PICKED = calculate(sum(Pick[Pick Qty]), Pick[HandlingStatusDesc] = "Complete")
			--var sminusp = CALCULATE(PICKED-SHIPPED,'Order Type'[Order Type ID] IN {"CO", "FO", "IO", "MTO", "PR", "SO", "UNK"})
			--var spin = if(sminusp>0,sminusp,blank())
			--RETURN
			--IF(Orders[Source]="D365_Open",spin,BLANK())
		isHidden
		displayFolder: zz_Units
		lineageTag: 34e1be02-b20b-4218-bb60-b717b750d068
		summarizeBy: sum

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

