	column 'Invoiced Net Value Col Cons GBP' =
			IF (
			    AND (
			        Orders[Transaction Type] IN { "Sale", "Charge" },
			        Orders[Transaction Status] = "Invoiced"
			    ),
			     ( Orders[LINEAMOUNT_SIL_CONS_GBP] - Orders[HeaderDiscount_CONS_GBP] ) + Orders[ChargeTotalExcTax_CONS_GBP],
