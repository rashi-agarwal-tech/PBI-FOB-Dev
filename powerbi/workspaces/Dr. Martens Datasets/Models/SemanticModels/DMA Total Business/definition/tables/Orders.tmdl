	column DateMaster =
			IF (
			    ISBLANK ( 'Orders'[INVOICEDATE_SIL] ),
			    'Orders'[DELIVERYDATE_SOL],
			    'Orders'[INVOICEDATE_SIL]
			)
		isHidden
		formatString: Short Date
		displayFolder: zz_Misc
		lineageTag: 8c35776c-ede7-466c-a739-3403ea6c5180
		summarizeBy: none

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column 'Period Orderbook Status Sort' =
			
			var custh = SWITCH(related(Customer[Customer On Hold Status]),blank(),"Clear","No","Clear","Held")
			var lfd = IF((Orders[Pick Complete Product Units]+Orders[Pick Activated Product Units]+Orders[Reserved Product Units])=Orders[Open Product Units],TODAY(),Orders[Fill Date - Order])
			var req = Orders[DELIVERYDATE_SOL]
			var HELD = if(OR(NOT(Orders[Hold Code]=BLANK()),custh="Held"),"Held",BLANK())
			var cnx = switch(Orders[Cancel Risk Order Status],"Missing Cancel","Yes","Past Cancel","Yes",blank())
			var sot = left(Orders[Sales Order Type],5)
			var ProductUnits = (Orders[Allocated Product Units] - Orders[Allocated Product Units Late])+Orders[Reserved Product Units]+Orders[Pick Activated Product Units]+Orders[Pick Complete Product Units]
			var fulfil = VALUE(RELATED(Customer[Order Fullfillment %]))
			var pcdat = if(req<[firstpdate],"02",if(req<[lastpdate],"01","04"))
			
			return
			
			if(Orders[Source]="D365_Open",
			if(sot="Frame",if(req<[lastpdate], if(lfd<[lastpdate],"03","06"),"10"),
			if((Orders[Pick Complete Product Units]+Orders[Pick Activated Product Units])=Orders[Open Product Units],pcdat,
			if(req<([lastpdate]),
			if(HELD="Held","07",
			if(cnx="Yes","08",
			if(lfd<=[lastpdate],pcdat,
			if(and(ProductUnits>(Orders[Open Product Units]*0.7),fulfil<100),"05","06")))),
			if(and(lfd<[lastpdate],(req-29)<[lastpdate]),if(or(cnx="Yes", HELD="Held"),"10","04"),"10")))),
			if('Orders'[INVOICEDATE_SIL]<[firstpdate],"11","09"))
		isHidden
		displayFolder: zz_Misc
		lineageTag: f286c6a8-7342-434c-ae09-fee7b1e72929
		summarizeBy: none

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

