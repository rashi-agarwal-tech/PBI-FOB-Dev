		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column NetUnitPrice =
			VAR AvailDiscount = Orders[Discount]
			VAR TotalLineUnits = Orders[ORDEREDSALESQUANTITY_SOL]
			VAR UNITDISCOUNT =
			    DIVIDE ( AvailDiscount, TotalLineUnits )
			VAR NetUnitPrice =
			    Orders[Unit Price] - ABS ( UNITDISCOUNT )
			RETURN
			    IF ( NetUnitPrice > 0, NetUnitPrice, BLANK () )
		isHidden
		displayFolder: zz_Values
		lineageTag: 2d40ffa9-355d-4f74-a9a1-ae4dd15191fe
		summarizeBy: none

		changedProperty = IsHidden

		annotation SummarizationSetBy = User

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column 'Open Net Value Col Cons GBP' =
			IF (
			    AND (
			        Orders[Transaction Status] = "Open",
			        Orders[REMAININVENTPHYSICAL_SOL] > 0
			    ),
			    ( ( Orders[LINEAMOUNT_SOL_CONS_GBP] - Orders[HeaderDiscount_CONS_GBP] ) * Orders[Open Units Pct] ),
			    BLANK ()
