	column 'Returned Net Value Col Cons GBP (inc tax)' =
			IF (
			    AND (
			        Orders[Transaction Type] = "Return",
			        Orders[Transaction Status] = "Invoiced"
			    ),
			    Orders[Returned Net Value Col Cons GBP] + ABS ( Orders[Tax_CONS_GBP] ),
			    BLANK ()
