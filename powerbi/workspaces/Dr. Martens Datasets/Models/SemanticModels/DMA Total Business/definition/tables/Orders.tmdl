	column 'Full Price (inc tax) Invoiced Col' =
			IF (
			    Orders[AREPRICESINCLUDINGSALESTAX_SOH] = TRUE,
			    IF (
			        Orders[Source] = "AX_Invoiced_US"
			            && Orders[LINEAMOUNT_SIL_CONS_GBP] > 0
			            && Orders[Invoiced Units Col] = 0,
			        Orders[LINEAMOUNT_SIL_CONS_GBP],
			        ( Orders[Unit Price] * Orders[Invoiced Units Col] )
			    ),
			    BLANK ()
