		annotation SummarizationSetBy = User

		annotation PBI_FormatHint = {"isCustom":true}

	column 'Returned Full Value Col Cons GBP' =
			IF (
			    OR (
			        Orders[Transaction Type] = "Return",
			        Orders[Source] = "AX_Invoiced_US"
			            && Orders[LINEAMOUNT_SIL_CONS_GBP] < 0
			            && Orders[Returned Units Col] = 0
			    ),
			    ABS ( Orders[LINEAMOUNT_SIL_CONS_GBP] - Orders[LineDiscount_CONS_GBP] ),
			    BLANK ()
			)
		isHidden
		formatString: 0.00
		displayFolder: zz_Values
		lineageTag: da848bbd-3742-4c22-a222-f706c42be52f
		summarizeBy: sum

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isCustom":true}

	column 'Ordered Net Value Col Cons GBP' =
			VAR TotalOrderDiscount =
			    CALCULATE (
			        SUM ( Orders[HeaderDiscount_CONS_GBP] ),
			        ALLEXCEPT (
			            Orders,
			            Orders[Company_Key],
			            Orders[Sales Order Number],
			            Orders[Order Line],
			            Orders[Transaction Type]
			        )
			    )
			RETURN
			    IF (
			        AND (
			            Orders[Transaction Type] = "Sale",
			            Orders[ORDEREDSALESQUANTITY_SOL_ZEROS] > 0
			        ),
			        Orders[LINEAMOUNT_SOL_CONS_GBP] - TotalOrderDiscount,
			        BLANK ()
			    )
		isHidden
		formatString: #,##0.00
