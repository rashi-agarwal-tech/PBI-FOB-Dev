	column 'Sales Order Type' = RELATED('Sales Order Type'[DESCRIPTION])
		lineageTag: 8733e970-ea99-425b-bdd4-6beff6b0b7a4
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Cancel Risk Order Status Sort' =
			var pickunits = Orders[Pick Activated Product Units]+Orders[Pick Complete Product Units]
			var lfd = if(divide(Orders[Allocated Product Units]+Orders[Reserved Product Units]+pickunits,Orders[Open Product Units])=1,Orders[Fill Date - Order],today()+180)
			var produnits = (Orders[Allocated Product Units]-Orders[Allocated Product Units Late])+Orders[Reserved Product Units]+pickunits
			var fulfil = VALUE(related(Customer[Order Fullfillment %]))
			var cnx = Orders[Cancellation Date]
			var miss1 = if(lfd>cnx,if(fulfil<100,if(produnits<(Orders[Open Product Units]*0.7),"miss","part")))
			var miss2 = if(lfd>cnx,if(fulfil>=100,if(produnits<Orders[Open Product Units],"miss","full")))
			
			return
			
			if(Orders[Source]="D365_Open",
			if(pickunits>(Orders[Open Product Units]*0.7),"01",
			if(cnx<5,"07",
			if(today()>cnx,"05",
			if(and(cnx<today()+5,lfd<=cnx),"03",
			if(or(miss1="miss",miss2="miss"),"06",
			if(or(lfd<=(cnx-5),produnits=Orders[Open Product Units]),"02",
			if(lfd<=cnx,"03",
			if(miss1="part","04","06")))))))),"08")
		lineageTag: 87c94903-9a90-434a-a6bd-c21695d4cfc0
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Returned Units Col' =
			IF (
			    AND (
			        Orders[Transaction Type] = "Return",
			        Orders[Transaction Status] = "Invoiced"
			    ),
			    IF (
			        Orders[INVOICEDQUANTITY_SIL] <> 0,
			        ABS ( Orders[INVOICEDQUANTITY_SIL] ),
			        ABS ( Orders[RETURNEDSALESQUANTITY_ROL_ZEROS] )
			    ),
			    BLANK ()
			)
		isHidden
		formatString: #,##0
		displayFolder: zz_Units
		lineageTag: 08279f94-4a97-4be4-b811-ca5b3eadadea
		summarizeBy: none

