	column 'Approved Ex-Factory Date'
		dataType: dateTime
		isHidden
		formatString: General Date
		sourceProviderType: datetime2
		lineageTag: de7757e5-a6eb-4ddf-ab55-5df3740aad07
		summarizeBy: none
		sourceColumn: Approved Ex-Factory Date

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column 'Contractual Ex-Factory Date'
		dataType: dateTime
		isHidden
		formatString: Short Date
		sourceProviderType: datetime2
		lineageTag: cd9ead51-80cc-469d-8ff3-63b71a4119bd
		summarizeBy: none
		sourceColumn: Contractual Ex-Factory Date

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column '_Is Previous Fiscal Week' =
			IF (
			    YEAR ( 'Pack One'[Packed Date] )
			        = YEAR (
			            TODAY ()
			        ),
			    IF (
			        WEEKNUM (
			            'Pack One'[Packed Date],
			            2
			        )
			            = WEEKNUM (
			                TODAY (),
			                2
			            ) - 1,
			        1,
			        0
			    ),
			    0
			)
		formatString: 0
		lineageTag: 17bb5fb1-b6e6-48fc-93e5-dcdbe0dcb27d
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'OTD Grouping' =
			SWITCH (
			    TRUE (),
			    'Pack One'[Packed Date vs Contractual] <= 0, "(1) - Early/OT",
			    'Pack One'[Packed Date vs Contractual] > 0
			        && 'Pack One'[Packed Date vs Contractual] <= 7, "(2) - 1 Week Late",
			    'Pack One'[Packed Date vs Contractual] > 7
			        && 'Pack One'[Packed Date vs Contractual] <= 14, "(3) - 2 Weeks Late",
			    'Pack One'[Packed Date vs Contractual] > 14
			        && 'Pack One'[Packed Date vs Contractual] <= 21, "(4) - 3 Weeks Late",
			    'Pack One'[Packed Date vs Contractual]  > 21, "(5) - +3 Weeks Late",
			    ""
			)
		lineageTag: e0d9598e-955c-43bf-8cf3-26be4c189de2
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Packed Date vs Contractual' =
			IF (
			    ISBLANK ( 'Pack One'[Contractual Ex-Factory Date] ),
			    DATEDIFF ( 'Pack One'[Approved Ex-Factory Date], 'Pack One'[Packed Date], DAY ),
			    DATEDIFF (
			        'Pack One'[Contractual Ex-Factory Date],
			        'Pack One'[Packed Date],
			        DAY
			    )
			)
		formatString: 0
		lineageTag: d2f7fbf4-a4d3-4d2a-9a8a-6fcf0d07fd4c
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

