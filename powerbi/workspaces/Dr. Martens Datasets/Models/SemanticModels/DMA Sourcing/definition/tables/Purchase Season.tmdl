	column CurrentSeasonYear =
			IF (
			    [StartSeason] <= NOW ()
			        && [EndSeason] >= NOW (),
			    RIGHT ( [Season], 2 ),
			    IF (
			        RIGHT ( [Season], 2 ) = RIGHT ( VALUE ( YEAR ( NOW () ) ), 2 ),
			        RIGHT ( VALUE ( YEAR ( NOW () ) ), 2 ),
			        ""
			    )
			)
		isHidden
		displayFolder: zz_Misc
		lineageTag: 682efe47-1898-48c3-89ba-1faa4247e946
		summarizeBy: none

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	partition 'Purchase Season' = m
		mode: import
		source =
				let
				    Source = Snowflake.Databases(Datasource_Server, Datasource_Warehouse),
					PRESENTATION_Database = Source{[Name=Datasource_Database,Kind="Database"]}[Data],
				    BFN_PRESENTATION_Schema = PRESENTATION_Database{[Name=Datasource_Schema,Kind="Schema"]}[Data],
				    BFN_Datatable_View = BFN_PRESENTATION_Schema{[Name="SRC_BFN_VW_DIMDATESEASON",Kind="View"]}[Data],
					#"Kept First Rows" = Table.FirstN(BFN_Datatable_View,NumberOfRows),
					ParameterFilter = if NumberOfRows > 0 then #"Kept First Rows" else BFN_Datatable_View
				in
					ParameterFilter

	annotation PBI_ResultType = Table

