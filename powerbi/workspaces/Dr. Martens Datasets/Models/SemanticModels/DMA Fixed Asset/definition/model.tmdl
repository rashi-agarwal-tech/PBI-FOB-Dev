model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["Analysis", "Asset", "Asset Book", "Asset Group", "Cost Centre", "Country", "Datasource_Database", "Datasource_Schema", "Datasource_Server", "Datasource_Warehouse", "Date", "Financial Channel", "Fixed Asset Transactions", "Main Account", "Region"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBIDesktopVersion = 2.126.927.0 (24.02)

annotation PBI_ProTooling = ["DevMode"]

ref table 'Fixed Asset Transactions'
ref table Region
ref table Analysis
ref table 'Financial Channel'
ref table 'Cost Centre'
ref table Country
ref table 'Main Account'
ref table Asset
ref table 'Asset Group'
ref table 'Asset Book'
ref table Date
ref table Metrics

ref role 'Global Users'
ref role 'NA Users'
ref role 'EMEA Users'
ref role 'HK Users'
ref role 'HK Users - Global'
ref role 'JP Users'
ref role 'JP Users - Global'
ref role 'AsiaPac Users'

ref cultureInfo en-US

