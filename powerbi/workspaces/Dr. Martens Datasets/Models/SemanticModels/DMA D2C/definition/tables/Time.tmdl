	column 'Hour Period' =
			
			
			var main = if(LEN('Time'[Hour])=1,"0"&'Time'[Hour],'Time'[Hour])
			
			var main2 = if(LEN('Time'[Hour])=1,"0"&('Time'[Hour]+1),('Time'[Hour]+1))
			
			return
			
			main&"-"&main2
		lineageTag: 46aa8ea6-65c3-4707-a10f-4cfb6df48b9b
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Time of Day' =
			if('Time'[Hour]<6,"Overnight",
			if('Time'[Hour]<9,"Breakfast",
			if('Time'[Hour]<12,"Morning",
			if('Time'[Hour]<14,"Lunch",
			if('Time'[Hour]<18,"Afternoon",
			if('Time'[Hour]<20,"Dinner","Evening"))))))
		lineageTag: 1a59744c-53ac-418a-836c-7647ea0ed849
		summarizeBy: none

