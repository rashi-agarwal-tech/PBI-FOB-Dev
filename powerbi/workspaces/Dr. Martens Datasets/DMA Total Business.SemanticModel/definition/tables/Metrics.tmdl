	measure lastpdate =
			
			var fisper = LOOKUPVALUE('Date'[Fiscal US Year-Period],'Date'[ Date],today()-1)
			return
			calculate(LASTDATE('Date'[ Date]),all('Date'),'Date'[Fiscal US Year-Period]=fisper)
		formatString: General Date
		isHidden
		displayFolder: Others
		lineageTag: 76e9a042-b1ee-4927-9bfb-5325b1d18078

	measure firstpdate =
			
			var fisper = LOOKUPVALUE('Date'[Fiscal US Year-Period],'Date'[ Date],today()-1)
			return
			calculate(FIRSTDATE('Date'[ Date]),all('Date'),'Date'[Fiscal US Year-Period]=fisper)
		formatString: General Date
		isHidden
		displayFolder: Others
		lineageTag: 3d40395a-1347-4e99-a5cb-bc041cca713b

	measure 'N3M Uplift' =
			VAR L3MLY =
			    CALCULATE (
			        [Total Units],
			        DATESINPERIOD (
			            'Date'[ Date],
			            LASTNONBLANK ( 'Date'[ Date], [Total Units] ) - 364,
			            -91,
			            DAY
			        ),
			        ALL ( Products )
			    )
			VAR N3MLY =
			    CALCULATE (
			        [Total Units],
			        DATESINPERIOD (
			            'Date'[ Date],
			            LASTNONBLANK ( 'Date'[ Date], [Total Units] ) - 364,
			            91,
			            DAY
			        ),
			        ALL ( Products )
			    )
			VAR uplift =
			    DIVIDE ( N3MLY, L3MLY, 1 ) - 1
			RETURN
			    IF ( uplift > 0, uplift, BLANK () )
		formatString: " #,0%;-#,0%;#,0%"
		displayFolder: Stock Metrics\9. Other
		lineageTag: b025804c-bf32-41b7-9b6c-2687226c6dd6

