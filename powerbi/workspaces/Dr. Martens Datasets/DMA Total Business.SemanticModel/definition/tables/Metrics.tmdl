table Metrics
	lineageTag: 694c75d7-ffe7-463d-a585-cdf55ad77dc4

	measure 'ROS N3M' =
			VAR L3M =
			    DIVIDE (
			        CALCULATE (
			            [Total Units],
			            DATESINPERIOD (
			                'Date'[ Date],
			                LASTNONBLANK ( 'Date'[ Date], [Total Units] ),
			                -91,
			                DAY
			            )
			        ),
			        13
			    )
			VAR L3MLY =
			    CALCULATE (
			        [Total Units],
			        DATESINPERIOD (
			            'Date'[ Date],
			            LASTNONBLANK ( 'Date'[ Date], [Total Units] ) - 364,
			            -91,
			            DAY
			        ),
			        ALL ( Products )
			    )
			VAR N3MLY =
			    CALCULATE (
			        [Total Units],
			        DATESINPERIOD (
			            'Date'[ Date],
			            LASTNONBLANK ( 'Date'[ Date], [Total Units] ) - 364,
			            91,
			            DAY
			        ),
			        ALL ( Products )
			    )
			VAR uplift =
			    DIVIDE ( N3MLY, L3MLY, 1 )
			VAR ROSN3M = L3M * uplift
			RETURN
			    IF ( ROSn3m > 0, ROSN3M, BLANK () )
		formatString: " #,0"
		displayFolder: Stock Metrics\3. ROS / Cover
		lineageTag: 634c0f92-b3d3-4840-ba7d-952a19a7b3bf

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'Open Units' =
