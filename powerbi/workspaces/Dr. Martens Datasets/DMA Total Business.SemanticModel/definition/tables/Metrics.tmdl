			            CONTAINS (
			                VALUES ( 'Date'[ Last Year Date] ),
			                'Date'[ Last Year Date], 'Date'[ Date]
			            )
			        )
			    )
			)
		displayFolder: Sales Metrics\06. Footfall & Net Transactions\vs.\vs US LFY
		lineageTag: eaa61ccc-6ace-47a4-a757-60eb82fc68eb

	measure 'Footfall US LFY' =
			IF (
			    HASONEFILTER ( 'Date'[Fiscal US Year] )
			        && HASONEFILTER ( 'Date'[Is Week Filter (544)] ),
			    CALCULATE (
			     [Footfall],
			        ALL ( 'Date' ),
			        FILTER (
			            ALL ( 'Date' ),
			            'Date'[Financial Year]
			                = VALUES ( 'Date'[Financial Year] ) - 1
			                && CONTAINS (
			                    VALUES ( 'Date' ),
			                    'Date'[Fiscal US Period Number], 'Date'[Fiscal US Period Number]
			                )
			        )
			    ),
			    CALCULATE (
			     [Footfall],
			        FILTER (
			            ALL ( 'Date' ),
			            CONTAINS (
			                VALUES ( 'Date'[ Last Year Date] ),
			                'Date'[ Last Year Date], 'Date'[ Date]
			            )
			        )
			    )
			)
		formatString: " #,0"
		displayFolder: Sales Metrics\06. Footfall & Net Transactions\vs.\vs US LFY
		lineageTag: f63c162a-b3a9-4cf7-830b-9c1d6af46323

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'ATV vs LFY %' =
			
			
