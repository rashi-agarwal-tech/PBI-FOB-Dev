		lineageTag: 09773642-bc69-4219-bdc4-1a25791141b6

		annotation PBI_FormatHint = {"isCustom":true}

	measure XR =
			IF (
			    OR (
			        HASONEFILTER ( 'Display Currency'[Currency Name] ),
			        HASONEFILTER ( 'Display Currency'[Currency Code] )
			    ),
			    IF (
			        FIRSTNONBLANK ( 'Display Currency'[Currency Code], 1 ) = "999",
			        1,
			        SUM ( 'Display Currency'[XRMultiplier] )
			    ),
			    1
			)
		isHidden
		displayFolder: Others
