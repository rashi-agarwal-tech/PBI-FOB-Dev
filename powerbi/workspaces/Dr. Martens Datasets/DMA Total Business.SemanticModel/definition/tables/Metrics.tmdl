		lineageTag: e35e7417-0c4b-46d5-a847-d75d3f5349bd

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'eCom Demand Gross Value' =
			CALCULATE (
			    SUM ( Orders[eCom Demand Value Col] ),
			    Orders[Finance Dimension - Channel] = "102",
			    USERELATIONSHIP ( Orders[Order DateTime], 'Date'[ Date] )
			) * [XR]
		formatString: " #,0.00"
		displayFolder: Sales Metrics\07. Demand
		lineageTag: e1ac6538-ed78-4f8e-b995-c8b91e4ca018

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'eCom Demand Discount' =
			CALCULATE (
			    SUM ( Orders[Discount] ),
			    Orders[Finance Dimension - Channel] = "102",
			    USERELATIONSHIP ( Orders[Order DateTime], 'Date'[ Date] )
			) * [XR]
		formatString: " 0.00"
