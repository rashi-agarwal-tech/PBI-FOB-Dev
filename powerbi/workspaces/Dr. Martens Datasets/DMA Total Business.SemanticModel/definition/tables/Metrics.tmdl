		annotation PBI_FormatHint = {"isCustom":true}

	measure 'eCom Demand Discount %' =
			DIVIDE (
			    [eCom Demand Discount],
			    [eCom Demand Gross Value] + [eCom Demand Discount],
			    BLANK ()
			)
		formatString: " 0.0%;-0.0%;0.0%"
		displayFolder: Sales Metrics\07. Demand
		lineageTag: cd492b04-33e6-45ae-8a6b-47b955c4f1b0

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'eCom Raw Demand Units' =
			VAR TmpEcomOrders =
			    CALCULATETABLE (
			        Orders,
			        Orders[Finance Dimension - Channel] = "102",
			        USERELATIONSHIP ( Orders[Order DateTime], 'Date'[ Date] )
			    )
			VAR ItemSizeCount =
			    COUNTROWS (
			        GROUPBY (
			            TmpEcomOrders,
			            Orders[Sales Order Number],
			            Orders[ITEMNUMBER_SOL_ROL],
			            Orders[Size_Key]
			        )
			    )
			VAR ItemCount =
			    COUNTROWS (
			        GROUPBY (
			            TmpEcomOrders,
			            Orders[Sales Order Number],
			            Orders[ITEMNUMBER_SOL_ROL]
			        )
			    )
			VAR main = [eCom Demand Units] - ( ItemSizeCount - ItemCount )
			RETURN
			    IF ( main > 0, main, BLANK () )
		formatString: #,##0
		displayFolder: Sales Metrics\07. Demand
		lineageTag: 7eb5be62-5455-4ec5-a5a4-476e7a190147

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'eCom Demand Transactions' =
			CALCULATE (
			    DISTINCTCOUNT ( 'Orders'[Sales Order Number] ),
			    Orders[Finance Dimension - Channel] = "102",
			    USERELATIONSHIP ( Orders[Order DateTime], 'Date'[ Date] )
			)
		formatString: " #,0"
		displayFolder: Sales Metrics\07. Demand
		lineageTag: 662b2c58-0d9b-4ac3-b7dd-96e2ff60e394

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'eCom Demand UPT' = DIVIDE ( [eCom Demand Units], [eCom Demand Transactions], BLANK () )
		formatString: " 0.00"
		displayFolder: Sales Metrics\07. Demand
		lineageTag: 9d82cc84-ec4b-4f41-a7ee-1efe71fa19c9

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'eCom Demand ATV' = DIVIDE ( [eCom Demand Gross Value], [eCom Demand Transactions], BLANK () )
