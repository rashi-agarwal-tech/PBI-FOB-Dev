		annotation PBI_FormatHint = {"isCustom":true}

	measure 'eCom Demand Conversion %' =
			VAR FNBMonth =
			    FIRSTDATE ( 'Date'[ Date] )
			VAR LNBMonth =
			    LASTDATE ( 'Date'[ Date] )
			VAR OrderedNV =
			    CALCULATE (
			        [eCom Demand Units],
			        DATESBETWEEN ( Orders[Order DateTime], FNBMonth, LNBMonth )
			    )
			VAR InvoicedNV =
			    CALCULATE (
			        [Invoiced Units],
			        DATESBETWEEN ( Orders[Order DateTime], FNBMonth, LNBMonth ),
			        DATESBETWEEN ( 'Orders'[INVOICEDATE_SIL], FNBMonth, LNBMonth )
			    )
			VAR Main =
			    DIVIDE ( InvoicedNV, OrderedNV )
			RETURN
			    Main
		formatString: " #,0.0%;-#,0.0%;#,0.0%"
		displayFolder: Sales Metrics\07. Demand
		lineageTag: 578a6993-36e1-4eb6-a021-8a38b14b997e

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'Retail Days Gone' = ```
			
			VAR CurrYear =  CALCULATE(MAX('Date'[Year]), ALL('Date'), FILTER('Date', 'Date'[- Is Yesterday?] = "Yes"))
			
			VAR CurrDate = CALCULATE(MAX('Date'[ Date]), ALL('Date'), FILTER('Date', 'Date'[- Is Yesterday?] = "Yes"))
			
			VAR CurrXmas = DATE(YEAR(CurrYear), MONTH(12), DAY(25)) 
			
			RETURN 
			    CALCULATE(COUNTROWS('Date'), ALL('Date'), FILTER('Date', 'Date'[Year] = CurrYear && 'Date'[ Date] <= CurrDate
			            && 'Date'[ Date] <> CurrXmas))
			```
		displayFolder: Sales Metrics\10. Other
		lineageTag: cc190740-0847-4bed-b6a3-5d97c2099f8d

	measure 'Retail Days Remaining' = ```
			
			VAR CurrYear =  CALCULATE(MAX('Date'[Year]), ALL('Date'), FILTER('Date', 'Date'[- Is Yesterday?] = "Yes"))
			
			VAR CurrDate = CALCULATE(MAX('Date'[ Date]), ALL('Date'), FILTER('Date', 'Date'[- Is Yesterday?] = "Yes"))
			
			VAR CurrXmas = DATE(YEAR(CurrYear), MONTH(12), DAY(25)) 
			
			RETURN 
			    CALCULATE(COUNTROWS('Date'), ALL('Date'), FILTER('Date', 'Date'[Year] = CurrYear && 'Date'[ Date] > CurrDate
			            && 'Date'[ Date] <> CurrXmas))
			```
		displayFolder: Sales Metrics\10. Other
		lineageTag: 003b7b66-14b7-4c6f-bc38-c4e75aee1c5c

	measure 'Retail Days % Gone' = divide([Retail Days Gone],[Retail Days Gone]+[Retail Days Remaining])
