	measure 'Customer Closing Stock LY' =
			IF (
			    HASONEVALUE ( 'Date'[Year] ),
			    CALCULATE (
			        [Customer Closing Stock],
			        ALL ( 'Date' ),
			        ALL ( 'Date Slicer'[Date Slicer] ),
			        FILTER (
			            ALL ( 'Date' ),
			            'Date'[Year]
			                = VALUES ( 'Date'[Year] ) - 1
			                && CONTAINS (
			                    VALUES ( 'Date'[Day # of Year] ),
			                    'Date'[Day # of Year], 'Date'[Day # of Year]
			                )
			        )
			    ),
			    BLANK ()
			)
		formatString: #,0
		isHidden
		displayFolder: Sales Metrics\10. Other\2. Sell Out\EMEA\vs LY
		lineageTag: 6f3b893c-22b2-482f-b9bd-74de7010cf3b

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'Net Sell Out Units LY' =
			IF (
			    HASONEVALUE ( 'Date'[Year] ),
			    CALCULATE (
			        [Net Sell Out Units],
			        ALL ( 'Date' ),
			        ALL ( 'Date Slicer'[Date Slicer] ),
			        FILTER (
			            ALL ( 'Date' ),
			            'Date'[Year]
			                = VALUES ( 'Date'[Year] ) - 1
			                && CONTAINS (
			                    VALUES ( 'Date'[Day # of Year] ),
			                    'Date'[Day # of Year], 'Date'[Day # of Year]
			                )
			        )
			    ),
			    BLANK ()
			)
