	measure LatestForecastVersion = ```
			VAR MaxForecastRank =
			    MAX ( Forecast[FCRanker] )
			VAR LatestForecast =
			    IF (
			        HASONEFILTER ( Forecast[Forecast Version] ),
			        MAX ( Forecast[Forecast Version] ),
			        CALCULATE (
			            MAX ( Forecast[Forecast Version] ),
			            FILTER ( Forecast, Forecast[FCRanker] = MaxForecastRank )
			        )
			    )
			RETURN
			    LatestForecast
			
			
			```
		isHidden
		displayFolder: Sales Metrics\04. Total\vs.\FC Calcs
		lineageTag: e79da303-4c8c-4914-976c-2777d1185930

