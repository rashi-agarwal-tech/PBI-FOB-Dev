			    )
		lineageTag: 6566325a-4934-4570-a029-3bba6f8fe66e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'SLA Delta (7 day max)' =
			CALCULATE(
			        MAX('Power BI Model Refresh Status'[SLA Delta]),
			        'Power BI Model Refresh Status'[Region Refresh Number] < 21
			    )
		lineageTag: 4727d651-6d28-41b3-96ae-90637c220469

		annotation PBI_FormatHint = {"isGeneralNumber":true}

