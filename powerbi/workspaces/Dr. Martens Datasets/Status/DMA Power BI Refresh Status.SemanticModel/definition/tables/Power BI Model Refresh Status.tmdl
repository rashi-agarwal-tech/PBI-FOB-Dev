table 'Power BI Model Refresh Status'
	lineageTag: 917c7682-eb5f-4170-a5f7-ea9cf6dc22b6

	measure 'SLA Delta (7 day avg)' =
			CALCULATE(
			        AVERAGE('Power BI Model Refresh Status'[SLA Delta]),
			        'Power BI Model Refresh Status'[Region Refresh Number] < 21
			    )
		lineageTag: b9d6f45d-1581-4aea-9ebc-a8044f9a73fc

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'SLA Delta (sum)' = SUM('Power BI Model Refresh Status'[SLA Delta])
		lineageTag: 1abbe802-29dc-49b9-bc75-bd84bf2d12fe

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'SLA Delta Latest' = CALCULATE(SUM('Power BI Model Refresh Status'[SLA Delta]), 'Power BI Model Refresh Status'[Region Refresh Number] <4)
		lineageTag: f485248f-87c3-4be6-b0c5-360f883b9fd5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'SLA Delta  (7 day min)' =
