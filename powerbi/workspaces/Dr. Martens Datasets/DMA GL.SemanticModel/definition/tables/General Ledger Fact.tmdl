	column 'Posting Layer Description' =
			SWITCH (
			    TRUE (),
			    'General Ledger Fact'[Posting Layer] = 0, "Current",
			    'General Ledger Fact'[Posting Layer] = 1, "Operations",
			    'General Ledger Fact'[Posting Layer] = 2, "Tax",
			    'General Ledger Fact'[Posting Layer] = 18, "GAAP",
			    'General Ledger Fact'[Posting Layer] = 19, "Restatement",
			    'General Ledger Fact'[Posting Layer] = 20, "IFRS16",
			    ""
			)
		dataType: string
		lineageTag: fb3a190e-c3a7-4e1c-957e-374980963d42
		summarizeBy: none
		isDataTypeInferred

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

