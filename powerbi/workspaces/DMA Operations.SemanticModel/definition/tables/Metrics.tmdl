			var ldate = calculate(LASTDATE(Intake[SnapShot Date]),ALL(Products),all(Size),all(Warehouse),all('Date'))
			var main = CALCULATE(sum(Intake[QTYFREE]),Intake[SnapShot Date]=ldate)
			
