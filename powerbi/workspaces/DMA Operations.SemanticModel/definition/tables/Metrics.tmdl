	measure 'Unit Cost' =
			VAR ldate =
			    CALCULATE (
			        LASTDATE ( Availability[DATE] ),
			        ALL ( Products ),
			        ALL ( Size ),
			        ALL ( Warehouse ),
			        ALL ( 'Selling Status - Invoice' )
			    )
			VAR main =
			    DIVIDE (
			        CALCULATE (
			            SUM ( Availability[AMOUNT] ),
			            'Date'[ Date] >= VALUE ( "27/05/2019" ),
			            Availability[DATE] = ldate
			        ),
			        CALCULATE (
			            SUM ( Availability[QTY] ),
			            'Date'[ Date] >= VALUE ( "27/05/2019" ),
			            Availability[DATE] = ldate
			        )
			    )
			RETURN
			    IF ( main = 0, BLANK (), main )
		formatString: " #,0.00"
		displayFolder: Inventory Levels
		lineageTag: f37d9649-8307-4863-b765-ff8503861829

		annotation PBI_FormatHint = {"isCustom":true}

