	measure '6.1 % Despatched Units' =
			
			DIVIDE (
			    SUMX ( Movements, Movements[DespatchedUnits] ),
			    CALCULATE (
			        SUM ( Movements[DespatchedUnits] ),
			        ALL (
			            Movements[eCom Despatch Time Band],
			            Movements[eCom Despatch Time Band Sort]
			        )
			    )
			)
