		annotation PBI_FormatHint = {"isCustom":true}

	measure '4. Cumulative Available Units' = ```
			
			
			/* establishes the date from the availability table from which to pull the on-hand stock */
			var availsnapshotdate = calculate(LASTDATE(Availability[DATE]),ALL(Availability))
			
			/* fixes the on hand stock figure */
			var curonhand = calculate([1. On Hand Available Units],filter(all(Availability[DATE]),Availability[DATE]=availsnapshotdate))
			
			/* establishes the date from the intake table from which to take the availability snapshot */
			var intakesnapshotdate = calculate(LASTDATE(Intake[SnapShot Date]),all(Intake))
			
			/* pulls in current available units against all dates */
			var alldatesavail = CALCULATE(sum(Availability[AvailableOnHandUnits]),filter(all('Date'),availsnapshotdate='Date'[ Date]))
			
			/* pulls intake units at the last snapshot */
			var lastestintake = CALCULATE(sum(Intake[QTYFREE]),Intake[SnapShot Date]=intakesnapshotdate)
			
			/* pulls intake units at the last snapshot unbound by size */
			var lastestintakeallsize = CALCULATE(sum(Intake[QTYFREE]),Intake[SnapShot Date]=intakesnapshotdate,ALL(SIZE))
			
			/* makes the intake cumulative */
			var cumintake = calculate(sum(Intake[QTYFREE]),filter(ALL('Date'),'Date'[ Date]<=max('Date'[ Date])),Intake[SnapShot Date]=intakesnapshotdate)
			
			/* fixed currentstock position against all future intake available dates */
			var fixedstock = if(OR(availsnapshotdate=MIN('Date'[ Date]),lastestintakeallsize>0),alldatesavail,curonhand)
			
			/* brings in cumulative intake against days when we are receiving available stock of the product */
			var cumintake2 = if(OR(availsnapshotdate=MIN('Date'[ Date]),lastestintakeallsize>0),cumintake,blank())
			
			return
			
			cumintake2+fixedstock
			
			```
		formatString: " #,0"
		displayFolder: Inventory Levels\z Availability
		lineageTag: 218ff9db-1375-4870-a50b-4bb465c6222c

		annotation PBI_FormatHint = {"isCustom":true}

	measure '1. On Hand Available Units' =
			var ldate = calculate(LASTDATE(Availability[DATE]),ALL(Products),all(Size),all(Warehouse),all('Selling Status - Invoice'))
			var main = CALCULATE(SUM(Availability[AvailableOnHandUnits]),Availability[DATE]=ldate)
			
			return
			
			if(main=0,blank(),main)
		formatString: " #,0"
