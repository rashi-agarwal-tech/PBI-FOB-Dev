	measure '3. Intake Ordered Available Units' =
			var ldate = calculate(LASTDATE(Intake[SnapShot Date]),ALL(Products),all(Size),all(Warehouse),all('Date'))
			var main = CALCULATE(sum(Intake[QTYFREE]),Intake[SnapShot Date]=ldate,USERELATIONSHIP(Intake[Date_Key],'Date'[Date_Key]))
			
			return
			
			if(main=0,blank(),main)
		formatString: " #,0"
		displayFolder: Inventory Levels\z Availability
