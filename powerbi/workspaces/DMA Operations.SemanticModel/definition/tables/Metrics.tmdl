		annotation PBI_FormatHint = {"isCustom":true}

	measure 'Opening Stock' =
			VAR ldate =
			    CALCULATE (
			        LASTDATE ( Availability[DATE] ),
			        ALL ( Products ),
			        ALL ( Warehouse ),
			        ALL ( Size )
			    )
			VAR qty =
			    CALCULATE (
			        CALCULATE (
			            SUM ( Availability[QTY] ),
			            USERELATIONSHIP ( Availability[NextDate], 'Date'[ Date] ),
			            'Date'[ Date] = ldate
			        )
			    )
			VAR main =
			    IF ( SELECTEDVALUE ( 'Date'[ Date] ) > TODAY (), 0, qty )
			RETURN
			    IF ( main = 0, BLANK (), main )
		formatString: " #,##0"
		displayFolder: Inventory Levels
		lineageTag: 52a03ff9-9932-4b0b-9353-6833e3bf93b1

