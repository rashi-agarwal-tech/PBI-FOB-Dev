			    ))
			
			    +if(FIRSTDATE('Date'[ Date])>today(),CALCULATE([PC WATERFAL Pairs],all('Date'[Fiscal Week Number (544)])),0)
			    +[Cumulative Period Res+Alloc Pairs]
		formatString: 0
		lineageTag: f7f6849b-fc8b-47bd-969c-2ce32c27c3e5

	measure 'PA Pairs' = 0//CALCULATE([Pick Activated Units],all('Date'),FILTER(Orders,Orders[Start Ship Date]<[lastpdate]))
		lineageTag: f12cfabc-8325-4259-b510-0545fe7cfb88

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'PA WATERFAL Pairs' =
			
			VAR A = LOOKUPVALUE('Date'[ Date],'Date'[- Is Today?],"Yes")
			return
			IF(LASTDATE('Date'[ Date])<=a,blank(),
			if(LASTDATE('Date'[ Date])>=a&&FIRSTDATE('Date'[ Date])<=a,CALCULATE([PA Pairs],all('Date'))))
