		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'PC Pairs' = CALCULATE([Pick Activated Units],FILTER('Date','Date'[ Date]<=[lastperdate]))+CALCULATE([Pick Complete Units],FILTER('Date','Date'[ Date]<=[lastperdate]))
		lineageTag: 8a4f10c0-d6e9-44bf-bf6d-a620695077e6

