table 'Date Slicer'
	lineageTag: db4c3a14-d0d6-4073-b7be-bc608d4afd8f
	sourceLineageTag: 6af72e7e-6234-4c8f-ac76-0a5816569d5e

	measure 'Cumulative Period' =
			
			
			var sel = SELECTEDVALUE('Date'[Fiscal Year-Period])
			
			return
			CALCULATE (
			    [Invoiced Net Value], 'Date'[Fiscal Year-Period]=sel,
			    FILTER (
			        ALL ( 'Date'[ Date] ),
			        'Date'[ Date] <= MAX ( 'Date'[ Date] )
			    )
			)-[Cumulative Period Subtraction]
		formatString: 0
		lineageTag: f29d3789-133e-4d6f-afd1-d34667850fec

	measure 'PA WATERFAL' =
			
			VAR A = LOOKUPVALUE('Date'[ Date],'Date'[- Is Today?],"Yes")
			return
			IF(LASTDATE('Date'[ Date])<=a,blank(),
			if(LASTDATE('Date'[ Date])>=a&&FIRSTDATE('Date'[ Date])<=a,CALCULATE([PA],all('Date'))))
		lineageTag: 26ca8637-61f2-491d-a78f-01c3616727a4

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'PC WATERFAL' =
			
			VAR A = LOOKUPVALUE('Date'[ Date],'Date'[- Is Today?],"Yes")
			return
			IF(LASTDATE('Date'[ Date])<=a,blank(),
			if(LASTDATE('Date'[ Date])>=a&&FIRSTDATE('Date'[ Date])<=a,CALCULATE([PC],all('Date'))))
		lineageTag: 58397a0b-9c57-4091-99fb-0d8295a6b7f6

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'RES+ALL WATERFAL' =
			
			CALCULATE(CALCULATE([Reserved Net Value]+[Allocated Net Value],filter(Orders,Orders[Start Ship Date]<[lastperdate]),USERELATIONSHIP('Date'[ Date],Orders[Fill Date - Cust Req #])),CROSSFILTER('Date'[ Date],Orders[Start Ship Date],None))
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: b3df2292-0adf-4afb-95f1-3f46e6907677

	measure 'Cumulative Period Waterfall' =
			
			var sel = SELECTEDVALUE('Date'[Fiscal Year-Period])
			return
			CALCULATE (
			    [Invoiced Net Value], 'Date'[Fiscal Year-Period]=sel,
			    FILTER (
			        ALL ( 'Date'[ Date] ),
			        'Date'[ Date] < MIN ( 'Date'[ Date] )
			    ))
			
			    +if(FIRSTDATE('Date'[ Date])>today(),CALCULATE([PC WATERFAL],all('Date'[Fiscal Week Number (544)])),0)
			    +[Cumulative Period Res+Alloc]
		lineageTag: 8e86a3a0-5a67-4b66-b4e1-8ef630ec0e8a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'CUMULATVE FEED' =
			if(LASTDATE('Date'[ Date])>today()+4,CALCULATE([RES+ALL WATERFAL],all('Date')))
			
			//if(LASTDATE('Date'[ Date])>today()+7,CALCULATE([Picked Activated Net Value],all('Date')))+
			//if(LASTDATE('Date'[ Date])>today()+7,CALCULATE([Picked Complete Net Value],all('Date'))))
		lineageTag: 969fbb38-a8a0-48aa-a27d-7aa08164c833

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Cumulative Period Subtraction' =
			
			
			var sel = SELECTEDVALUE('Date'[Fiscal Year-Period])
			
			return
			CALCULATE (
			    [Invoiced Net Value], 'Date'[Fiscal Year-Period]=sel,
			    FILTER (
			        ALL ( 'Date'[ Date] ),
			        'Date'[ Date] < MIN ( 'Date'[ Date] )
			    ))
		lineageTag: 4be4d10b-2c05-49ed-83c9-0fa9dea958b7

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Cumulative Period Res+Alloc' =
			
			var sel = SELECTEDVALUE('Date'[Fiscal Year-Period])
			return
			CALCULATE (
			    [Res+Alloc v2], 'Date'[Fiscal Year-Period]=sel,
			    FILTER (
			        ALL ( 'Date'[ Date] ),
			        'Date'[ Date] < MIN ( 'Date'[ Date] )
			    ))
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 4ef98a2f-5830-4207-aedc-2ab2bd5d71c0

	measure 'Res+Alloc v1' = CALCULATE([Reserved Net Value]+[Allocated Net Value],filter(Orders,Orders[Start Ship Date]<[lastperdate]&&Orders[Sales Order Type]<>"Framework Order 001"))
		formatString: 0.00
		lineageTag: fb2f08fc-11fb-4ebb-ad30-250da1a032ae

	measure 'Res+Alloc v2' =
			
			VAR A = LOOKUPVALUE('Date'[ Date],'Date'[- Is Today?],"Yes")
			return
			
			CALCULATE([Res+Alloc v1],USERELATIONSHIP('Date'[ Date],Orders[Fill Date - Order]),filter('Order Type','Order Type'[Order Type ID]="DD"))+
			CALCULATE([Res+Alloc v1],USERELATIONSHIP('Date'[ Date],Orders[Fill Date - Cust Req #]),filter('Order Type','Order Type'[Order Type ID]<>"DD"))
		formatString: 0
		lineageTag: caadc514-0273-4b5d-8aee-6b16b8530390

	measure PA = CALCULATE([Picked Activated Net Value],FILTER(Orders,Orders[Start Ship Date]<[lastperdate]))
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 7dcf4850-fda4-4eac-9308-7ec2380fc959

	measure PC = CALCULATE([Picked Complete Net Value]+[Picked Activated Net Value],FILTER('Date','Date'[ Date]<[lastperdate]))
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 7515ac02-264a-47f5-b6d1-006ebdd6c619

	measure 'P2P Target' = 1
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 70b50c53-81ba-4cac-8360-1272d573df9b

	measure 'In Pick Hold' = CALCULATE([Reserved Net Value]+[Allocated Net Value],all('Date'),filter(Orders,Orders[Start Ship Date]<[lastpdate]))
		formatString: 0.00
		lineageTag: f18b8637-e668-4be0-9e09-fe6d2d8cde7b

	measure 'Res+Alloc v1 Pairs' = CALCULATE([Reserved Units]+[Allocated Units],filter(Orders,Orders[Start Ship Date]<[lastpdate]&&Orders[Sales Order Type]<>"Framework Order 001"))
		lineageTag: 2f69fe8d-7964-4101-9643-061ba2684c0b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Res+Alloc v2 Pairs' =
			
			VAR A = LOOKUPVALUE('Date'[ Date],'Date'[- Is Today?],"Yes")
			return
			
			CALCULATE([Res+Alloc v1 Pairs],USERELATIONSHIP('Date'[ Date],Orders[Fill Date - Order]),filter('Order Type','Order Type'[Order Type ID]="DD"))+
			CALCULATE([Res+Alloc v1 Pairs],USERELATIONSHIP('Date'[ Date],Orders[Fill Date - Cust Req #]),filter('Order Type','Order Type'[Order Type ID]<>"DD"))
		lineageTag: 6c185644-7e11-43f9-9954-7875b75dcafe

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'RES+ALL WATERFAL PAIRS' =
			
			CALCULATE(CALCULATE([Reserved Units]+[Allocated Units],filter(Orders,Orders[Start Ship Date]<[lastpdate]),USERELATIONSHIP('Date'[ Date],Orders[Fill Date - Cust Req #])),CROSSFILTER('Date'[ Date],Orders[Start Ship Date],None))
		lineageTag: 1be43122-9111-45e0-be64-64ebea7ddf36

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Cumulative Period Pairs' =
			
			
			var sel = SELECTEDVALUE('Date'[Fiscal Year-Period])
			
			return
			CALCULATE (
			    [Invoiced Units],all(Orders[Start Ship Date]), 'Date'[Fiscal Year-Period]=sel,
			    FILTER (
			        ALL ( 'Date'[ Date] ),
			        'Date'[ Date] <= MAX ( 'Date'[ Date] )
			    )
			)-[Cumulative Period Subtraction Pairs]
		formatString: 0.00
		lineageTag: 4f6ff708-bf63-4c12-83aa-e923eba4f89b

	measure 'Cumulative Period Res+Alloc Pairs' =
			
			var sel = SELECTEDVALUE('Date'[Fiscal Year-Period])
			return
			CALCULATE (
			    [Res+Alloc v2 Pairs], 'Date'[Fiscal Year-Period]=sel,
			    FILTER (
			        ALL ( 'Date'[ Date] ),
			        'Date'[ Date] < MIN ( 'Date'[ Date] )
			    ))
		lineageTag: 1769fb3e-2899-4775-9977-bd5e6d135481

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Cumulative Period Subtraction Pairs' =
			
			
			var sel = SELECTEDVALUE('Date'[Fiscal Year-Period])
			
			return
			CALCULATE (
			    [Invoiced Units],all(Orders[Start Ship Date]), 'Date'[Fiscal Year-Period]=sel,
			    FILTER (
			        ALL ( 'Date'[ Date] ),
			        'Date'[ Date] < MIN ( 'Date'[ Date] )
			    ))
		lineageTag: ac8c4349-f561-424c-ac24-e91b471440cb

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Cumulative Period Waterfall Pairs' =
			
			
			var sel = SELECTEDVALUE('Date'[Fiscal Year-Period])
			return
			CALCULATE (
			    [Invoiced Units], 'Date'[Fiscal Year-Period]=sel,
			    FILTER (
