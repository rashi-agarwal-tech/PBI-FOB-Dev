			VAR A = LOOKUPVALUE('Date'[ Date],'Date'[- Is Today?],"Yes")
			return
			IF(LASTDATE('Date'[ Date])<=a,blank(),
			if(LASTDATE('Date'[ Date])>=a&&FIRSTDATE('Date'[ Date])<=a,CALCULATE([PC Pairs],all('Date'))))
