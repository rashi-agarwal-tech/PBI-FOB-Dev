table Customer
	lineageTag: 69ced94e-0594-494d-a7f1-5a7b1c8ed9b4
	sourceLineageTag: 4420175f-4faa-42ec-8040-8069dd739deb

	measure Header = "Warehouse Fulfilment"
		lineageTag: a3a92394-44de-435c-8cc9-4c0418258143

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure MaxInvoicedNetValue = ```
			
			max(
			    MAXX(
			    Customer, 
			    [Total Net Value Forecast]
			),
			MAXX(
			    Customer, 
			    [Total Net Value]
			))
			```
		lineageTag: 195274ee-5cdb-4f54-8540-f84cabfc20ad

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure MaxInvoiceduunits = ```
			
			max(
			    MAXX(
			    Customer, 
			    [Total Units Forecast]
			),
			MAXX(
			    Customer, 
			    [Total Units]
			))
			```
		lineageTag: cacb1d9c-3f94-4dcd-81b0-803fc3920fc5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Measure 2' = max([Total Net Value],sum('S&OP Forecast'[Invoiced Net Value]))
		lineageTag: 605d9481-44c6-4866-ba34-77dcabe0e1b7

		annotation PBI_FormatHint = {"isGeneralNumber":true}

