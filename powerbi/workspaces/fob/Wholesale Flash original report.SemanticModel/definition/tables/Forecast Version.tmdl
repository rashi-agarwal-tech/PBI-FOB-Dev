	measure 'In Pick Opp' = ```
			
			 var a = SELECTEDVALUE('Date'[Fiscal Year-Period (544)])
			 return
			
			 CALCULATE([Picked Activated Net Value]+[Picked Complete Net Value])
			```
		formatString: #,0
		lineageTag: 5cbd7787-f9ff-4cc3-ae1d-ad5e405c2155

		changedProperty = FormatString

	measure Available = ```
			
			 var a = SELECTEDVALUE('Date'[Fiscal Year-Period (544)])
			 return
			 if(SELECTEDVALUE(Orders[Sales Order Type])="Framework Order 001",
			 CALCULATE([Reserved Net Value]+[Allocated Net Value],filter(Orders,Orders[Fill Date - Order]<[lastperdate])),
			 CALCULATE([Reserved Net Value]+[Allocated Net Value],filter(Orders,Orders[Fill Date - Cust Req #]<[lastperdate])))
			```
		formatString: #,0
		lineageTag: 4707a832-b360-4906-bb87-58d725392439

		changedProperty = FormatString

	measure 'Credit Hold' = "FP"& RIGHT(SELECTEDVALUE('Date'[Fiscal Period]),2)&" Credit Hold"
