		lineageTag: 5e99105e-f532-490f-bea0-5ed46aaf0f9b

	measure 'Frmwrk Title' = "FP"& RIGHT(CALCULATE(SELECTEDVALUE('Date'[Fiscal Period]),filter('Date','Date'[Relative Fiscal Period (544)]="Current FP")),2)&" Frameworks"
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
