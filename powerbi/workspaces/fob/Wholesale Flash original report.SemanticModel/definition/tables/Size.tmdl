	measure 'Unbound Forecast' =
			
			var selp = SELECTEDVALUE('Date'[Fiscal Year-Period (544)])
			var ldat = CALCULATE(LASTDATE('Date'[ Date]),filter(ALL('Date'),'Date'[Fiscal Year-Period (544)]=selp))
			var fdat = CALCULATE(FIRSTDATE('Date'[ Date]),filter(ALL('Date'),'Date'[Fiscal Year-Period (544)]=selp))
			var crows = CALCULATE(COUNTROWS('Date'),all('Date'[ Date]),'Date'[- Is Weekend?]="Weekday",DATESBETWEEN('Date'[ Date],fdat,ldat))
			return
			DIVIDE([S&OP Forecast Invoiced $],crows)
		formatString: 0
		lineageTag: f11be7db-f13b-45dd-8f92-92c2a5f790e3

	measure 'directs open working pairs' =
			
			
			var selp = SELECTEDVALUE('Date'[Fiscal Year-Period (544)])
			var ldate =[lastpdate]
			var ldatoffset = ldate-0
			var openus = CALCULATE(SUM(Orders[Open Units Col]),FILTER(Orders,Orders[Start Ship Date]<=ldate&&Orders[Fill Date - Order]<ldatoffset&&Orders[Shipping Warehouse]="USDOMDD"))
			var openlatam = CALCULATE(SUM(Orders[Open Units Col]),FILTER(Orders,Orders[Credit Override]=TRUE()&&Orders[Fill Date - Order]<ldatoffset&&Orders[Shipping Warehouse]="201-DD"&&Orders[Start Ship Date]<=ldate))
			var directs = openUS+openlatam
			return
			directs
