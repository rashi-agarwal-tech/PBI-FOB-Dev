	measure 'Yesterday Invoiced' =
			
			var tday = CALCULATE(FIRSTDATE('Date'[ Date]),filter('Date','Date'[- Is Yesterday?]="Yes"))+1
			var dow = WEEKDAY(tday,2)
			var srt = DATEADD('Date'[ Date],-4,day)
			var end1 = DATEADD('Date'[ Date],-1,day)
			
			return
			
			if(dow=1,
			CALCULATE([Invoiced Net Value],FILTER('Date','Date'[ Date]>=tday-3))
			,CALCULATE([Invoiced Net Value],FILTER('Date','Date'[- Is Yesterday?]="Yes")))
		formatString: #,0
