	measure 'P2P Completion' =
			
			var inv = [Invoiced Net Value]
			var picka = CALCULATE([Picked Activated Net Value],filter(all('Date'),'Date'[ Date]<=[lastperdate]))
			var pickc = CALCULATE([Picked Complete Net Value],filter(all('Date'),'Date'[ Date]<=[lastperdate]))
			return
			divide(inv+picka+pickc,[S&OP Forecast Invoiced $])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 81b07e02-acb8-4a9e-8850-c7d19dc18b2d

