	measure 'Moving Shipping Target' = ```
			
			VAR TDAY = LOOKUPVALUE('Date'[ Date],'Date'[- Is Today?],"Yes")
			var sel = SELECTEDVALUE('Date'[Fiscal Year-Period (544)])
			var tnv = 
			IF(LASTDATE('Date'[ Date])<TDAY,
			CALCULATE (
			    [Invoiced Net Value],
			    FILTER (
			        ALL ('Date'),
			        'Date'[ Date] <= MAX ( 'Date'[ Date]) && 'Date'[Fiscal Year-Period (544)]=sel )
			),BLANK())
			var fc = CALCULATE([S&OP Forecast Invoiced $],ALLEXCEPT('Date','Date'[Fiscal Year-Period (544)]))
			var target1 = divide((fc-tnv),[Shipping Days Lft])
			var main = if(LASTDATE('Date'[ Date])<today()-1,target1,if(LASTDATE('Date'[ Date])<TDAY,CALCULATE([Required Daily Average],ALLEXCEPT('Date','Date'[Fiscal Year-Period (544)]),all(Orders[Shipping Warehouse])),BLANK()))
			return
			if(main<0,blank(),main)
			```
		formatString: 0
		lineageTag: 4e639c14-13a4-4875-8b0f-08633fbb3c34

	measure 'Shipping Days Lft' =
			
			var selp = SELECTEDVALUE('Date'[Fiscal Year-Period])
			var seld = SELECTEDVALUE('Date'[ Date],today())
			var dat1 = CALCULATE(LASTDATE('Date'[ Date]),filter(ALL('Date'),'Date'[Fiscal Year-Period]=selp))
			var crows = CALCULATE(COUNTROWS('Date'),all('Date'[ Date]),'Date'[- Is Weekend?]="Weekday",DATESBETWEEN('Date'[ Date],seld,dat1))
			
			return
			if(WEEKDAY(seld,2)>5,crows+1,crows)
