	measure 'Shipping Moving Average' = ```
			
			var sel = SELECTEDVALUE('Date'[Fiscal Year-Period])
			var fstdate = CALCULATE(FIRSTDATE('Date'[ Date]),filter(all('Date'),'Date'[Fiscal Year-Period]=sel))
			var shpdays = [Shipping Days Elapsed]
			var tday = LOOKUPVALUE('Date'[ Date],'Date'[- Is Today?],"Yes")
			var tnv = 
			
			CALCULATE (
			    [Invoiced Net Value], 'Date'[Fiscal Year-Period]=sel,
			    FILTER (
			        ALL ( 'Date'[ Date] ),
			        'Date'[ Date] <= MAX ( 'Date'[ Date] )
			    )
			)
			return
			
			IF(LASTDATE('Date'[ Date])<tday,divide(tnv,shpdays),BLANK())
			```
		formatString: 0
		lineageTag: 660a4932-03ce-452e-950e-ed6343de30fa

	measure 'Shipping Days Elapsed' =
			
			var selp = SELECTEDVALUE('Date'[Fiscal Year-Period (544)])
			var tday = LOOKUPVALUE('Date'[ Date],'Date'[- Is Today?],"Yes")
			var seld = SELECTEDVALUE('Date'[ Date],tday)
			var dat1 = CALCULATE(FIRSTDATE('Date'[ Date]),filter(ALL('Date'),'Date'[Fiscal Year-Period (544)]=selp))
			var crows = CALCULATE(COUNTROWS('Date'),all('Date'[ Date]),'Date'[- Is Weekend?]="Weekday",DATESBETWEEN('Date'[ Date],dat1,SELD))
			return
			if(WEEKDAY(dat1,2)>5,crows+1,crows)
		lineageTag: 0f558fa9-a59a-4e2c-8bd9-9314bf4958e1

