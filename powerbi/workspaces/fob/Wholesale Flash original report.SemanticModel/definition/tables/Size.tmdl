	measure 'Directs Input' =
			
			VAR A = if(CALCULATE(COUNTROWS('Date'),FILTER('Date',[Fiscal Year-Period (544)]="FY25-P01"))>0,160000,0)
			VAR B = if(CALCULATE(COUNTROWS('Date'),FILTER('Date',[Fiscal Year-Period (544)]="FY25-P02"))>0,0,0)
			VAR C = if(CALCULATE(COUNTROWS('Date'),FILTER('Date',[Fiscal Year-Period (544)]="FY25-P03"))>0,1442574,0)
			VAR D = if(CALCULATE(COUNTROWS('Date'),FILTER('Date',[Fiscal Year-Period (544)]="FY25-P04"))>0,400000,0)
			VAR E = if(CALCULATE(COUNTROWS('Date'),FILTER('Date',[Fiscal Year-Period (544)]="FY25-P05"))>0,2441000,0)
			VAR F = if(CALCULATE(COUNTROWS('Date'),FILTER('Date',[Fiscal Year-Period (544)]="FY25-P06"))>0,2865000,0)
			VAR G = if(CALCULATE(COUNTROWS('Date'),FILTER('Date',[Fiscal Year-Period (544)]="FY25-P07"))>0,422622,0)
			VAR H = if(CALCULATE(COUNTROWS('Date'),FILTER('Date',[Fiscal Year-Period (544)]="FY25-P08"))>0,472520,0)
			VAR I = if(CALCULATE(COUNTROWS('Date'),FILTER('Date',[Fiscal Year-Period (544)]="FY25-P09"))>0,0,0)
			VAR J = if(CALCULATE(COUNTROWS('Date'),FILTER('Date',[Fiscal Year-Period (544)]="FY25-P10"))>0,467500,0)
			VAR K = if(CALCULATE(COUNTROWS('Date'),FILTER('Date',[Fiscal Year-Period (544)]="FY25-P11"))>0,0,0)
			VAR L = if(CALCULATE(COUNTROWS('Date'),FILTER('Date',[Fiscal Year-Period (544)]="FY25-P12"))>0,622000,0)
			RETURN
			0
			//A+B+C+D+E+F+G+H+I+J+K+L
		formatString: 0.00
		lineageTag: b1848607-5ed6-4cf4-9ae9-11b6f6fa4dfe

	measure 'Directs Forecast' =
			
			var a = [Directs Input]
			var b = [Directs Open]+CALCULATE([Total Net Value],'Order Type'[Order Type]="Direct Delivery")
			return
