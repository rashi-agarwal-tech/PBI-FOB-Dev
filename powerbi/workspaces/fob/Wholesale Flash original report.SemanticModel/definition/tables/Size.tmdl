			var inv = [Invoiced Units]
			var pickac = CALCULATE([Pick Activated Units],filter(all('Date'),'Date'[ Date]<=[lastperdate]))
			var pickco = CALCULATE([Pick Complete Units],filter(all('Date'),'Date'[ Date]<=[lastperdate]))
			RETURN
			divide(inv+pickac+pickco,[S&OP Forecast Invoiced Units])
		formatString: 0%;-0%;0%
		lineageTag: 8ad17dab-78d3-45d2-b051-dba058a0daf9

		changedProperty = FormatString

	measure 'P2P FORMAT pairs' =
			
			VAR P2PDate = DATEADD(LASTDATE('Date'[ Date]),-14,DAY)
			RETURN
			if(AND([P2P Completion Pairs]>1,P2PDate>=today()),"#33D639",
			if([P2P Completion Pairs]>1,"#33D639","3F2C80F"))
		lineageTag: 38750d34-6d30-42ce-b71b-8b5da6f41990

		annotation PBI_FormatHint = {"isText":true}

	measure 'In Pick Opp Pairs' = ```
			
			 var a = SELECTEDVALUE('Date'[Fiscal Year-Period (544)])
			 return
			
			 CALCULATE([Pick Activated Units]+[Pick Complete Units])
			```
		formatString: #,0
		lineageTag: 3da98e17-6626-4872-a2ea-6cef8c241c80

		changedProperty = FormatString

	measure 'Unbound Forecast Pairs' =
			
			var selp = SELECTEDVALUE('Date'[Fiscal Year-Period (544)])
			var ldat = CALCULATE(LASTDATE('Date'[ Date]),filter(ALL('Date'),'Date'[Fiscal Year-Period (544)]=selp))
			var fdat = CALCULATE(FIRSTDATE('Date'[ Date]),filter(ALL('Date'),'Date'[Fiscal Year-Period (544)]=selp))
			var crows = CALCULATE(COUNTROWS('Date'),all('Date'[ Date]),'Date'[- Is Weekend?]="Weekday",DATESBETWEEN('Date'[ Date],fdat,ldat))
			return
			DIVIDE(CALCULATE([Forecast Unit],ALLEXCEPT('Date','Date'[Fiscal Year-Period (544)])),crows)
		lineageTag: 2b6f0743-6d90-4021-810b-fb7322bf7b9b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Moving Shipping Target Pairs' = ```
			
			
			VAR TDAY = LOOKUPVALUE('Date'[ Date],'Date'[- Is Today?],"Yes")
			var sel = SELECTEDVALUE('Date'[Fiscal Year-Period (544)])
			var tnv = 
			IF(LASTDATE('Date'[ Date])<TDAY,
			CALCULATE (
			    [Total Units],all(Products[Product General]),
			    FILTER (
			        ALL ('Date'),
			        'Date'[ Date] <= MAX ( 'Date'[ Date]) && 'Date'[Fiscal Year-Period (544)]=sel )
			),BLANK())
			var fc = CALCULATE([Forecast Unit],ALLEXCEPT('Date','Date'[Fiscal Year-Period (544)]))
			var target1 = divide((fc-tnv),[Shipping Days Lft])
			var main = if(LASTDATE('Date'[ Date])<today()-1,target1,if(LASTDATE('Date'[ Date])<TDAY,CALCULATE([Required Daily Average Pairs],ALLEXCEPT('Date','Date'[Fiscal Year-Period (544)]),all(Orders[Shipping Warehouse])),BLANK()))
			return
			if(main<0,blank(),main)
			```
		lineageTag: a2193e23-a718-4fcc-8588-783f824aa4e5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Days left Text' =
			if(LASTDATE('Date'[ Date])<[Today],"Period Complete",
			if(FIRSTDATE('Date'[ Date])>[Today],"Future Period",
			[Shipping Days Lft]&" shipping days left"))
		lineageTag: 8c7b16f3-cfc2-4679-8d83-243e4297f445

		annotation PBI_FormatHint = {"isGeneralNumber":true}

