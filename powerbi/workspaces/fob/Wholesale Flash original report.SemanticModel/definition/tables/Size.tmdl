	measure 'directs open working' =
			
			
			var selp = SELECTEDVALUE('Date'[Fiscal Year-Period (544)])
			var ldate =[lastpdate]
			var ldatoffset = ldate-0
			var openus = CALCULATE(SUM(Orders[Open Net Value Col Cons GBP]),FILTER(Orders,Orders[Start Ship Date]<=ldate&&Orders[Fill Date - Order]<ldatoffset&&Orders[Shipping Warehouse]="USDOMDD"))*[XR]
			var openlatam = CALCULATE(SUM(Orders[Open Net Value Col Cons GBP]),FILTER(Orders,Orders[Credit Override]=TRUE()&&Orders[Fill Date - Order]<ldatoffset&&Orders[Shipping Warehouse]="201-DD"&&Orders[Start Ship Date]<=ldate))*[XR]
			var directs = openUS+openlatam
			return
			directs
		lineageTag: b19d2830-0217-44b3-bad6-75e542527251

