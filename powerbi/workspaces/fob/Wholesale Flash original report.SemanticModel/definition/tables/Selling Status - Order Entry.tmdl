	measure 'Yesterday Ref' =
			
			VAR A = LOOKUPVALUE('Date'[ Date],'Date'[- Is Today?],"Yes")
			var dow = WEEKDAY(A,2)
			
			return
			if(dow=1,"Fri|Sat|Sun","Yesterday")
