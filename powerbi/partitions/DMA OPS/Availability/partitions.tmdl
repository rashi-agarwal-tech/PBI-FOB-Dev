				    BFN_PRESENTATION_Schema = PRESENTATION_Database{[Name=Datasource_Schema,Kind="Schema"]}[Data],
				    OPS_BFN_VW_D365_FACT_AVAILABILITY_View = BFN_PRESENTATION_Schema{[Name="OPS_BFN_VW_D365_FACT_AVAILABILITY_QUARTERS",Kind="View"]}[Data],
				    #"Filtered Rows" = Table.SelectRows(OPS_BFN_VW_D365_FACT_AVAILABILITY_View, each List.Contains({"Rewair"},[WH_Channel])),
				    PartitionFilter = Table.SelectRows(#"Filtered Rows", each [DATE] >= #date(2018, 1, 1) and [DATE] < #date(2018, 04, 1))
				in
				    PartitionFilter