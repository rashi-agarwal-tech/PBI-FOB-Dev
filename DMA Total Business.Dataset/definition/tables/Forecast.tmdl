	column FCRanker =
			IF (
			    ISBLANK ( FIND ( "+", Forecast[Forecast Version], 1, BLANK () ) ),
			    BLANK (),
			    YEAR ( Forecast[Date] )
			        + LEFT (
			            Forecast[Forecast Version],
			            LEN ( Forecast[Forecast Version] )
			                - FIND ( "+", Forecast[Forecast Version], 1, BLANK () )
			        )
			)
		dataType: decimal
		isHidden
		lineageTag: 3eb7adde-135c-468f-8d4c-db7b7a6cec43
		summarizeBy: none

		changedProperty = DataType

		changedProperty = IsHidden

		annotation SummarizationSetBy = User

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	partition Forecast = m
		mode: import
		source =
				let
				    Source = Snowflake.Databases(Datasource_Server,Datasource_Warehouse),
				    PRESENTATION_Database = Source{[Name=Datasource_Database,Kind="Database"]}[Data],
				    BFN_PRESENTATION_Schema = PRESENTATION_Database{[Name=Datasource_Schema,Kind="Schema"]}[Data],
				    TB_BFN_VW_AZURE_TOTAL_BUS_FC_View = BFN_PRESENTATION_Schema{[Name="TB_BFN_VW_AZURE_TOTAL_BUS_FC",Kind="View"]}[Data]
				in
				    TB_BFN_VW_AZURE_TOTAL_BUS_FC_View

	changedProperty = IsHidden

	annotation PBI_ResultType = Exception

	annotation PBI_NavigationStepName = Navigation

