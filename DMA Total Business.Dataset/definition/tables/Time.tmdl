	column AM/PM
		dataType: string
		sourceProviderType: nvarchar(16777216)
		lineageTag: 6236749b-e201-4635-924c-d06a97ea3e5c
		summarizeBy: none
		sourceColumn: AM/PM

		annotation SummarizationSetBy = Automatic

	column 'Hour Period' =
			
			VAR main =
			    IF ( LEN ( 'Time'[Hour] ) = 1, "0" & 'Time'[Hour], 'Time'[Hour] )
			VAR main2 =
			    IF (
			        LEN ( 'Time'[Hour] ) = 1,
			        "0" & ( 'Time'[Hour] + 1 ),
			        ( 'Time'[Hour] + 1 )
			    )
			RETURN
			    main & "-" & main2
		dataType: string
		lineageTag: ca85cfff-c3d2-48d2-b8f7-1af23fff4b5f
		summarizeBy: none
		isDataTypeInferred

		annotation SummarizationSetBy = Automatic

	column 'Time of Day' =
			
			IF (
			    'Time'[Hour] < 6,
			    "Overnight",
			    IF (
			        'Time'[Hour] < 9,
			        "Breakfast",
			        IF (
			            'Time'[Hour] < 12,
			            "Morning",
			            IF (
			                'Time'[Hour] < 14,
			                "Lunch",
			                IF (
			                    'Time'[Hour] < 18,
			                    "Afternoon",
			                    IF ( 'Time'[Hour] < 20, "Dinner", "Evening" )
			                )
			            )
			        )
			    )
			)
		dataType: string
		lineageTag: 024be2f6-bfe1-4c88-aea5-2c2dad01adcb
		summarizeBy: none
		isDataTypeInferred

		annotation SummarizationSetBy = Automatic

	partition Time = m
		mode: import
		source =
				let
				    Source = Snowflake.Databases(Datasource_Server,Datasource_Warehouse),
				    PRESENTATION_Database = Source{[Name=Datasource_Database,Kind="Database"]}[Data],
				    BFN_PRESENTATION_Schema = PRESENTATION_Database{[Name=Datasource_Schema,Kind="Schema"]}[Data],
				    TB_BFN_VW_DIM_TIME_View = BFN_PRESENTATION_Schema{[Name="TB_BFN_VW_DIM_TIME",Kind="View"]}[Data]
				in
				    TB_BFN_VW_DIM_TIME_View

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

